# name: ${FILE_PATH}
# description: ${DESCRIPTION}
# group: [jit]

name JIT Native Filter Projection ${JIT_POLICY_NAME}
group micro
subgroup jit

require jit_sljit

load
CREATE TABLE jit_micro AS SELECT i::BIGINT AS i FROM range(${ROW_COUNT}) tbl(i);

init
SET threads=1;
SET enable_jit=true;
SET jit_backend='sljit';
SET jit_policy='${JIT_POLICY}';
SET jit_dump_ir=false;
SET jit_trace_runtime=false;
SET jit_event_log_size=10000;
SELECT * FROM duckdb_jit_clear_events();

run
SELECT sum(j) FROM (SELECT i + 7 AS j FROM jit_micro WHERE i > ${FILTER_BOUND});

cleanup
SELECT * FROM duckdb_jit_clear_events();

result_query I
SELECT (
    (SELECT * FROM __answer) = ${EXPECTED_RESULT}
    AND CASE '${JIT_POLICY}'
        WHEN 'off' THEN (
            SELECT count(*) = 0
            FROM duckdb_jit_events()
            WHERE target='region'
              AND status='compiled'
        )
        WHEN 'auto' THEN (
            SELECT count(*) > 0
            FROM duckdb_jit_events()
            WHERE target='region'
              AND status='compiled'
              AND execution_mode='native'
              AND region_execution_form='fused'
              AND policy_decision='auto'
              AND candidate_shape='filter-projection-projection'
              AND candidate_scope='source_prefix'
              AND code_size > 0
        )
        WHEN 'force' THEN (
            SELECT (
                (SELECT count(*) > 0
                 FROM duckdb_jit_events()
                 WHERE target='region'
                   AND status='compiled'
                   AND execution_mode='native'
                   AND region_execution_form='fused'
                   AND policy_decision='force'
                   AND candidate_shape='filter-projection-projection'
                   AND candidate_scope='source_prefix'
                   AND code_size > 0)
                AND
                (SELECT count(*) = 0
                 FROM duckdb_jit_events()
                 WHERE target='region'
                   AND status='compiled'
                   AND execution_mode <> 'native')
            )
        )
	        ELSE false
    END
)::INTEGER;
----
1
