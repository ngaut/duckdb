# name: benchmark/micro/jit/native_filter_force.benchmark
# description: Forced native SLJIT filter lowering for a large filter shape
# group: [jit]

template benchmark/micro/jit/native_filter.benchmark.in
JIT_POLICY=force
JIT_POLICY_NAME=Force
ROW_COUNT=20000000
FILTER_BOUND=10000000
EXPECTED_RESULT=9999999
