# name: benchmark/micro/jit/native_filter_projection_auto.benchmark
# description: Auto-policy overhead for a filter/projection shape supported by native SLJIT lowering
# group: [jit]

template benchmark/micro/jit/native_filter_projection.benchmark.in
JIT_POLICY=auto
JIT_POLICY_NAME=Auto
ROW_COUNT=20000000
FILTER_BOUND=10000000
EXPECTED_RESULT=150000054999993
