# name: benchmark/micro/jit/native_projection_chain_force.benchmark
# description: Forced native SLJIT projection-chain lowering for a large projection-chain shape
# group: [jit]

template benchmark/micro/jit/native_projection_chain.benchmark.in
JIT_POLICY=force
JIT_POLICY_NAME=Force
ROW_COUNT=20000000
FIRST_ADDEND=7
SECOND_ADDEND=3
EXPECTED_RESULT=200000190000000
