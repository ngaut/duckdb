# name: benchmark/micro/jit/native_projection_chain_auto.benchmark
# description: Auto-policy performance for a large native SLJIT projection-chain shape
# group: [jit]

template benchmark/micro/jit/native_projection_chain.benchmark.in
JIT_POLICY=auto
JIT_POLICY_NAME=Auto
ROW_COUNT=20000000
FIRST_ADDEND=7
SECOND_ADDEND=3
EXPECTED_RESULT=200000190000000
