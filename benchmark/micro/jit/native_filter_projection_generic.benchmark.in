# name: ${FILE_PATH}
# description: ${DESCRIPTION}
# group: [jit]

name JIT Native Generic Filter Projection ${JIT_POLICY_NAME}
group micro
subgroup jit

require jit_sljit

load
CREATE TABLE jit_micro AS SELECT i::BIGINT AS i FROM range(${ROW_COUNT}) tbl(i);

init
SET threads=1;
SET enable_jit=true;
SET jit_backend='sljit';
SET jit_policy='${JIT_POLICY}';

run
SELECT sum(a + b)
FROM (
    SELECT i AS a, i + ${ADDEND} AS b
    FROM jit_micro
    WHERE i > ${FILTER_BOUND}
) t;

result I
${EXPECTED_RESULT}
