# name: ${FILE_PATH}
# description: ${DESCRIPTION}
# group: [jit]

name JIT Native Filter ${JIT_POLICY_NAME}
group micro
subgroup jit

require jit_sljit

init
SET threads=1;
SET enable_jit=true;
SET jit_backend='sljit';
SET jit_policy='${JIT_POLICY}';

run
SELECT count(*) FROM range(${ROW_COUNT}) tbl(i) WHERE i > ${FILTER_BOUND};

result I
${EXPECTED_RESULT}
