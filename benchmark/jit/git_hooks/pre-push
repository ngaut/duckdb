#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
receipt="$(git rev-parse --git-path jit_guard_verified_tree)"

head_is_verified() {
    [ -f "$receipt" ] && [ "$(cat "$receipt")" = "$(git rev-parse 'HEAD^{tree}')" ]
}

if ! head_is_verified; then
    python3 benchmark/jit/run_jit_refactor_guard.py full
    if ! head_is_verified; then
        echo "error: the full guard verified the worktree, which is not the tree of HEAD" >&2
        exit 1
    fi
fi
