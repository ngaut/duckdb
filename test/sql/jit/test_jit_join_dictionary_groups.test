# name: test/sql/jit/test_jit_join_dictionary_groups.test
# description: A direct join aggregate over dictionary group strings resolves each entry's group once per vector and
# group: [jit]

# matches DuckDB through NULL groups, accumulator flushes, and strings too wide for the packed key

load {TEST_DIR}/jit_join_dictionary_groups.db

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=100000

statement ok
SET jit_trace_runtime=true

statement ok
SET force_compression='dict_fsst'

statement ok
CREATE TABLE orders AS
SELECT i::BIGINT AS order_id,
       CASE i % 5 WHEN 0 THEN '1-URGENT' WHEN 1 THEN '2-HIGH' WHEN 2 THEN '3-MEDIUM' ELSE '4-NOT SPECIFIED' END
           AS priority
FROM range(300000) tbl(i)

# nine recurring groups; a NULL group; 70 groups per vector drawn from 210 over the scan, which overflows the
# accumulator and flushes; and groups longer than the packed key
statement ok
CREATE TABLE shipments AS
SELECT (i % 300000)::BIGINT AS order_id,
       'group-' || CAST(14000042 + i % 9 AS VARCHAR) AS nine,
       CASE WHEN i % 11 = 0 THEN NULL ELSE 'g-' || CAST(i % 7 AS VARCHAR) END AS nullable,
       'flush-' || CAST(((i // 2048) % 3) * 70 + i % 70 AS VARCHAR) AS rotating,
       'a-group-name-longer-than-sixteen-' || CAST(i % 5 AS VARCHAR) AS wide
FROM range(1200000) tbl(i)

statement ok
CHECKPOINT

foreach column nine nullable rotating wide

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
CREATE OR REPLACE TABLE r_{policy} AS
SELECT s.{column} AS g,
       sum(CASE WHEN o.priority = '1-URGENT' OR o.priority = '2-HIGH' THEN 1 ELSE 0 END) AS high,
       sum(CASE WHEN o.priority <> '1-URGENT' AND o.priority <> '2-HIGH' THEN 1 ELSE 0 END) AS low
FROM shipments s JOIN orders o USING (order_id)
GROUP BY s.{column}

endloop

query I
SELECT count(*) FROM ((SELECT * FROM r_off EXCEPT ALL SELECT * FROM r_auto)
                      UNION ALL (SELECT * FROM r_auto EXCEPT ALL SELECT * FROM r_off))
----
0

endloop

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%direct_aggregate_consumer.dictionary_groups=%'
----
true
