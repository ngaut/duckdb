# name: test/sql/jit/test_jit_filtered_grouped_selection.test_slow
# description: A filter whose codegen deferred to a fused aggregate kernel that could not be built runs as a generated
#              filter feeding the grouped update; the update resolves groups for the selected rows only, so the rows the
#              filter rejected leave no empty groups behind
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

# a string group key filtered on itself: no fused perfect-hash kernel exists for it
statement ok
CREATE TABLE p AS
SELECT 'comment ' || (i % 50000)::VARCHAR || CASE WHEN i % 7 = 0 THEN ' the end' ELSE ' fin' END AS c,
       (i % 100)::BIGINT AS k
FROM range(400000) t(i)

foreach threads 1 4

statement ok
SET threads=${threads}

foreach policy off auto

statement ok
SET jit_policy='${policy}'

query III nosort count_groups_${threads}
SELECT count(*), sum(n), count(*) FILTER (WHERE n = 0) FROM (SELECT c, count(*) AS n FROM p WHERE c LIKE '%the%' GROUP BY 1)
----

query II nosort sum_groups_${threads}
SELECT count(*), sum(n) FROM (SELECT c, sum(k) AS n FROM p WHERE c LIKE '%the%' GROUP BY 1)
----

query II nosort union_groups_${threads}
SELECT count(*), sum(n) FROM (
    SELECT c, count(*) AS n FROM (SELECT c FROM p WHERE k < 30 UNION ALL SELECT c FROM p WHERE c LIKE '%the%') u(c)
    GROUP BY c)
----

endloop

endloop

query III
SELECT count(*), sum(n), count(*) FILTER (WHERE n = 0) FROM (SELECT c, count(*) AS n FROM p WHERE c LIKE '%the%' GROUP BY 1)
----
50000	57143	0
