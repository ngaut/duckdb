# name: test/sql/jit/test_jit_probe_bloom_exact_source_filter.test
# description: A regular probe whose source already applied the build side's exact membership filter to its key skips
#              the bloom filter; a probe over keys too sparse for that exact filter still builds one. Both match the
#              vectorized plan
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_trace_runtime=true

# Regular hash tables: a perfect hash table never asks for a bloom filter
statement ok
SET perfect_ht_threshold=0

statement ok
SET jit_event_log_size=100000

# Every build key is a probe key. The dense keys span less than the exact prefix-range filter's bitmap but too much
# for a perfect hash table; the sparse ones (x100) span more than the exact filter
statement ok
CREATE TABLE probe AS SELECT i::BIGINT AS id, i::BIGINT * 49 AS dense, i::BIGINT * 4900 AS sparse FROM range(1000000) t(i)

statement ok
CREATE TABLE build AS
SELECT i::BIGINT * 2989 AS dense, i::BIGINT * 298900 AS sparse, (i % 7)::INTEGER AS w FROM range(16000) t(i)

foreach key dense sparse

foreach threads 1 4

statement ok
SET threads={threads}

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS SELECT p.id * 3 + 1 AS id, b.w FROM probe p JOIN build b USING ({key})

statement ok
SET jit_policy='auto'

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS SELECT p.id * 3 + 1 AS id, b.w FROM probe p JOIN build b USING ({key})

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

query I
SELECT count(*) FROM expected
----
16000

endloop

endloop

statement ok
SET threads=1

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS SELECT p.id * 3 + 1 AS id, b.w FROM probe p JOIN build b USING (dense)

query II
SELECT count(*) FILTER (jit_runtime_path_counts LIKE '%hash_join_probe.bloom_filter.skipped_exact_source_filter%'),
       count(*) FILTER (jit_runtime_path_counts LIKE '%hash_join_probe.bloom_filter.built%')
FROM duckdb_jit_events() WHERE phase = 'runtime'
----
1	0

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS SELECT p.id * 3 + 1 AS id, b.w FROM probe p JOIN build b USING (sparse)

query II
SELECT count(*) FILTER (jit_runtime_path_counts LIKE '%hash_join_probe.bloom_filter.skipped_exact_source_filter%'),
       count(*) FILTER (jit_runtime_path_counts LIKE '%hash_join_probe.bloom_filter.built%')
FROM duckdb_jit_events() WHERE phase = 'runtime'
----
0	1
