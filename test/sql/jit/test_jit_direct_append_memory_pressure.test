# name: test/sql/jit/test_jit_direct_append_memory_pressure.test
# description: Tables built through JIT direct append survive buffer eviction: resized transient segments must spill and reload, not be destroyed
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET threads=1;

statement ok
SET jit_event_log_size=1000;

statement ok
SET jit_trace_runtime=true;

statement ok
SET temp_directory='{TEST_DIR}/direct_append_spill';

# Build the tables with the JIT enabled so the CTAS takes the direct-append
# materialization path, which grows segments through ColumnSegment::Resize.
statement ok
CREATE TABLE facts AS SELECT (i % 100000)::INTEGER k, (i % 97)::INTEGER g, i::BIGINT v FROM range(2000000) tbl(i);

statement ok
CREATE TABLE dims AS SELECT i::INTEGER k, (i * 3)::BIGINT payload FROM range(100000) tbl(i);

# The proof is non-vacuous only if compiled execution actually built the tables.
query I
SELECT count(*) > 0 FROM duckdb_jit_events()
----
true

statement ok
SET jit_policy='off';

statement ok
CREATE TABLE ref AS SELECT f.g, sum(f.v + d.payload) s, count(*) c FROM facts f JOIN dims d ON f.k = d.k GROUP BY f.g;

statement ok
SET jit_policy='auto';

# A memory limit far below the table footprint forces the buffer pool to evict
# table segments during the join. Resized direct-append segments must spill to
# the temporary directory and reload exactly; a destroy-on-eviction block here
# either loses the rows or fails the pin.
statement ok
SET memory_limit='20MB';

statement ok
CREATE TABLE got AS SELECT f.g, sum(f.v + d.payload) s, count(*) c FROM facts f JOIN dims d ON f.k = d.k GROUP BY f.g;

statement ok
SET memory_limit='1000GB';

query I
SELECT count(*) FROM (
  (SELECT * FROM got EXCEPT SELECT * FROM ref)
  UNION ALL
  (SELECT * FROM ref EXCEPT SELECT * FROM got)
)
----
0

query I
SELECT sum(c) = 2000000 FROM got
----
true
