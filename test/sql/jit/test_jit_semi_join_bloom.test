# name: test/sql/jit/test_jit_semi_join_bloom.test
# description: Semi joins reject sparse probe misses through the build-side bloom filter like inner joins do, and keep
# group: [jit]

#              every matching probe row (single keys, pair keys, duplicated build keys)

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
CREATE TABLE probe AS
SELECT i::BIGINT AS k0, (i * 17)::BIGINT AS k1, (i % 1000)::BIGINT AS v FROM range(600000) t(i)

statement ok
CREATE TABLE build_unique AS
SELECT (i * 73)::BIGINT AS k0, (i * 73 * 17)::BIGINT AS k1 FROM range(9000) t(i)

statement ok
CREATE TABLE build_dup AS
SELECT ((i % 4500) * 131)::BIGINT AS k0, ((i % 4500) * 131 * 17)::BIGINT AS k1 FROM range(9000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach build build_unique build_dup

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT 'single' AS q, k0, sum(v) AS s FROM probe SEMI JOIN {build} b ON probe.k0 = b.k0 GROUP BY ALL
UNION ALL
SELECT 'pair', k0, sum(v) FROM probe SEMI JOIN {build} b ON probe.k0 = b.k0 AND probe.k1 = b.k1 GROUP BY ALL
UNION ALL
SELECT 'exists', k0, sum(v) FROM probe WHERE EXISTS (SELECT 1 FROM {build} b WHERE b.k0 = probe.k0 AND b.k1 = probe.k1)
GROUP BY ALL

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT 'single' AS q, k0, sum(v) AS s FROM probe SEMI JOIN {build} b ON probe.k0 = b.k0 GROUP BY ALL
UNION ALL
SELECT 'pair', k0, sum(v) FROM probe SEMI JOIN {build} b ON probe.k0 = b.k0 AND probe.k1 = b.k1 GROUP BY ALL
UNION ALL
SELECT 'exists', k0, sum(v) FROM probe WHERE EXISTS (SELECT 1 FROM {build} b WHERE b.k0 = probe.k0 AND b.k1 = probe.k1)
GROUP BY ALL

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

query I
SELECT count(*) > 0 FROM actual
----
true

endloop

endloop
