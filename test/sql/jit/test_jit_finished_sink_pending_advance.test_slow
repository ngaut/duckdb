# name: test/sql/jit/test_jit_finished_sink_pending_advance.test_slow
# description: A compiled step's flush before a batch advance blocks the sink, and the sink finishes when the flushed
# group: [jit]

#              rows sink on wake-up: the pending advance is moot and the executor finishes instead of retrying it.
#              The deleted-rows block blocks only in the async sink/source build; the LIMIT block blocks in any build

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TABLE t AS SELECT i::BIGINT AS i, (i % 1000)::BIGINT AS m FROM range(6000000) tbl(i)

statement ok
CREATE TABLE e AS SELECT -1::BIGINT AS i FROM range(0)

statement ok
SET threads=8

# transaction-local deletes leave 3-row chunks, so the step holds rows across row groups and first sinks them in the
# flush before an advance; the CTE's only consumer joins an empty table and finishes on its first rows
statement ok
BEGIN

statement ok
DELETE FROM t WHERE i % 2048 >= 3

query I
WITH c AS MATERIALIZED (SELECT i * 2 AS k FROM t) SELECT count(*) FROM c JOIN e ON c.k = e.i
----
0

query II
WITH c AS MATERIALIZED (SELECT i * 2 AS k FROM t) SELECT count(*), sum(k) FROM c
----
8790	52727641260

statement ok
ROLLBACK

# without injected blocking: the flush pushes the step's sparse rows into the CTE, whose only consumer is an
# order-preserving LIMIT; the push blocks, and the queued rows satisfy the LIMIT when they sink on wake-up
statement ok
SET threads=4

loop i 0 10

query I
WITH c AS MATERIALIZED (SELECT i * 2 + 1 AS j FROM t WHERE m = 3) SELECT count(*) FROM (SELECT j FROM c LIMIT 5)
----
5

query I
WITH c AS MATERIALIZED (SELECT i * 2 + 1 AS j FROM t WHERE m = 3)
SELECT count(*) FROM (SELECT j FROM c LIMIT 5 OFFSET 1000)
----
5

endloop
