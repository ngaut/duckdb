# name: test/sql/jit/test_jit_source_filter_projection_aggregate.test
# description: A generated source filter feeding projected grouped aggregates (master's partial aggregate pushdown
# group: [jit]

#              shape, e.g. TPC-H Q13 orders) matches DuckDB at every selectivity

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=100000

statement ok
CREATE TABLE src AS
SELECT (i % 50000)::BIGINT AS k,
       CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 1000)::BIGINT END AS v,
       CASE WHEN i % 7 = 0 THEN 'special requests ' || i ELSE 'plain ' || i END AS c,
       (i % 17)::INTEGER AS g
FROM range(600000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE c NOT LIKE '%special%requests%' GROUP BY k

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE c NOT LIKE '%special%requests%' GROUP BY k

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE c LIKE '%special%requests%' GROUP BY k

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE c LIKE '%special%requests%' GROUP BY k

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE g < 0 GROUP BY k

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE g < 0 GROUP BY k

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE g >= 0 GROUP BY k

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE g >= 0 GROUP BY k

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE v IS NULL GROUP BY k

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE v IS NULL GROUP BY k

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE v > 500 GROUP BY k

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT k, count(*) AS n, sum(v) AS s, count(v) AS nv FROM src WHERE v > 500 GROUP BY k

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT k + 1 AS kk, count(*) AS n, sum(v) AS s FROM src WHERE c NOT LIKE '%special%requests%' GROUP BY kk

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT k + 1 AS kk, count(*) AS n, sum(v) AS s FROM src WHERE c NOT LIKE '%special%requests%' GROUP BY kk

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

endloop

# The filtered count aggregate runs through the fused source-filter recipe instead of the native-only fallback.
statement ok
SET threads=1

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS SELECT k + 1 AS kk, count(*) AS n FROM src WHERE c NOT LIKE '%special%requests%' GROUP BY kk

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%filter.selection%'
  AND jit_runtime_path_counts NOT LIKE '%recipe.native_only%'
----
true
