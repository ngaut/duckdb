# name: test/sql/jit/test_jit_simd_filter.test
# description: SIMD-vectorized integer arithmetic filter (packed count + select paths)
# group: [jit]

statement ok
LOAD jit_sljit;

# jit_verify cross-checks generated output against native per region and errors on
# any mismatch, so every jit_policy='auto' query below is a generated-vs-native oracle.
statement ok
SET jit_verify=true;

# Bounded columns so arithmetic overflow is provably impossible: the CBO drops the
# overflow check, native computes wrapping arithmetic, and the SIMD gate admits the
# predicate. range(100003) is deliberately not a multiple of the lane count, so the
# packed loop's scalar tail is exercised. Row values have no nulls (flat all-valid).
statement ok
CREATE TABLE t AS SELECT (i%1000)::INT a, (i%777)::INT b, (i%555)::INT c, (i%333)::INT d FROM range(100003) tbl(i);

# ---------------------------------------------------------------------------
# SIMD packed COUNT(*) filter path (BuildSljitNativeFilteredUngroupedFusedPrimitiveAggregateUpdate)
# ---------------------------------------------------------------------------
statement ok
SET jit_policy='auto';

query I
SELECT count(*) FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
22756

# same predicate must match native exactly
statement ok
SET jit_policy='off';

query I
SELECT count(*) FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
22756

# NOT-producing comparisons (>=, !=) exercise the all-ones/XOR mask path
statement ok
SET jit_policy='auto';

query I
SELECT count(*) FROM t WHERE a+b >= c AND a*2-b != 100 AND c < 400;
----
69693

statement ok
SET jit_policy='off';

query I
SELECT count(*) FROM t WHERE a+b >= c AND a*2-b != 100 AND c < 400;
----
69693

# ---------------------------------------------------------------------------
# SIMD packed selection path (BuildSljitNativeTypedExpressionTreeSelect): projection filter
# ---------------------------------------------------------------------------
statement ok
SET jit_policy='auto';

query I
SELECT count(*) FROM (SELECT a,b FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500);
----
22756

# Single reference-vs-reference comparisons use the same typed selector.
# These cases cover an implicit all-true identity vector, an empty vector, a
# first mixed lane that backfills the deferred prefix, and a scalar-width tail.
statement ok
CREATE TABLE sr AS
SELECT i::INT a, (i+1)::INT b_all, (i-1)::INT b_none,
       (i + CASE WHEN i%17=0 THEN -1 ELSE 1 END)::INT b_mixed
FROM range(100003) tbl(i);

statement ok
SET jit_policy='auto';

query I
SELECT count(*) FROM (SELECT a, b_all FROM sr WHERE a < b_all);
----
100003

query I
SELECT count(*) FROM (SELECT a, b_none FROM sr WHERE a < b_none);
----
0

# Every signed comparison condition is derived from SUBS flags and compacted
# without a data-dependent branch. Keep all six conditions under jit_verify.
query I
SELECT count(*) FROM (SELECT a, b_mixed FROM sr WHERE a <= b_mixed);
----
94120

query I
SELECT count(*) FROM (SELECT a, b_mixed FROM sr WHERE a > b_mixed);
----
5883

query I
SELECT count(*) FROM (SELECT a, b_mixed FROM sr WHERE a >= b_mixed);
----
5883

query I
SELECT count(*) FROM (SELECT a, b_mixed FROM sr WHERE a = b_mixed);
----
0

query I
SELECT count(*) FROM (SELECT a, b_mixed FROM sr WHERE a != b_mixed);
----
100003

# Reference-vs-constant uses the same ARM64 unrolled selector (Q1 shape).
query I
SELECT count(*) FROM (SELECT a FROM sr WHERE a < 50000);
----
50000

query I
SELECT count(*) FROM (SELECT a FROM sr WHERE a <= 50000);
----
50001

query I
SELECT count(*) FROM (SELECT a FROM sr WHERE a > 50000);
----
50002

query I
SELECT count(*) FROM (SELECT a FROM sr WHERE a >= 50000);
----
50003

query I
SELECT count(*) FROM (SELECT a FROM sr WHERE a = 50000);
----
1

query I
SELECT count(*) FROM (SELECT a FROM sr WHERE a != 50000);
----
100002

statement ok
CREATE TEMP TABLE srj AS SELECT a, b_mixed FROM sr WHERE a < b_mixed;

query I
SELECT count(*) FROM srj;
----
94120

statement ok
SET jit_policy='off';

statement ok
CREATE TEMP TABLE srn AS SELECT a, b_mixed FROM sr WHERE a < b_mixed;

query I
SELECT count(*) FROM (SELECT * FROM srj EXCEPT SELECT * FROM srn);
----
0

query I
SELECT count(*) FROM (SELECT * FROM srn EXCEPT SELECT * FROM srj);
----
0

# full row-level parity with native (rowid pins each row)
statement ok
SET jit_policy='auto';

statement ok
CREATE TEMP TABLE rj AS SELECT rowid AS rid, a, b, c FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;

statement ok
SET jit_policy='off';

statement ok
CREATE TEMP TABLE rn AS SELECT rowid AS rid, a, b, c FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;

query I
SELECT count(*) FROM (SELECT * FROM rj EXCEPT SELECT * FROM rn);
----
0

query I
SELECT count(*) FROM (SELECT * FROM rn EXCEPT SELECT * FROM rj);
----
0

# ---------------------------------------------------------------------------
# SIMD packed SUM(int32 column) filter path (SADALP widen+accumulate)
# ---------------------------------------------------------------------------
statement ok
SET jit_policy='auto';

query I
SELECT sum(a) FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
9537371

statement ok
SET jit_policy='off';

query I
SELECT sum(a) FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
9537371

# different payload column + NOT-producing comparisons
statement ok
SET jit_policy='auto';

query I
SELECT sum(b) FROM t WHERE a+b >= c AND a*2-b != 100 AND c < 400;
----
27413738

statement ok
SET jit_policy='off';

query I
SELECT sum(b) FROM t WHERE a+b >= c AND a*2-b != 100 AND c < 400;
----
27413738

# computed int32 payloads (arithmetic value expression, not just a bare column)
statement ok
SET jit_policy='auto';

query I
SELECT sum(a+b) FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
22165434

statement ok
SET jit_policy='off';

query I
SELECT sum(a+b) FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
22165434

statement ok
SET jit_policy='auto';

query I
SELECT sum(a*2-c) FROM t WHERE a+b >= c AND a*2-b != 100 AND c < 400;
----
58006219

statement ok
SET jit_policy='off';

query I
SELECT sum(a*2-c) FROM t WHERE a+b >= c AND a*2-b != 100 AND c < 400;
----
58006219

# empty filtered set: SUM must be NULL, not 0 (saw_value handling)
statement ok
SET jit_policy='auto';

query I
SELECT sum(a) FROM t WHERE a*3+b*2-c > 1500 AND a > 900000;
----
NULL

statement ok
SET jit_policy='off';

query I
SELECT sum(a) FROM t WHERE a*3+b*2-c > 1500 AND a > 900000;
----
NULL

# ---------------------------------------------------------------------------
# Native-callback aggregates (MAX/MIN/AVG have no primitive-update ABI): the
# generated SIMD filter feeds the aggregate through the native state-update sink,
# so ANY state-update aggregate composes with the accelerated filter.
# ---------------------------------------------------------------------------
statement ok
SET jit_policy='auto';

query III
SELECT max(a), min(b), round(avg(c),6) FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
665	222	238.791132

statement ok
SET jit_policy='off';

query III
SELECT max(a), min(b), round(avg(c),6) FROM t WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
665	222	238.791132

# empty filtered set through the native sink: aggregates must be NULL
statement ok
SET jit_policy='auto';

query I
SELECT max(a) FROM t WHERE a > 900000;
----
NULL

# grouped native-callback aggregates: the generated filter feeds the native
# HASH/PERFECT_HASH aggregate sink the same way
statement ok
CREATE TABLE g AS SELECT (i%1000)::INT a, (i%777)::INT b, (i%555)::INT c, (i%333)::INT d, (i%10)::INT k FROM range(100003) tbl(i);

statement ok
SET jit_policy='auto';

query III
SELECT count(*), sum(mx), min(mn) FROM (SELECT k, max(a) mx, min(b) mn FROM g WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500 GROUP BY k);
----
10	6605	222

statement ok
SET jit_policy='off';

query III
SELECT count(*), sum(mx), min(mn) FROM (SELECT k, max(a) mx, min(b) mn FROM g WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500 GROUP BY k);
----
10	6605	222

# ---------------------------------------------------------------------------
# Mixed-width predicates (int32 + int64 comparisons in one conjunction): 64-bit
# comparison masks are evaluated per half and narrowed (UZP1) into the 4-lane
# loop. The hybrid loop runs scalar payloads per matching lane, so any payload
# kind (bigint sum here) composes with the packed mixed-width mask.
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE mx AS SELECT (i%1000)::INT a, (i%777)::BIGINT b, (i%555)::INT c, (i%333)::BIGINT d FROM range(100003) tbl(i);

statement ok
SET jit_policy='auto';

query I
SELECT sum(b) FROM mx WHERE a*3+c > 1500 AND b+d < 700 AND c*2 < 800;
----
7555475

query I
SELECT count(*) FROM mx WHERE a*2-c >= 500 AND b+d != 500 AND d-b <= 200;
----
57869

query I
SELECT max(a) FROM mx WHERE a*3+c > 1500 AND b+d < 700;
----
999

statement ok
SET jit_policy='off';

query I
SELECT sum(b) FROM mx WHERE a*3+c > 1500 AND b+d < 700 AND c*2 < 800;
----
7555475

query I
SELECT count(*) FROM mx WHERE a*2-c >= 500 AND b+d != 500 AND d-b <= 200;
----
57869

query I
SELECT max(a) FROM mx WHERE a*3+c > 1500 AND b+d < 700;
----
999

# empty mixed-width filtered set: SUM must be NULL through the hybrid loop
statement ok
SET jit_policy='auto';

query I
SELECT sum(b) FROM mx WHERE a*3+c > 1500 AND b+d < -1;
----
NULL

# ---------------------------------------------------------------------------
# NULLABLE data: the packed loops run with a lane-expanded validity mask ANDed
# into the predicate mask (AND-only trees: a row with a NULL referenced source
# cannot pass). Covers the count, sum, native-callback and select paths.
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE nn AS SELECT CASE WHEN i%3=0 THEN NULL ELSE (i%1000)::INT END a, CASE WHEN i%97=0 THEN NULL ELSE (i%777)::INT END b, (i%555)::INT c, (i%333)::INT d FROM range(100003) tbl(i);

statement ok
SET jit_policy='auto';

query I
SELECT count(*) FROM nn WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
15050

query I
SELECT sum(a) FROM nn WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
6310184

query II
SELECT max(a), min(b) FROM nn WHERE a*3+b*2-c > 1500 AND b*4-a > 500;
----
999	223

query I
SELECT count(*) FROM (SELECT a,b FROM nn WHERE a*3+b*2-c > 1500 AND b*4-a > 500);
----
30817

statement ok
SET jit_policy='off';

query I
SELECT count(*) FROM nn WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
15050

query I
SELECT sum(a) FROM nn WHERE a*3+b*2-c > 1500 AND a*2-d*3+c < 900 AND b*4-a > 500;
----
6310184

query II
SELECT max(a), min(b) FROM nn WHERE a*3+b*2-c > 1500 AND b*4-a > 500;
----
999	223

query I
SELECT count(*) FROM (SELECT a,b FROM nn WHERE a*3+b*2-c > 1500 AND b*4-a > 500);
----
30817

# ---------------------------------------------------------------------------
# 64-bit element predicate (2 lanes). int64 add/sub/compare are SIMD; int64
# multiply is correctly NOT vectorized (gate excludes it) so this stays correct.
# ---------------------------------------------------------------------------
statement ok
SET jit_policy='auto';

query I
SELECT count(*) FROM (SELECT (a::BIGINT) x, (b::BIGINT) y FROM t) s WHERE x*3+y*2 > 2000 AND x*2-y < 1500 AND x+y >= 100;
----
51025

statement ok
SET jit_policy='off';

query I
SELECT count(*) FROM (SELECT (a::BIGINT) x, (b::BIGINT) y FROM t) s WHERE x*3+y*2 > 2000 AND x*2-y < 1500 AND x+y >= 100;
----
51025

# ---------------------------------------------------------------------------
# Overflow safety. A wide-range column makes overflow possible, so the CBO keeps
# the overflow check and the SIMD gate rejects the predicate (packed ops wrap and
# cannot trap). The scalar path runs instead, matching native exactly.
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE w AS SELECT (i*2000)::INT wa, (i%777)::INT wb FROM range(1000000) tbl(i);

# Overflow-possible but not reached at runtime (predicate ordering filters first):
# gate rejects -> scalar path -> must equal native.
statement ok
SET jit_policy='auto';

query I
SELECT count(*) FROM w WHERE wa*3 + wb > 1000 AND wa*2 < 100000000;
----
24999

statement ok
SET jit_policy='off';

query I
SELECT count(*) FROM w WHERE wa*3 + wb > 1000 AND wa*2 < 100000000;
----
24999

# Overflow unavoidably reached: gate rejects, scalar trap fires, and both jit and
# native raise an overflow error (the SIMD path must never silently wrap this).
statement ok
CREATE TABLE ov AS SELECT (1000000000 + (i%1000000000))::INT AS x, (i%777)::INT AS y FROM range(1000000) tbl(i);

statement ok
SET jit_policy='auto';

statement error
SELECT count(*) FROM ov WHERE x*3 - y > 0 AND x - y*2 > -100;
----
<REGEX>:.*[Oo]verflow.*

statement ok
SET jit_policy='off';

statement error
SELECT count(*) FROM ov WHERE x*3 - y > 0 AND x - y*2 > -100;
----
<REGEX>:.*[Oo]verflow.*
