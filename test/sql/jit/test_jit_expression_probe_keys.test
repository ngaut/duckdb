# name: test/sql/jit/test_jit_expression_probe_keys.test
# description: Hash joins whose probe keys are expressions compile: the keys are computed ahead of the probe and
#              bound as references, and every join type matches DuckDB, including keys that evaluate to NULL
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_trace_decisions=true

statement ok
SET jit_event_log_size=100000

statement ok
CREATE TABLE probe AS
SELECT i::BIGINT AS k, (i % 97)::INTEGER AS g, CASE WHEN i % 11 = 0 THEN NULL ELSE (i % 1000)::BIGINT END AS v,
       'p' || (i % 300) AS s
FROM range(600000) t(i)

statement ok
CREATE TABLE build AS
SELECT (i * 7)::BIGINT AS k, (i % 5)::INTEGER AS w, 'p' || (i % 50) AS s FROM range(40000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT 'inner' AS q, count(*) AS n, sum(v) AS sv, sum(w) AS sw FROM probe p JOIN build b ON p.k + 3 = b.k
UNION ALL
SELECT 'semi', count(*), sum(v), NULL FROM probe p SEMI JOIN build b ON p.k * 2 = b.k
UNION ALL
SELECT 'anti', count(*), sum(v), NULL FROM probe p ANTI JOIN build b ON p.k * 2 = b.k
UNION ALL
SELECT 'pair', count(*), sum(v), sum(w) FROM probe p JOIN build b ON p.k + 3 = b.k AND p.g % 5 = b.w
UNION ALL
SELECT 'null_key', count(*), sum(v), sum(w) FROM probe p JOIN build b ON p.v * 7 = b.k
UNION ALL
SELECT 'cast', count(*), sum(v), sum(w) FROM probe p JOIN build b ON CAST(p.g AS BIGINT) * 7 = b.k
UNION ALL
SELECT 'mark', count(*), sum(v), NULL FROM probe p WHERE p.k + 1 IN (SELECT k FROM build) OR p.g = 3
UNION ALL
SELECT 'string', count(*), sum(v), sum(w) FROM probe p JOIN build b ON p.s || 'x' = b.s || 'x'

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT 'inner' AS q, count(*) AS n, sum(v) AS sv, sum(w) AS sw FROM probe p JOIN build b ON p.k + 3 = b.k
UNION ALL
SELECT 'semi', count(*), sum(v), NULL FROM probe p SEMI JOIN build b ON p.k * 2 = b.k
UNION ALL
SELECT 'anti', count(*), sum(v), NULL FROM probe p ANTI JOIN build b ON p.k * 2 = b.k
UNION ALL
SELECT 'pair', count(*), sum(v), sum(w) FROM probe p JOIN build b ON p.k + 3 = b.k AND p.g % 5 = b.w
UNION ALL
SELECT 'null_key', count(*), sum(v), sum(w) FROM probe p JOIN build b ON p.v * 7 = b.k
UNION ALL
SELECT 'cast', count(*), sum(v), sum(w) FROM probe p JOIN build b ON CAST(p.g AS BIGINT) * 7 = b.k
UNION ALL
SELECT 'mark', count(*), sum(v), NULL FROM probe p WHERE p.k + 1 IN (SELECT k FROM build) OR p.g = 3
UNION ALL
SELECT 'string', count(*), sum(v), sum(w) FROM probe p JOIN build b ON p.s || 'x' = b.s || 'x'

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

endloop

# The expression-keyed probe compiles instead of stopping at a key-not-reference blocker
statement ok
SET threads=1

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS SELECT count(*) AS n FROM probe p JOIN build b ON p.k + 3 = b.k

query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE phase = 'compile' AND status = 'compiled'
----
true

query I
SELECT count(*) FROM duckdb_jit_events() WHERE reason LIKE '%probe-key-not-reference%'
----
0
