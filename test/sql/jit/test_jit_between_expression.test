# name: test/sql/jit/test_jit_between_expression.test
# description: BETWEEN over computed inputs or computed bounds compiles as its two comparisons
# group: [jit]

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET threads=1

statement ok
CREATE TABLE p AS SELECT i::BIGINT AS a, (i * 3 + 17)::BIGINT AS b, (i * 5 - 11)::BIGINT AS c,
 CASE WHEN i % 10 = 0 THEN NULL ELSE (i * 7 + 19)::BIGINT END AS d FROM range(10000) tbl(i)

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
SET jit_cbo_startup_base_cost=CASE WHEN '{policy}'='auto' THEN 0 ELSE 10000 END

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_event_log_size=10000

statement ok
SELECT * FROM duckdb_jit_clear_events()

query I
SELECT sum(CASE WHEN coalesce(d, a) BETWEEN a AND b THEN a ELSE b END) FROM p
----
140148000

query I
SELECT sum(CASE WHEN (d + 1) NOT BETWEEN b AND c THEN a ELSE b END) FROM p
----
60002000

query I
SELECT sum(CASE WHEN (d - a) BETWEEN 1 AND 50000 THEN 1 ELSE 0 END) FROM p
----
7497

# NULL inputs and NULL bounds keep three-valued results
query II
SELECT sum(CASE WHEN ((d + 1) BETWEEN b AND c) IS NULL THEN 1 ELSE 0 END),
 sum(CASE WHEN ((d + 1) NOT BETWEEN b AND NULL) IS NULL THEN 1 ELSE 0 END) FROM p
----
1000	10000

# The repeated coalesce is projected once, so the BETWEEN reads a column against computed bounds
query I
SELECT sum(CASE WHEN coalesce(d, a) BETWEEN (a + b - c - 1000000) AND (a + b + c + 1000000)
 AND (a + (b * 2)) < (c + coalesce(d, a)) THEN a ELSE b END) FROM p
----
60002115

query I
SELECT '{policy}'='off' OR count(*) > 0 FROM duckdb_jit_events() WHERE status='compiled'
----
true

endloop
