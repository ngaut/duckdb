# name: test/sql/jit/test_jit_aggregate_payload_slots.test
# description: Aggregate input slots preserve column identity through scalar, combined, grouped and join bindings
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TABLE inputs AS SELECT i AS id, (i % 11)::INTEGER AS g, (i % 7)::INTEGER AS a,
    CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 101)::INTEGER END AS b,
    CASE WHEN i % 17 = 0 THEN NULL ELSE (i % 251)::BIGINT END AS c,
    (i % 31)::DOUBLE AS d, CASE WHEN i % 19 = 0 THEN NULL ELSE (i % 29)::DOUBLE END AS e
FROM range(100000) r(i)

statement ok
CREATE TABLE dimension AS SELECT i AS id, (i % 23)::INTEGER AS value FROM range(0, 100000, 3) r(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

query IIIIII nosort scalar_slots_{threads}
SELECT sum(c), count(*), sum(a), sum(b + 7), sum(a - b), count(b) FROM inputs
----

query RRRR nosort double_slots_{threads}
SELECT sum(e), sum(d + 7), sum(e - d), sum(d * d) FROM inputs WHERE a > 2
----

query IIIII nosort combined_slots_{threads}
SELECT sum(c), sum(a * b + a), sum(CASE WHEN b > 50 THEN c ELSE a END), sum(b), count(*) FROM inputs WHERE a > 2
----

query IIIIII rowsort perfect_slots_{threads}
SELECT g, sum(c), sum(a), sum(b), count(b), count(*) FROM inputs GROUP BY g
----

query IIIII rowsort perfect_combined_slots_{threads}
SELECT g, sum(c), sum(a * b + a), sum(b), count(*) FROM inputs WHERE a > 2 GROUP BY g
----

query IIIIII rowsort sparse_slots_{threads}
SELECT id % 30001, sum(c), sum(a), sum(b), count(b), count(*) FROM inputs GROUP BY id % 30001
----

query IIIII rowsort sparse_combined_slots_{threads}
SELECT id % 30001, sum(c), sum(a * b + a), sum(b), count(*) FROM inputs WHERE a > 2 GROUP BY id % 30001
----

query IIIIII nosort join_scalar_slots_{threads}
SELECT sum(i.c), sum(d.value), sum(i.a), sum(i.b + 7), count(i.b), count(*) FROM inputs i JOIN dimension d USING (id)
----

query IIIII nosort join_combined_slots_{threads}
SELECT sum(i.c), sum(i.a * d.value + i.b), sum(i.b), sum(d.value), count(*) FROM inputs i JOIN dimension d USING (id) WHERE i.a > 2
----

query IIIII rowsort join_grouped_slots_{threads}
SELECT i.g, sum(i.c), sum(d.value), sum(i.b), count(*) FROM inputs i JOIN dimension d USING (id) GROUP BY i.g
----

query IIII nosort empty_slots_{threads}
SELECT sum(c), sum(a - b), count(b), count(*) FROM inputs WHERE a < 0
----

endloop

endloop
