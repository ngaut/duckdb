# name: test/sql/jit/test_jit_mixed_runner_perfect_hash_build.test
# description: A hash join build sunk partly by a compiled kernel and partly natively (a forced deferral) records the
#              keys of every chunk: the perfect hash table it finalizes into covers the compiled rows' keys too
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET threads=1

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=1048576

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_full_pipeline_benefit=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TABLE b AS SELECT i::BIGINT AS j FROM range(368640) t(i)

statement ok
CREATE TABLE p AS SELECT (i * 3 + 1)::BIGINT AS k FROM range(368640) t(i)

# Without join filter pushdown, finalize sizes the perfect hash table from the keys recorded while sinking. The build
# key grows with the row, so the first row group (compiled before the deferral) holds the smallest keys
statement ok
SET disabled_optimizers='join_filter_pushdown'

loop force_n 1 3

statement ok
SET jit_debug_force_defer_after_chunks=${force_n}

query I
SELECT count(*) FROM p JOIN (SELECT j * 3 + 1 AS x FROM b WHERE j % 5 <> 7) bb ON p.k = bb.x
----
368640

endloop
