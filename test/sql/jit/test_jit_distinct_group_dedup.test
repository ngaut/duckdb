# name: test/sql/jit/test_jit_distinct_group_dedup.test
# description: A hash aggregate without aggregates hands each group to its sink once per thread
# group: [jit]

# Group keys with a small bounded domain index a per-thread bitmap of the groups already handed to the DuckDB sink,
# and rows repeating one are dropped. NULL and out-of-range keys, grouping sets, several pipelines into one aggregate
# and domains too large for the bitmap must give the groups DuckDB gives.

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=10000

statement ok
CREATE TABLE t AS SELECT (i % 2 = 0) AS b, (i % 7 - 3)::TINYINT AS ti, (i % 300 - 150)::SMALLINT AS si, CASE WHEN i % 11 = 0 THEN NULL ELSE (i % 50)::INTEGER END AS ni, (i % 1000)::BIGINT AS bi, (i * 7919 % 100000000)::BIGINT AS wide FROM range(500000) t(i)

statement ok
CREATE TABLE blocked AS SELECT (i * 17 % 50)::INTEGER AS v FROM range(5) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

# negative key ranges
query II
SELECT count(*), sum(hash(ti, si)) FROM (SELECT ti, si FROM t GROUP BY ti, si)
----
2100	19315042819905586741273

# a boolean key, NULL keys, and the rows a MARK join keeps
query II
SELECT count(*), sum(hash(b, ni, bi)) FROM (SELECT b, ni, bi FROM t WHERE ni IS NULL OR ni NOT IN (SELECT v FROM blocked) GROUP BY b, ni, bi)
----
1900	17295187731922915190329

query II
SELECT count(*), sum(hash(ti, si)) FROM (SELECT DISTINCT ti, si FROM t)
----
2100	19315042819905586741273

# count(DISTINCT) groups by both columns first
query II
SELECT ti, count(DISTINCT si) FROM t GROUP BY ti ORDER BY ti
----
-3	300
-2	300
-1	300
0	300
1	300
2	300
3	300

# grouping sets project the full key
query II
SELECT count(*), sum(hash(ti, si)) FROM (SELECT ti, si FROM t GROUP BY ROLLUP (ti, si))
----
2108	19425281097883633048759

# a key domain too large for the bitmap
query II
SELECT count(*), sum(hash(ti, wide)) FROM (SELECT ti, wide FROM t GROUP BY ti, wide)
----
500000	4610842897817139421987055

# two pipelines feed one aggregate
query II
SELECT count(*), sum(hash(ti, si)) FROM (SELECT ti, si FROM (SELECT ti, si FROM t WHERE bi < 400 UNION ALL SELECT ti, si FROM t WHERE bi >= 300) u GROUP BY ti, si)
----
2100	19315042819905586741273

endloop

endloop

statement ok
SET threads=1

statement ok
SET jit_trace_runtime=true

statement ok
SELECT * FROM duckdb_jit_clear_events()

query II
SELECT count(*), sum(hash(b, ni, bi)) FROM (SELECT b, ni, bi FROM t WHERE ni IS NULL OR ni NOT IN (SELECT v FROM blocked) GROUP BY b, ni, bi)
----
1900	17295187731922915190329

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%native_sink_update.repeated_groups_dropped=%'
----
true
