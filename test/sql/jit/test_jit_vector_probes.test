# name: test/sql/jit/test_jit_vector_probes.test
# description: A scan whose filters a region evaluates drops the vectors none of whose rows can pass them
# group: [jit]

# Matches come in runs of 1000 rows, so most vectors hold none: the scan reads the filtered columns first and skips
# the rest of such a vector. Vectors with deleted rows, NULLs, several filters, sampling, joins and rows only the
# transaction sees must keep exactly the rows DuckDB's own scan keeps.

require jit_sljit

load __TEST_DIR__/jit_vector_probes.db

statement ok
CREATE TABLE runs AS
SELECT i AS id,
       ((i // 1000) * 7919 % 10000)::INTEGER AS n,
       ((i // 1500) * 31 % 100)::TINYINT AS t8,
       ((i // 700) * 113 % 30000)::SMALLINT AS t16,
       ((i // 3000) * 7 % 1000 - 500)::BIGINT AS t64,
       DATE '2000-01-01' + ((i // 2048) * 37 % 3650)::INTEGER AS d,
       (((i // 1200) * 17 % 10000) / 100)::DECIMAL(9, 2) AS m,
       CASE WHEN (i // 1000) % 11 = 3 AND i % 5 = 0 THEN NULL ELSE ((i // 1000) * 7919 % 10000)::INTEGER END AS nn,
       (i % 97 - 48)::BIGINT AS v,
       (i % 13)::INTEGER AS k,
       (i // 4096)::INTEGER AS c,
       (i // 150000)::INTEGER AS z
FROM range(600000) t(i)

statement ok
CREATE TABLE dims AS SELECT i AS k, (i % 3)::INTEGER AS bucket FROM range(13) t(i)

# the join's key range filters whole vectors in the scan, beside a filter the region evaluates
statement ok
CREATE TABLE keys AS SELECT (2 * i + 31)::INTEGER AS c, i + 1 AS w FROM range(2) t(i)

# deleted rows inside vectors that hold matches and inside vectors that hold none
statement ok
DELETE FROM runs WHERE id % 1000 BETWEEN 100 AND 180 OR (id BETWEEN 200000 AND 260000 AND id % 3 = 0)

# the first pass reads stored segments, whose long runs come back as constant vectors
statement ok
CHECKPOINT

restart

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE MACRO probe_r() AS TABLE
SELECT 'int' AS q, sum(v)::HUGEINT AS a, count(*)::HUGEINT AS b, sum(id)::HUGEINT AS c FROM runs WHERE n < 300
UNION ALL
SELECT 'between', sum(v), count(*), sum(k) FROM runs WHERE n BETWEEN 4000 AND 4100
UNION ALL
SELECT 'tinyint', sum(v), count(*), sum(id) FROM runs WHERE t8 = 7
UNION ALL
SELECT 'smallint', sum(v), count(*), sum(id) FROM runs WHERE t16 > 29000
UNION ALL
SELECT 'bigint', sum(v), count(*), sum(id) FROM runs WHERE t64 <= -495
UNION ALL
SELECT 'date', sum(v), count(*), sum(id) FROM runs WHERE d BETWEEN DATE '2004-03-01' AND DATE '2004-03-20'
UNION ALL
SELECT 'decimal', sum(v), count(*), sum(id) FROM runs WHERE m < 1.5
UNION ALL
SELECT 'nullable', sum(v), count(*), count(nn) FROM runs WHERE nn < 300
UNION ALL
SELECT 'two_filters', sum(v), count(*), sum(id) FROM runs WHERE n < 3000 AND t64 < -400
UNION ALL
SELECT 'filter_and_expression', sum(v), count(*), sum(id) FROM runs WHERE n < 500 AND v + k > 0
UNION ALL
SELECT 'empty', sum(v), count(*), sum(id) FROM runs WHERE n > 20000
UNION ALL
SELECT 'constant_runs', sum(v), count(*), sum(id) FROM runs WHERE z = 2
UNION ALL
SELECT 'constant_runs_and_filter', sum(v), count(*), sum(id) FROM runs WHERE n < 5000 AND z = 3
UNION ALL
SELECT 'join', sum(r.v), count(*), sum(d.bucket) FROM runs r JOIN dims d ON r.k = d.k WHERE r.n < 300 AND d.bucket = 1
UNION ALL
SELECT 'key_range_join', sum(r.v), count(*), sum(e.w) FROM runs r JOIN keys e ON r.c = e.c WHERE r.n < 9000

statement ok
CREATE MACRO probe_g() AS TABLE
SELECT k, sum(v)::HUGEINT AS a, count(*)::HUGEINT AS b FROM runs WHERE n < 1000 GROUP BY k

statement ok
CREATE MACRO probe_p() AS TABLE
SELECT id, v + k AS w, nn FROM runs WHERE n < 200

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
CREATE OR REPLACE TEMP TABLE r_{policy} AS FROM probe_r()

statement ok
CREATE OR REPLACE TEMP TABLE g_{policy} AS FROM probe_g()

statement ok
CREATE OR REPLACE TEMP TABLE p_{policy} AS FROM probe_p()

endloop

query I
SELECT count(*) FROM ((SELECT * FROM r_off EXCEPT ALL SELECT * FROM r_auto)
                      UNION ALL (SELECT * FROM r_auto EXCEPT ALL SELECT * FROM r_off))
----
0

query I
SELECT count(*) FROM ((SELECT * FROM g_off EXCEPT ALL SELECT * FROM g_auto)
                      UNION ALL (SELECT * FROM g_auto EXCEPT ALL SELECT * FROM g_off))
----
0

query I
SELECT count(*) FROM ((SELECT * FROM p_off EXCEPT ALL SELECT * FROM p_auto)
                      UNION ALL (SELECT * FROM p_auto EXCEPT ALL SELECT * FROM p_off))
----
0

endloop

# the second pass runs over rows only this transaction sees, beside updated and deleted ones
statement ok
BEGIN

statement ok
INSERT INTO runs SELECT 600000 + i, ((i // 1000) * 7919 % 10000)::INTEGER, 7, 29500, -499, DATE '2004-03-05', 1.0,
                        NULL, 1, i % 13, 30 + i // 40000, 2 FROM range(90000) t(i)

statement ok
UPDATE runs SET n = 1 WHERE id BETWEEN 1500 AND 1510

statement ok
DELETE FROM runs WHERE id % 1000 = 999

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
CREATE OR REPLACE TEMP TABLE r_{policy} AS FROM probe_r()

statement ok
CREATE OR REPLACE TEMP TABLE g_{policy} AS FROM probe_g()

statement ok
CREATE OR REPLACE TEMP TABLE p_{policy} AS FROM probe_p()

endloop

query I
SELECT count(*) FROM ((SELECT * FROM r_off EXCEPT ALL SELECT * FROM r_auto)
                      UNION ALL (SELECT * FROM r_auto EXCEPT ALL SELECT * FROM r_off))
----
0

query I
SELECT count(*) FROM ((SELECT * FROM g_off EXCEPT ALL SELECT * FROM g_auto)
                      UNION ALL (SELECT * FROM g_auto EXCEPT ALL SELECT * FROM g_off))
----
0

query I
SELECT count(*) FROM ((SELECT * FROM p_off EXCEPT ALL SELECT * FROM p_auto)
                      UNION ALL (SELECT * FROM p_auto EXCEPT ALL SELECT * FROM p_off))
----
0

endloop

query I
SELECT b FROM r_auto WHERE q = 'empty'
----
0

statement ok
ROLLBACK

# a sampled scan keeps the sample's rows
statement ok
SET threads=1

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
CREATE OR REPLACE TEMP TABLE s_{policy} AS
SELECT sum(v)::HUGEINT AS a, count(*)::HUGEINT AS b FROM runs TABLESAMPLE SYSTEM(50) REPEATABLE (7) WHERE n < 3000

endloop

query I
SELECT count(*) FROM ((SELECT * FROM s_off EXCEPT ALL SELECT * FROM s_auto)
                      UNION ALL (SELECT * FROM s_auto EXCEPT ALL SELECT * FROM s_off))
----
0
