CREATE TEMP TABLE jit_auto_complex_projection_baseline AS
SELECT coalesce(max(event_id), 0) AS base_event_id FROM duckdb_jit_events()

statement ok
CREATE TEMP TABLE jit_auto_complex_projection_output AS
SELECT CAST(((((a * 3) + (b * 5) - (c * 7) + (d * 11)) * 13)
    + (((a - b + c) * 17) - ((a + d) * 19))
    + (((b - c + d) * 23) - ((a - d) * 29))
    + (((a * 31) - (b * 37) + (c * 41) - (d * 43))
    + (((a + b + c + d) * 47) - ((a - c) * 53)))) AS BIGINT) AS v
FROM jit_auto_complex_projection_input

