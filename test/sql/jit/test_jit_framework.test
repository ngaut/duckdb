statement ok
CREATE TABLE jit_overlap_region AS
SELECT s
FROM (
  SELECT j AS s
  FROM (SELECT i::BIGINT + 1 AS j FROM range(64) tbl(i)) t1
) t2
GROUP BY s

query III
SELECT count(*), min(s), max(s)
FROM jit_overlap_region
----
64	1	64

query I
SELECT count(*) > 0
FROM duckdb_jit_events()
WHERE backend_name='sljit'
  AND target='region'
  AND phase='decision'
  AND status='unsupported'
  AND execution_mode='unsupported'
  AND policy_decision='force'
  AND region_execution_form='none'
  AND candidate_shape='projection-projection-sink'
  AND candidate_scope='full_pipeline'
  AND candidate_contract_abi='full_pipeline'
  AND candidate_start_operator_index=0
  AND candidate_end_operator_index=2
  AND candidate_pipeline_shape LIKE '%source:source:%:scan%'
  AND candidate_pipeline_shape LIKE '%sink:sink:%:sink%'
  AND admission_shape_key IS NULL
  AND reason LIKE '%source:TABLE_SCAN:helper-call%'
  AND reason LIKE '%hash aggregate sink has no aggregate payload bindings%'
  AND reason LIKE '%aggregate_count=0%'
  AND reason LIKE '%execution:unsupported%'
  AND reason NOT LIKE '%hash aggregate native lookup and state update protocol missing%'
----
1

query I
SELECT count(*) = 0
FROM duckdb_jit_events()
WHERE backend_name='sljit'
  AND target='region'
  AND phase='decision'
  AND status='skipped'
  AND execution_mode='executor_fallback'
  AND policy_decision='force'
  AND candidate_shape='projection'
  AND candidate_start_operator_index=0
  AND candidate_end_operator_index=1
  AND reason LIKE '%overlaps an already selected non-overlapping region%'
----
1

query I
SELECT sum(j) FROM (SELECT i + 7 AS j FROM range(1000) tbl(i) WHERE i > 500)
----
377743

query I
SELECT count(*) > 0
FROM duckdb_jit_events()
WHERE backend_name='sljit'
  AND target='region'
  AND status='unsupported'
  AND execution_mode='unsupported'
  AND candidate_shape='filter-projection-projection-sink'
  AND candidate_scope='full_pipeline'
  AND candidate_start_operator_index=0
  AND candidate_end_operator_index > candidate_start_operator_index
  AND code_size = 0
  AND region_execution_form='none'
  AND reason LIKE '%region-lowering:native=3,helper=1,fallback=0,pass-through=1%'
  AND reason LIKE '%execution-form=none%'
  AND reason LIKE '%backend cannot generate executable code for this whole region%'
  AND reason LIKE '%fusion-blocker:source-fusion-gap:requires-native-source%'
  AND reason LIKE '%fusion-blocker:candidate-fusion-gap:typed-helper-boundary%'
  AND reason LIKE '%op0:FILTER:native:generated typed predicate filter%'
  AND reason LIKE '%op1:PROJECTION:native:generated typed projection%'
  AND reason LIKE '%op2:PROJECTION:pass-through:typed reference projection pass-through%'
  AND reason LIKE '%sink:UNGROUPED_AGGREGATE:native:generated native ungrouped aggregate state update%'
  AND reason LIKE '%native-aggregate-update-executable=ready%'
  AND reason LIKE '%aggregate0_state_type=HUGEINT%'
  AND reason LIKE '%full-pipeline-native-sink-update%'
  AND ir LIKE 'duckdb.region typed-vector-ir;%'
  AND ir LIKE '%compare_greater_than%'
  AND ir LIKE '%add%'
  AND ir LIKE '%ungrouped_aggregate_update%'
  AND ir LIKE '%aggregate0<function=sum%'
  AND ir LIKE '%payload_index=0%'
  AND ir LIKE '%candidate0<first_node=%'
  AND ir LIKE '%sink:sink:UNGROUPED_AGGREGATE%'
  AND ir LIKE '%op2:projection:PROJECTION%'
----
1

