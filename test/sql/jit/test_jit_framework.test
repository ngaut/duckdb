# name: test/sql/jit/test_jit_framework.test
# description: JIT framework settings, backend registration, and boundary trace
# group: [jit]

query II
SELECT name, value
FROM duckdb_settings()
WHERE name IN (
    'enable_jit',
	    'jit_backend',
	    'jit_cbo_full_pipeline_benefit',
	    'jit_cbo_generated_stage_benefit',
	    'jit_cbo_native_operator_stage_benefit',
	    'jit_cbo_source_contract_scan_filter_penalty',
	    'jit_cbo_startup_base_cost',
	    'jit_cbo_startup_margin_basis_points',
	    'jit_trace_decisions',
    'jit_event_log_size',
    'jit_policy',
    'jit_trace_runtime',
    'jit_verify',
    'jit_dump_ir'
)
ORDER BY name
----
enable_jit	true
jit_backend	auto
jit_cbo_full_pipeline_benefit	4096
jit_cbo_generated_stage_benefit	4096
jit_cbo_native_operator_stage_benefit	3072
jit_cbo_source_contract_scan_filter_penalty	4096
jit_cbo_startup_base_cost	10000
jit_cbo_startup_margin_basis_points	0
jit_dump_ir	false
jit_event_log_size	0
jit_policy	auto
jit_trace_decisions	false
jit_trace_runtime	false
jit_verify	false

