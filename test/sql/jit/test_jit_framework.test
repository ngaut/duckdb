# name: test/sql/jit/test_jit_framework.test
# description: JIT framework settings, backend registration, and fallback diagnostics
# group: [jit]

query II
SELECT name, value
FROM duckdb_settings()
WHERE name IN (
    'enable_jit',
    'jit_backend',
    'jit_trace_decisions',
    'jit_event_log_size',
    'jit_policy',
    'jit_trace_runtime',
    'jit_verify',
    'jit_dump_ir'
)
ORDER BY name
----
enable_jit	true
jit_backend	auto
jit_dump_ir	false
jit_event_log_size	4096
jit_policy	auto
jit_trace_decisions	false
jit_trace_runtime	false
jit_verify	false

statement ok
LOAD jit_sljit

query TTIII
SELECT name, description, available::INTEGER, supports_regions::INTEGER,
       selected::INTEGER
FROM duckdb_jit_backends()
ORDER BY name
----
sljit	SLJIT backend for DuckDB JIT framework	1	1	1

statement error
SET jit_backend='missing_backend'
----
JIT backend "missing_backend" is not registered

statement ok
SET jit_backend='auto'

statement ok
SET jit_policy='force'

statement ok
SELECT * FROM duckdb_jit_clear_events()

query I
SELECT 42
----
42

query I
SELECT count(*) = 0
FROM duckdb_jit_events()
WHERE target <> 'region'
----
1

statement ok
CREATE TABLE jit_test AS SELECT i FROM range(3) tbl(i);

query I
SELECT 42
----
42

query I
SELECT i FROM jit_test ORDER BY i
----
0
1
2

statement ok
SET jit_verify=true

query I
SELECT i FROM jit_test ORDER BY i
----
0
1
2

query I
SELECT 42
----
42

statement ok
SET jit_verify=false

query I
SELECT random() IS NOT NULL
----
1

query I
SELECT i + 1
FROM jit_test
WHERE i > 0
ORDER BY 1
----
2
3

query I
SELECT CASE WHEN i > 0 THEN i ELSE 0 END
FROM jit_test
----
0
1
2

query I
SELECT count(*) > 0
FROM duckdb_jit_events()
WHERE backend_name='sljit'
  AND target='region'
  AND status='unsupported'
  AND execution_mode='unsupported'
  AND reason LIKE '%sljit native lowering is not implemented for this region IR node%'
----
1

statement ok
CREATE TEMP TABLE jit_counters_before_clear AS
SELECT coalesce(sum(count), 0) AS counter_count
FROM duckdb_jit_counters()

query I
SELECT Success::INTEGER
FROM duckdb_jit_clear_events()
----
1

query I
SELECT count(*)
FROM duckdb_jit_events()
----
0

query I
SELECT coalesce(sum(count), 0) = counter_count
FROM duckdb_jit_counters(), jit_counters_before_clear
GROUP BY counter_count
----
1

statement ok
SET jit_policy='force'

statement ok
SET jit_verify=true

statement ok
SET jit_dump_ir=true

statement ok
CREATE TABLE jit_native_region AS
SELECT x + 10 AS y
FROM (VALUES (1::BIGINT), (2::BIGINT), (3::BIGINT), (NULL::BIGINT), (5::BIGINT)) AS t(x)
WHERE x > 2

query I
SELECT y FROM jit_native_region ORDER BY y
----
13
15

query I
SELECT count(*) = 0
FROM duckdb_jit_events()
WHERE backend_name='sljit'
  AND target='region'
  AND status='compiled'
  AND execution_mode <> 'native'
  AND candidate_shape='filter-projection-sink'
  AND candidate_scope='full_pipeline'
----
1

query I
SELECT count(*) = 0
FROM duckdb_jit_decision_counters()
WHERE backend_name='sljit'
  AND target='region'
  AND status='compiled'
  AND execution_mode <> 'native'
  AND candidate_shape='filter-projection-sink'
  AND candidate_scope='full_pipeline'
----
1

query I
SELECT count(*) > 0
FROM duckdb_jit_events()
WHERE backend_name='sljit'
  AND target='region'
  AND status='compiled'
  AND execution_mode='native'
  AND region_execution_form='fused'
  AND ir_lowering_time_us >= 0
  AND backend_analysis_time_us >= 0
  AND admission_time_us >= 0
  AND overlap_check_time_us >= 0
  AND codegen_time_us >= 0
  AND decision_time_us >= ir_lowering_time_us
  AND compile_time_us = codegen_time_us
----
1

query I
SELECT count(*) > 0
FROM duckdb_jit_counters()
WHERE backend_name='sljit'
  AND target='region'
  AND status='compiled'
  AND execution_mode='native'
  AND count > 0
  AND ir_lowering_time_us >= 0
  AND backend_analysis_time_us >= 0
  AND admission_time_us >= 0
  AND overlap_check_time_us >= 0
  AND codegen_time_us >= 0
  AND compile_time_us = codegen_time_us
----
1

