statement ok
CREATE TEMP TABLE jit_auto_branchy_projection_second_output AS
SELECT CASE
    WHEN a IS NULL THEN coalesce(b, 0) + c * 3 - d
    WHEN b IS NULL THEN a * 5 - c + e
    WHEN a > b AND (c < d OR e > 50000) THEN
        (((a * 3 + b * 5 - c * 7 + d * 11) * 13)
         + ((a - b + c) * 17)
         - ((a + d) * 19)
         + ((b - c + e) * 23))
    WHEN a < c OR d >= e THEN
        ((a * 31 - b * 37 + c * 41 - d * 43)
         + ((a + b + c + d) * 47)
         - ((a - c) * 53)
         + ((e - b) * 59))
    ELSE
        ((a + b) * 61 - (c + d) * 67 + e * 71)
END AS v
FROM jit_auto_branchy_projection_input

