CREATE TEMP TABLE jit_perfect_join_fact AS
SELECT i::BIGINT AS i, (i % 32)::BIGINT AS k
FROM range(4096) tbl(i)

statement ok
CREATE TEMP TABLE jit_perfect_join_dim AS
SELECT i::BIGINT AS k, (i * 101)::BIGINT AS payload
FROM range(32) tbl(i)

statement ok
ANALYZE jit_perfect_join_fact

statement ok
ANALYZE jit_perfect_join_dim

statement ok
CREATE TEMP TABLE jit_perfect_join_reference AS
SELECT sum(f.i + d.payload) AS total
FROM jit_perfect_join_fact f
JOIN jit_perfect_join_dim d ON f.k = d.k

