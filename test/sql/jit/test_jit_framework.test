500009500000

query I
SELECT count(*) > 0
FROM duckdb_jit_events()
WHERE backend_name='sljit'
  AND target='region'
  AND status='skipped'
  AND execution_mode='executor_fallback'
  AND region_execution_form='none'
  AND policy_decision='auto'
  AND candidate_shape='projection-projection-projection-sink'
  AND candidate_scope='full_pipeline'
  AND admission_shape_key='sljit:full-pipeline:projection-projection-projection-sink:table-scan-source+ungrouped-aggregate-update'
  AND admission_rule_present=false
  AND admission_min_cardinality IS NULL
  AND admission_score IS NULL
  AND admission_proof IS NULL
  AND decision_time_us >= 0
  AND compile_time_us = 0
  AND code_size = 0
  AND reason LIKE '%jit_policy=auto skips region before backend analysis%'
  AND reason LIKE '%SLJIT full-pipeline region requires measured operator-aware admission proof%'
  AND reason LIKE '%admission_rule=missing%'
  AND ir LIKE '%native_source_contract<status=blocked,required_capability=table-function-native-source%'
  AND ir LIKE '%blocker=table-function-getdata-helper-boundary%'
  AND reason LIKE '%source_execution=duckdb-getdata-helper%'
  AND reason LIKE '%sink_kind=ungrouped-aggregate-update%'
  AND candidate_has_source=true
  AND candidate_has_sink=true
  AND candidate_has_table_scan_source=true
  AND candidate_expression_traits_known=true
  AND candidate_arithmetic_projection_count=2
  AND candidate_integer_arithmetic_projection_count=2
  AND candidate_non_integer_arithmetic_projection_count=0
  AND candidate_reference_projection_count=1
  AND candidate_filter_count=0
  AND candidate_projection_count=3
  AND ir LIKE '%traits<source=true,sink=true%'
  AND ir LIKE '%table_scan_source=true%'
  AND ir LIKE '%arithmetic_projections=2%'
  AND ir LIKE '%integer_arithmetic_projections=2%'
  AND ir LIKE '%non_integer_arithmetic_projections=0%'
  AND ir LIKE '%reference_projections=1%'
----
1

