       (ext_price * (100.00::DECIMAL(16,2) - discount))
       + (quantity * (tax + 1.00::DECIMAL(16,2)))
       - (discount * tax)
       + (quantity * 3.00::DECIMAL(16,2))
       + ((ext_price - quantity) * 2.00::DECIMAL(16,2))
       - ((tax + discount) * 4.00::DECIMAL(16,2)) AS revenue
FROM jit_parallel_decimal_input

