CREATE TEMP TABLE jit_auto_complex_projection_input AS
SELECT
    i::BIGINT AS a,
    (i + 1)::BIGINT AS b,
    (i + 2)::BIGINT AS c,
    (i + 3)::BIGINT AS d
FROM range(1000000) tbl(i)

