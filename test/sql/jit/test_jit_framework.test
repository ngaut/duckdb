CREATE TEMP TABLE jit_source_filter_probe_line AS
SELECT i::BIGINT AS k,
       CASE WHEN i % 3 = 0 THEN 'AIR'
            WHEN i % 3 = 1 THEN 'AIR REG'
            ELSE 'TRUCK' END AS mode,
       CASE WHEN i % 5 IN (0, 1) THEN 'DELIVER IN PERSON'
            WHEN i % 5 = 2 THEN 'COLLECT COD'
            ELSE 'NONE' END AS instruct,
       CASE WHEN i % 7 < 5 THEN ((i % 30) + 1)::DECIMAL(15,2)
            ELSE 50.00::DECIMAL(15,2) END AS qty,
       ((i % 100) + 1)::DECIMAL(15,2) AS price
FROM range(100000) tbl(i)

statement ok
CREATE TEMP TABLE jit_source_filter_probe_part AS
SELECT i::BIGINT AS k
FROM range(1000) tbl(i)

statement ok
CREATE TEMP TABLE jit_source_filter_probe_reference AS
SELECT sum(1.00::DECIMAL(15,2)) AS cnt,
       sum(qty)::DECIMAL(18,2) AS qty_sum,
       sum(price)::DECIMAL(18,2) AS price_sum
FROM jit_source_filter_probe_line, jit_source_filter_probe_part
WHERE jit_source_filter_probe_part.k = jit_source_filter_probe_line.k
  AND mode IN ('AIR', 'AIR REG')
  AND instruct = 'DELIVER IN PERSON'
  AND (qty <= 11 OR (qty >= 10 AND qty <= 20) OR (qty >= 20 AND qty <= 30))

