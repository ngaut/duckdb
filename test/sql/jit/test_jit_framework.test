CREATE TEMP TABLE jit_auto_projection_baseline AS
SELECT coalesce(max(event_id), 0) AS base_event_id FROM duckdb_jit_events()

query I
SELECT sum(j)
FROM (SELECT i::BIGINT + 7 AS j FROM range(1000000) tbl(i))
----
500006500000

query I
SELECT count(*) = 0
FROM duckdb_jit_events(), jit_auto_projection_baseline
WHERE event_id > base_event_id
  AND backend_name='sljit'
  AND target='region'
  AND status='compiled'
  AND policy_decision='auto'
----
1

query I
SELECT count(*) > 0
FROM duckdb_jit_events(), jit_auto_projection_baseline
WHERE event_id > base_event_id
  AND backend_name='sljit'
  AND target='region'
  AND status='skipped'
  AND policy_decision='auto'
  AND decision_time_us >= 0
  AND compile_time_us = 0
----
1

