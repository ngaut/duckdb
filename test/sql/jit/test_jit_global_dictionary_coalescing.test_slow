# name: test/sql/jit/test_jit_global_dictionary_coalescing.test_slow
# description: A compiled step coalesces small chunks before its sink; chunks whose columns carry a global dictionary
#              reach the sink as they are, so a downstream caching operator that accumulated the dictionary's indices
#              never sees that column change representation (TPC-H SF1 with NULLs, a CTE read twice)
# group: [jit]

require tpch

statement ok
LOAD jit_sljit

statement ok
CALL dbgen(sf=1)

statement ok
CREATE OR REPLACE TABLE part AS SELECT p_partkey, CASE WHEN hash(rowid, 1) % 10 = 0 THEN NULL ELSE p_name END AS p_name, CASE WHEN hash(rowid, 2) % 10 = 0 THEN NULL ELSE p_mfgr END AS p_mfgr, CASE WHEN hash(rowid, 3) % 10 = 0 THEN NULL ELSE p_brand END AS p_brand, CASE WHEN hash(rowid, 4) % 10 = 0 THEN NULL ELSE p_type END AS p_type, CASE WHEN hash(rowid, 5) % 10 = 0 THEN NULL ELSE p_size END AS p_size, CASE WHEN hash(rowid, 6) % 10 = 0 THEN NULL ELSE p_container END AS p_container, CASE WHEN hash(rowid, 7) % 10 = 0 THEN NULL ELSE p_retailprice END AS p_retailprice, CASE WHEN hash(rowid, 8) % 10 = 0 THEN NULL ELSE p_comment END AS p_comment FROM part

statement ok
CREATE OR REPLACE TABLE lineitem AS SELECT CASE WHEN hash(rowid, 0) % 10 = 0 THEN NULL ELSE l_orderkey END AS l_orderkey, CASE WHEN hash(rowid, 1) % 10 = 0 THEN NULL ELSE l_partkey END AS l_partkey, CASE WHEN hash(rowid, 2) % 10 = 0 THEN NULL ELSE l_suppkey END AS l_suppkey, CASE WHEN hash(rowid, 3) % 10 = 0 THEN NULL ELSE l_linenumber END AS l_linenumber, CASE WHEN hash(rowid, 4) % 10 = 0 THEN NULL ELSE l_quantity END AS l_quantity, CASE WHEN hash(rowid, 5) % 10 = 0 THEN NULL ELSE l_extendedprice END AS l_extendedprice, CASE WHEN hash(rowid, 6) % 10 = 0 THEN NULL ELSE l_discount END AS l_discount, CASE WHEN hash(rowid, 7) % 10 = 0 THEN NULL ELSE l_tax END AS l_tax, CASE WHEN hash(rowid, 8) % 10 = 0 THEN NULL ELSE l_returnflag END AS l_returnflag, CASE WHEN hash(rowid, 9) % 10 = 0 THEN NULL ELSE l_linestatus END AS l_linestatus, CASE WHEN hash(rowid, 10) % 10 = 0 THEN NULL ELSE l_shipdate END AS l_shipdate, CASE WHEN hash(rowid, 11) % 10 = 0 THEN NULL ELSE l_commitdate END AS l_commitdate, CASE WHEN hash(rowid, 12) % 10 = 0 THEN NULL ELSE l_receiptdate END AS l_receiptdate, CASE WHEN hash(rowid, 13) % 10 = 0 THEN NULL ELSE l_shipinstruct END AS l_shipinstruct, CASE WHEN hash(rowid, 14) % 10 = 0 THEN NULL ELSE l_shipmode END AS l_shipmode, CASE WHEN hash(rowid, 15) % 10 = 0 THEN NULL ELSE l_comment END AS l_comment FROM lineitem

statement ok
CREATE OR REPLACE TABLE orders AS SELECT o_orderkey, CASE WHEN hash(rowid, 1) % 10 = 0 THEN NULL ELSE o_custkey END AS o_custkey, CASE WHEN hash(rowid, 2) % 10 = 0 THEN NULL ELSE o_orderstatus END AS o_orderstatus, CASE WHEN hash(rowid, 3) % 10 = 0 THEN NULL ELSE o_totalprice END AS o_totalprice, CASE WHEN hash(rowid, 4) % 10 = 0 THEN NULL ELSE o_orderdate END AS o_orderdate, CASE WHEN hash(rowid, 5) % 10 = 0 THEN NULL ELSE o_orderpriority END AS o_orderpriority, CASE WHEN hash(rowid, 6) % 10 = 0 THEN NULL ELSE o_clerk END AS o_clerk, CASE WHEN hash(rowid, 7) % 10 = 0 THEN NULL ELSE o_shippriority END AS o_shippriority, CASE WHEN hash(rowid, 8) % 10 = 0 THEN NULL ELSE o_comment END AS o_comment FROM orders

statement ok
CREATE OR REPLACE TABLE partsupp AS SELECT CASE WHEN hash(rowid, 0) % 10 = 0 THEN NULL ELSE ps_partkey END AS ps_partkey, CASE WHEN hash(rowid, 1) % 10 = 0 THEN NULL ELSE ps_suppkey END AS ps_suppkey, CASE WHEN hash(rowid, 2) % 10 = 0 THEN NULL ELSE ps_availqty END AS ps_availqty, CASE WHEN hash(rowid, 3) % 10 = 0 THEN NULL ELSE ps_supplycost END AS ps_supplycost, CASE WHEN hash(rowid, 4) % 10 = 0 THEN NULL ELSE ps_comment END AS ps_comment FROM partsupp

foreach threads 1 4

statement ok
SET threads=${threads}

foreach policy off auto

statement ok
SET jit_policy='${policy}'

query II nosort cte_read_twice_${threads}
WITH c(c0, c1) AS MATERIALIZED (SELECT t1.p_container, t2.l_receiptdate FROM part t1 JOIN lineitem t2 ON t1.p_partkey = t2.l_partkey JOIN orders t3 ON t2.l_orderkey = t3.o_orderkey JOIN partsupp t4 ON t2.l_partkey = t4.ps_partkey AND t2.l_suppkey = t4.ps_suppkey WHERE t2.l_shipdate < DATE '1995-01-06' AND t2.l_suppkey < 84000 AND t2.l_partkey % 8 = 1) SELECT count(*) AS n, sum(hash(f0, f1)) AS h FROM (SELECT c0, c1 FROM c UNION ALL SELECT c0, c1 FROM c WHERE c0 IS NOT NULL) AS q(f0, f1)
----

endloop

endloop
