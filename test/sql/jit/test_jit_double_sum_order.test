# name: test/sql/jit/test_jit_double_sum_order.test
# description: A generated ungrouped double sum adds its rows to the state in source order, so its result is DuckDB's
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_measure_native_legs=false

statement ok
SET threads=1

statement ok
CREATE TABLE facts AS
SELECT (i % 97)::INTEGER AS g, (i % 100000)::DECIMAL(15,2) AS price, (i * 0.37)::DOUBLE / 7 AS dbl
FROM range(400000) tbl(i)

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
CREATE OR REPLACE TABLE r_{policy} AS
SELECT 'filtered' AS q, sum(dbl * 3) AS a, avg(dbl) AS b, sum(price::DOUBLE * 1.5) AS c FROM facts WHERE g < 50
UNION ALL
SELECT 'plain', sum(dbl), avg(dbl * 3), sum(dbl * dbl) FROM facts

endloop

query I
SELECT count(*) FROM ((SELECT * FROM r_off EXCEPT ALL SELECT * FROM r_auto)
                      UNION ALL (SELECT * FROM r_auto EXCEPT ALL SELECT * FROM r_off))
----
0
