# name: test/sql/jit/test_jit_decimal128_narrow.test
# description: DECIMAL +/- results widened to DECIMAL128 by one digit stay in 64-bit JIT registers when their magnitude
# group: [jit]

#              is structurally bounded by INT64_MAX (narrow DECIMAL128). Expected values come from jit_policy='off'.

statement ok
LOAD jit_sljit

statement ok
SET threads=1

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_dump_ir=true

statement ok
SET jit_event_log_size=100000

statement ok
CREATE TABLE n18 AS
SELECT i AS id,
       CASE WHEN i % 97 = 0 THEN NULL
            WHEN i % 1000 = 1 THEN 99999999999999.9999::DECIMAL(18,4)
            WHEN i % 1000 = 2 THEN -99999999999999.9999::DECIMAL(18,4)
            ELSE printf('%d.%04d', (i * 7919 * 1000003) % 20000000000003 - 10000000000001, (i * 37) % 10000)::DECIMAL(18,4)
       END AS a,
       CASE WHEN i % 89 = 0 THEN NULL
            WHEN i % 1000 IN (1, 2) THEN 99999999999999.9999::DECIMAL(18,4)
            ELSE printf('%d.%04d', (i * 104729 * 100003) % 30000000000007 - 15000000000003, (i * 53) % 10000)::DECIMAL(18,4)
       END AS b,
       printf('%d.%04d', (i * 31) % 1000003 - 500001, (i * 71) % 10000)::DECIMAL(18,4) AS c,
       CASE WHEN i % 83 = 0 THEN NULL ELSE printf('%d.%04d', (i % 4096) - 2048, (i * 13) % 10000)::DECIMAL(18,4) END AS d
FROM range(20000) tbl(i)

statement ok
CREATE TABLE n15 AS
SELECT i AS id,
       CASE WHEN i % 61 = 0 THEN NULL ELSE printf('%d.%02d', (i * 7919 * 99991) % 2000000000003 - 1000000000001, (i * 37) % 100)::DECIMAL(15,2) END AS a,
       printf('%d.%02d', (i * 104729 * 9973) % 1999999999973 - 999999999986, (i * 53) % 100)::DECIMAL(15,2) AS b,
       printf('%d.%02d', (i * 31) % 100000007 - 50000003, (i * 71) % 100)::DECIMAL(15,2) AS c,
       CASE WHEN i % 53 = 0 THEN NULL ELSE printf('%d.%02d', (i % 4096) - 2048, (i * 13) % 100)::DECIMAL(15,2) END AS d,
       printf('%d.%02d', (i * 13 * 7777777) % 1999999999999 - 999999999999, (i * 7) % 100)::DECIMAL(15,2) AS e
FROM range(20000) tbl(i)

statement ok
CREATE TABLE x18 AS
SELECT * FROM (VALUES
    (1, 999999999999999999::DECIMAL(18,0), 999999999999999999::DECIMAL(18,0)),
    (2, -999999999999999999::DECIMAL(18,0), 999999999999999999::DECIMAL(18,0)),
    (3, 999999999999999999::DECIMAL(18,0), -999999999999999999::DECIMAL(18,0)),
    (4, -999999999999999999::DECIMAL(18,0), -999999999999999999::DECIMAL(18,0)),
    (5, NULL::DECIMAL(18,0), 1::DECIMAL(18,0)),
    (6, 0::DECIMAL(18,0), -1::DECIMAL(18,0))
) t(id, a, b)

statement ok
CREATE TABLE xs AS
SELECT CASE WHEN i % 2 = 0 THEN 999999999999999999 ELSE -999999999999999999 END::DECIMAL(18,0) AS a,
       CASE WHEN i % 3 = 0 THEN -999999999999999999 ELSE 999999999999999999 END::DECIMAL(18,0) AS b,
       (i % 4)::INTEGER AS g
FROM range(6000) tbl(i)

statement ok
CREATE TABLE q9t AS
SELECT i AS id,
       printf('%d.%02d', (i * 7919) % 2000003 - 1000001, (i * 37) % 100)::DECIMAL(15,2) AS price,
       printf('0.%02d', (i * 7) % 11)::DECIMAL(15,2) AS disc,
       CASE WHEN i % 71 = 0 THEN NULL ELSE printf('%d.%02d', (i * 13) % 1001, (i * 3) % 100)::DECIMAL(15,2) END AS cost,
       printf('%d.00', 1 + (i % 50))::DECIMAL(15,2) AS qty,
       (i % 5)::INTEGER AS g,
       'nation_' || (i % 25)::VARCHAR AS nation,
       ((i * 7) % 1000)::BIGINT AS sk
FROM range(50000) tbl(i)

statement ok
CREATE TABLE sup AS
SELECT i::BIGINT AS sk,
       printf('%d.%02d', (i * 37) % 1001, (i * 11) % 100)::DECIMAL(15,2) AS supplycost,
       'nation_' || (i % 25)::VARCHAR AS nation
FROM range(1000) tbl(i)

# Projection of a + b (DECIMAL(18,4) -> DECIMAL(19,4)) materialized into an INT128 vector, with NULLs and extremes.
statement ok
SELECT * FROM duckdb_jit_clear_events()

query IIIII
SELECT count(*), count(s), sum(s), min(s), max(s) FROM (SELECT a + b AS s FROM n18)
----
20000	19571	1307073971791135.7166	-24944823286172.0270	199999999999999.9998

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status='compiled' AND phase='compile' AND ir LIKE '%DECIMAL(19%'
----
true

# Projection of a - b.
statement ok
SELECT * FROM duckdb_jit_clear_events()

query IIIII
SELECT count(*), count(s), sum(s), min(s), max(s) FROM (SELECT a - b AS s FROM n18)
----
20000	19571	-5121995428842772.5950	-199999999999999.9998	21101129079616.6830

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status='compiled' AND phase='compile' AND ir LIKE '%DECIMAL(19%'
----
true

# Chain a + b - c + d: narrow -> narrow same-scale widening casts (DECIMAL(19,4) .. DECIMAL(21,4)).
statement ok
SELECT * FROM duckdb_jit_clear_events()

query IIIII
SELECT count(*), count(s), sum(s), min(s), max(s) FROM (SELECT a + b - c + d AS s FROM n18)
----
20000	19335	1320903481469869.4520	-24944822788309.0096	200000000497923.0056

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status='compiled' AND phase='compile' AND ir LIKE '%DECIMAL(19%'
----
true

# Narrow constants (folded DECIMAL(19,4) literals).
statement ok
SELECT * FROM duckdb_jit_clear_events()

query IIIII
SELECT count(*), count(s), sum(s), min(s), max(s) FROM (SELECT b - 99999999999999.9999 AS s FROM n18)
----
20000	19775	-1974226669304857406.9031	-114998955922694.3636	0.0000

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status='compiled' AND phase='compile' AND ir LIKE '%DECIMAL(19%'
----
true

# DECIMAL(15,2) chain stays DECIMAL64 for four terms and becomes narrow DECIMAL(19,2) at the fifth.
statement ok
SELECT * FROM duckdb_jit_clear_events()

query IIIII
SELECT count(*), count(s), sum(s), min(s), max(s) FROM (SELECT a + b - c + d AS s FROM n15)
----
20000	19301	-642182955894533.08	-1998113711016.32	1913627022180.98

statement ok
SELECT * FROM duckdb_jit_clear_events()

query IIIII
SELECT count(*), count(s), sum(s), min(s), max(s) FROM (SELECT a + b - c + d + e AS s FROM n15)
----
20000	19301	-851711556311348.38	-2998012599914.39	2387300664045.15

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status='compiled' AND phase='compile' AND ir LIKE '%DECIMAL(19%'
----
true

# DECIMAL(18,0) extremes: |a +/- b| = 1999999999999999998 needs the full 64-bit register.
statement ok
SELECT * FROM duckdb_jit_clear_events()

query II
SELECT id, a + b AS s FROM x18 ORDER BY id
----
1	1999999999999999998
2	0
3	0
4	-1999999999999999998
5	NULL
6	-1

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status='compiled' AND phase='compile' AND ir LIKE '%DECIMAL(19%'
----
true

statement ok
SELECT * FROM duckdb_jit_clear_events()

query II
SELECT id, a - b AS s FROM x18 ORDER BY id
----
1	0
2	-1999999999999999998
3	1999999999999999998
4	0
5	NULL
6	1

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status='compiled' AND phase='compile' AND ir LIKE '%DECIMAL(19%'
----
true

# Nine DECIMAL(18,0) terms are bounded by 9 * (10^18 - 1) < INT64_MAX and stay narrow.
statement ok
SELECT * FROM duckdb_jit_clear_events()

query II
SELECT id, a + b + a + b + a + b + a + b + a AS s FROM x18 ORDER BY id
----
1	8999999999999999991
2	-999999999999999999
3	999999999999999999
4	-8999999999999999991
5	NULL
6	-4

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status='compiled' AND phase='compile' AND ir LIKE '%DECIMAL(19%'
----
true

# Ten terms exceed the INT64 bound; the result must still be exact (|s| > INT64_MAX).
statement ok
SELECT * FROM duckdb_jit_clear_events()

query II
SELECT id, a + b + a + b + a + b + a + b + a + b AS s FROM x18 ORDER BY id
----
1	9999999999999999990
2	0
3	0
4	-9999999999999999990
5	NULL
6	-5

# Fast-path null handling: a CASE ... ELSE NULL under a narrow widening cast must stay NULL.
statement ok
SELECT * FROM duckdb_jit_clear_events()

query III
SELECT count(*), count(s), sum(s) FROM (SELECT (CASE WHEN c > 0 THEN c ELSE NULL END) + c AS s FROM n18)
----
20000	3870	464392296.5330

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status='compiled' AND phase='compile' AND ir LIKE '%DECIMAL(19%'
----
true

