# Common-subexpression elimination hoists the shared casts into their own projection; the remaining INT128 references are
# not narrow (unbounded), so only exact results are required here.
statement ok
SELECT * FROM duckdb_jit_clear_events()

query III
SELECT g, sum(a + b), sum(a - b) FROM xs GROUP BY g ORDER BY g
----
0	1999999999999999998000	999999999999999999000
1	-999999999999999999000	-1999999999999999998000
2	1999999999999999998000	999999999999999999000
3	-999999999999999999000	-1999999999999999998000

# Materialization (CREATE TABLE AS) of narrow roots.
statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE TEMP TABLE narrow_out AS SELECT id, a + b - c AS s FROM n18

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status='compiled' AND phase='compile' AND ir LIKE '%DECIMAL(19%'
----
true

query IIIII
SELECT count(*), count(s), sum(s), min(s), max(s) FROM narrow_out
----
20000	19571	1307077690462843.3508	-24944822786264.0057	200000000499970.0069

query II
SELECT sum(s * id), sum(s * (id % 7)) FROM narrow_out
----
207973565140369617875.3620	4097437208525506.5328

