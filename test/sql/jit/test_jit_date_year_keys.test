# name: test/sql/jit/test_jit_date_year_keys.test
# description: year() of a date column as a group key the generated perfect hash lookup evaluates on its fast loops (an infinite date has no year and joins the NULL key), alone and compressed, with NULL dates and dates centuries apart; year() as a payload over infinite dates, grouped and ungrouped, filtered or not
# group: [jit]

require jit_sljit

load {TEST_DIR}/jit_date_year_keys.db

statement ok
CREATE TABLE facts AS
SELECT i AS id,
       i % 7 AS k,
       DATE '1992-01-01' + (i % 2500)::INTEGER AS dt,
       CASE WHEN i % 983 = 0 THEN NULL ELSE DATE '1992-01-01' + (i % 2500)::INTEGER END AS dt_null,
       DATE '1600-02-28' + (i % 200000)::INTEGER AS wide,
       CASE WHEN i % 997 = 0 THEN 'infinity'::DATE WHEN i % 991 = 0 THEN '-infinity'::DATE
            WHEN i % 983 = 0 THEN NULL ELSE DATE '1990-03-01' + (i % 4000)::INTEGER END AS dt_inf
FROM range(600003) t(i)

statement ok
CHECKPOINT

restart

statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
CREATE OR REPLACE TEMP TABLE r_{policy} AS
SELECT 'year_key' AS shape, year(dt) AS key, NULL::BIGINT AS key2, count(*) AS c, sum(id) AS total
FROM facts GROUP BY ALL
UNION ALL
SELECT 'year_null_key', year(dt_null), NULL, count(*), sum(id) FROM facts GROUP BY ALL
UNION ALL
SELECT 'year_wide_key', year(wide), NULL, count(*), sum(id) FROM facts GROUP BY ALL
UNION ALL
SELECT 'year_two_keys', year(dt), k, count(*), sum(id) FROM facts GROUP BY ALL
UNION ALL
SELECT 'year_where', year(dt), NULL, count(*), sum(id) FROM facts WHERE id % 3 = 1 GROUP BY ALL
UNION ALL
SELECT 'year_payload', NULL, NULL, count(year(dt_inf)), sum(year(dt_inf)) FROM facts
UNION ALL
SELECT 'year_payload_grouped', k, NULL, count(year(dt_inf)), sum(year(dt_inf)) FROM facts GROUP BY k
UNION ALL
SELECT 'year_payload_filtered', k, NULL, count(year(dt_inf)), min(year(dt_inf)) FROM facts WHERE id % 3 = 1
GROUP BY k

endloop

query I
SELECT count(*) FROM ((SELECT * FROM r_off EXCEPT ALL SELECT * FROM r_auto)
                      UNION ALL (SELECT * FROM r_auto EXCEPT ALL SELECT * FROM r_off))
----
0

query II
SELECT shape, count(*) FROM r_auto GROUP BY shape ORDER BY shape
----
year_key	7
year_null_key	8
year_payload	1
year_payload_filtered	7
year_payload_grouped	7
year_two_keys	49
year_where	7
year_wide_key	548

endloop
