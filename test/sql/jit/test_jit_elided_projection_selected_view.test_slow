# name: test/sql/jit/test_jit_elided_projection_selected_view.test_slow
# description: A projection after a join whose probe runs on the source of an elided pre-join projection (the join keys
#              compressed to INTEGER) reads the join output in the projection's layout, at the default cost model
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=100000

# keys within INTEGER range and enough rows for compressed materialization to cast both join keys before the join
statement ok
CREATE TABLE o AS
SELECT (i * 4 + 1)::BIGINT AS ok, (i % 50000)::BIGINT AS ck, (i % 5)::VARCHAR AS pri, (i % 7)::INTEGER AS st
FROM range(1500000) t(i)

statement ok
CREATE TABLE l AS
SELECT ((i // 4) * 4 + 1)::BIGINT AS lk, (i % 3)::VARCHAR AS flag, (i % 7)::INTEGER AS ln
FROM range(6000000) t(i)

foreach threads 1 4

statement ok
SET threads=${threads}

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT 'distinct_build' AS q, (SELECT count(*) FROM (SELECT DISTINCT ck FROM l JOIN o ON lk = ok))::VARCHAR AS k,
       NULL::BIGINT AS v
UNION ALL
SELECT 'distinct_per_probe', flag, count(DISTINCT pri) FROM l JOIN o ON lk = ok GROUP BY flag
UNION ALL
SELECT 'max_per_probe', ln::VARCHAR, max(ck) FROM l JOIN o ON lk = ok GROUP BY ln

statement ok
SET jit_policy='auto'

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT 'distinct_build' AS q, (SELECT count(*) FROM (SELECT DISTINCT ck FROM l JOIN o ON lk = ok))::VARCHAR AS k,
       NULL::BIGINT AS v
UNION ALL
SELECT 'distinct_per_probe', flag, count(DISTINCT pri) FROM l JOIN o ON lk = ok GROUP BY flag
UNION ALL
SELECT 'max_per_probe', ln::VARCHAR, max(ck) FROM l JOIN o ON lk = ok GROUP BY ln

query II
SELECT (SELECT count(*) FROM expected),
       (SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                              UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)))
----
11	0

# the probe ran compiled behind the elided key-cast projection
query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND status = 'executed'
  AND pipeline_shape LIKE '%op0:projection:PROJECTION:none;op1:operator:HASH_JOIN%'
  AND jit_runtime_path_counts LIKE '%unchecked_int64_to_int32%'
----
true

endloop
