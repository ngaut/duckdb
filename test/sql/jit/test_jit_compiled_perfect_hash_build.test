# name: test/sql/jit/test_jit_compiled_perfect_hash_build.test
# description: A hash join build sunk by a compiled kernel records the keys of every chunk as the native sink does: the
# group: [jit]

#              perfect hash table it finalizes into covers the compiled rows' keys

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET threads=1

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=1048576

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_full_pipeline_benefit=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TABLE b AS SELECT i::BIGINT AS j FROM range(368640) t(i)

statement ok
CREATE TABLE p AS SELECT (i * 3 + 1)::BIGINT AS k FROM range(368640) t(i)

# Without join filter pushdown, finalize sizes the perfect hash table from the keys recorded while sinking
statement ok
SET disabled_optimizers='join_filter_pushdown'

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=10000

query I
SELECT count(*) FROM p JOIN (SELECT j * 3 + 1 AS x FROM b WHERE j % 5 <> 7) bb ON p.k = bb.x
----
368640

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND status = 'executed' AND pipeline_shape LIKE '%sink:sink:HASH_JOIN%'
----
true
