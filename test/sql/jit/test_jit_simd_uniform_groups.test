# name: test/sql/jit/test_jit_simd_uniform_groups.test
# description: Packed SIMD filters over 32-bit lanes take the all-true and all-false paths of whole groups
# group: [jit]

# Rows pass in long runs, so most 4-row groups of INTEGER and DATE lanes are uniform. The ARM64 group classifier sums
# the lane masks; the sum must reach the comparison sign-extended, or every all-true group would run the mixed-lane
# loop. Each loop kind (selection, count, hybrid with a string residual, filtered aggregates) must give DuckDB's rows.

load {TEST_DIR}/jit_simd_uniform_groups.db

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=10000

statement ok
CREATE TABLE u AS
SELECT i::INTEGER AS i,
       DATE '2020-01-01' + (i // 50)::INTEGER AS d,
       CASE WHEN i % 1000 BETWEEN 300 AND 310 THEN NULL ELSE (i // 7)::INTEGER END AS n,
       CASE i % 3 WHEN 0 THEN 'A' WHEN 1 THEN 'N' ELSE 'R' END AS g,
       CASE (i // 100) % 4 WHEN 0 THEN 'MAIL' WHEN 1 THEN 'SHIP' WHEN 2 THEN 'AIR' ELSE 'RAIL' END AS s,
       CAST(i % 1000 AS DECIMAL(15,2)) AS price,
       i::BIGINT * 3 AS v
FROM range(300000) t(i)

statement ok
CHECKPOINT

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

# INTEGER and DATE predicates whose rows pass in runs
query II
SELECT count(*), sum(v) FROM u WHERE i >= 1000 AND i < 250000
----
249000	93748126500

query II
SELECT count(*), sum(v) FROM u WHERE d >= DATE '2020-03-01' AND d < DATE '2025-01-01'
----
88350	12503601225

query II
SELECT count(*), sum(v) FROM u WHERE i BETWEEN 5000 AND 200000 AND d <= DATE '2030-01-01'
----
177700	50031168450

query I
SELECT count(*) FROM u WHERE i >= 1000 AND i < 250000
----
249000

# a nullable column
query II
SELECT count(*), sum(v) FROM u WHERE n >= 100 AND n < 30000
----
207001	65422662465

# a string residual behind the packed prefix
query II
SELECT count(*), sum(v) FROM u WHERE i >= 1000 AND i < 250000 AND s IN ('MAIL', 'AIR')
----
124500	46855388250

query II
SELECT count(*), sum(v) FROM u WHERE d >= DATE '2020-03-01' AND d < DATE '2025-01-01' AND s = 'SHIP'
----
22050	3125565675

# the filtered perfect-hash aggregate
query III
SELECT g, count(*), sum(price) FROM u WHERE d >= DATE '2020-03-01' AND d < DATE '2025-01-01' GROUP BY g ORDER BY g
----
A	29450	14672575.00
N	29450	14672025.00
R	29450	14672475.00

query III
SELECT g, count(*), sum(price) FROM u WHERE i >= 1000 AND i < 250000 AND n IS NOT NULL GROUP BY g ORDER BY g
----
A	82087	41180035.00
N	82087	41180035.00
R	82087	41180035.00

# selected rows themselves
query I
SELECT i FROM u WHERE i >= 299990 OR i < 3 ORDER BY i
----
0
1
2
299990
299991
299992
299993
299994
299995
299996
299997
299998
299999

query III
SELECT count(*), min(i), max(i) FROM (SELECT i FROM u WHERE i >= 1001 AND i < 249999)
----
248998	1001	249998

endloop

endloop
