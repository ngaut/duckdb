# name: test/sql/jit/test_jit_partitioned_sink_order.test_slow
# description: A compiled pipeline whose steps batch rows across source chunks (a filter feeding a projection) sinks
# group: [jit]

#              each source chunk's rows under that chunk's batch index, so order-preserving sinks keep insertion order

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=10000

statement ok
CREATE TABLE t AS SELECT i::BIGINT AS i, (i % 1000)::BIGINT AS m FROM range(3000000) tbl(i)

statement ok
SET threads=4

# batch insert: the filter leaves partial chunks that the projection batches across source chunks
statement ok
CREATE TABLE t2 AS SELECT i + 1 AS j FROM t WHERE m < 300

statement ok
INSERT INTO t2 SELECT i + 3000001 FROM t WHERE m >= 700

query II
SELECT count(*), count(*) FILTER (WHERE prev > j) FROM (SELECT j, lag(j) OVER (ORDER BY rowid) AS prev FROM t2)
----
1800000	0

# both statements ran compiled, so the order above is the steps' order
query I
SELECT count(DISTINCT pipeline_shape) FROM duckdb_jit_events()
WHERE phase = 'runtime' AND status = 'executed'
  AND (pipeline_shape LIKE '%BATCH_CREATE_TABLE_AS%' OR pipeline_shape LIKE '%BATCH_INSERT%')
----
2

# result collector
query I
SELECT i + 1 AS j FROM t WHERE m < 300
----
900000 values hashing to 7ed129351c2d81c501090943511fd408
