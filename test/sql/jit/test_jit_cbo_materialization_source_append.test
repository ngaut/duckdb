# name: test/sql/jit/test_jit_cbo_materialization_source_append.test
# description: JIT CBO charges materialization source-append cost for reference VARCHAR projections
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET threads=1

statement ok
SET enable_jit=true

statement ok
SET jit_backend='auto'

statement ok
SET jit_policy='auto'

statement ok
SET jit_trace_decisions=true

statement ok
SET jit_event_log_size=4096

statement ok
SET jit_cbo_generated_stage_benefit=1

statement ok
SET jit_cbo_materialization_elision_benefit=0

statement ok
SET jit_cbo_native_operator_stage_benefit=0

statement ok
SET jit_cbo_full_pipeline_benefit=0

statement ok
SET jit_cbo_startup_base_cost=200

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TEMP TABLE jit_source_append_cbo_input AS
SELECT i::INTEGER AS id,
       (i % 1000)::INTEGER AS a,
       'customer-' || ((i % 1024)::VARCHAR) AS name
FROM range(10000) tbl(i)

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE TEMP TABLE jit_source_append_cbo_rejected AS
SELECT id,
       a + 1 AS a2,
       name
FROM jit_source_append_cbo_input

query I
SELECT count(*)
FROM (
    SELECT * FROM jit_source_append_cbo_rejected
    EXCEPT ALL
    SELECT id,
           a + 1 AS a2,
           name
    FROM jit_source_append_cbo_input
) diff
----
0

query I
SELECT count(*) > 0
FROM duckdb_jit_events()
WHERE runner_cost_profile
  AND status='skipped'
  AND selected_runner='vectorized'
  AND runner_cost_materialization_source_append_count=1
  AND runner_cost_materialization_source_append_penalty=80
  AND runner_cost_saved_work_per_batch < 0
  AND NOT runner_cost_selected_accelerated_runner
----
1

statement ok
CREATE TEMP TABLE jit_float_cbo_input AS
SELECT i::FLOAT AS x,
       (i * 0.5)::FLOAT AS y
FROM range(10000) tbl(i)

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE TEMP TABLE jit_float_cbo_selected AS
SELECT x + 1.0::FLOAT AS a,
       x * 1.0001::FLOAT AS b,
       y - 3.0::FLOAT AS c,
       x + y AS d,
       x - y AS e,
       y * 1.25::FLOAT AS f,
       x / 1.5::FLOAT AS g,
       y + 9.0::FLOAT AS h
FROM jit_float_cbo_input

query I
SELECT count(*)
FROM (
    SELECT * FROM jit_float_cbo_selected
    EXCEPT ALL
    SELECT x + 1.0::FLOAT AS a,
           x * 1.0001::FLOAT AS b,
           y - 3.0::FLOAT AS c,
           x + y AS d,
           x - y AS e,
           y * 1.25::FLOAT AS f,
           x / 1.5::FLOAT AS g,
           y + 9.0::FLOAT AS h
    FROM jit_float_cbo_input
) diff
----
0

query I
SELECT count(*) > 0
FROM duckdb_jit_events()
WHERE runner_cost_profile
  AND status='compiled'
  AND selected_runner='compiled_vectorized'
  AND runner_cost_materialization_source_append_count=0
  AND runner_cost_materialization_source_append_penalty=0
  AND runner_cost_saved_work_per_batch > 0
  AND runner_cost_selected_accelerated_runner
----
1
