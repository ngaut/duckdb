ZYXW	7060	10587
ZYXWV	7059	10588
ZYXWVU	7058	10589
ZYXWVUTS	7059	10588
ZYXWVUTSR	7060	10587
ZYXWVUTSRQ	7059	10588
ZYXWVUTSRQP	7058	10589
ZYXWVUTSRQPO	7058	10589
ZYXWVUTSRQPON	7059	10588
ZYXWVUTSRQPONM	7060	10587
ZYXWVUTSRQPONML	7059	10588
NULL	14118	21176

# a key of 16 bytes or more does not compress
query III
SELECT CASE WHEN s.order_id % 1000 = 0 THEN 'a group key past sixteen bytes' ELSE s.g END AS k,
       sum(CASE WHEN o.priority = '1-URGENT' OR o.priority = '2-HIGH' THEN 1 ELSE 0 END),
       sum(CASE WHEN o.priority <> '1-URGENT' AND o.priority <> '2-HIGH' THEN 1 ELSE 0 END)
FROM ship s JOIN orders o USING (order_id)
GROUP BY k ORDER BY k
----
(empty)	14082	21177
