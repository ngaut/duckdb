# name: test/sql/jit/test_jit_string_group_key_compress.test
# description: String group keys of every length below 16 bytes compress into a 128-bit key on the join consumer path
# group: [jit]

# Keys up to 12 bytes are inlined, 13 to 15 byte keys live out of line, and each length has two keys that share
# their prefix with the shorter ones, so a wrong byte or length in the compressed key merges or splits groups

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TABLE orders AS
SELECT i::BIGINT AS order_id,
       CASE i % 5 WHEN 0 THEN '1-URGENT' WHEN 1 THEN '2-HIGH' WHEN 2 THEN '3-MEDIUM' ELSE '4-NOT SPECIFIED' END AS priority
FROM range(150000) t(i)

statement ok
CREATE TABLE ship AS
SELECT (i % 150000)::BIGINT AS order_id,
       CASE WHEN i % 17 = 16 THEN NULL
            WHEN (i // 17) % 2 = 0 THEN left('0123456789abcdef', (i % 17)::INTEGER)
            ELSE left('ZYXWVUTSRQPONMLK', (i % 17)::INTEGER) END AS g
FROM range(600000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

query III
SELECT s.g,
       sum(CASE WHEN o.priority = '1-URGENT' OR o.priority = '2-HIGH' THEN 1 ELSE 0 END),
       sum(CASE WHEN o.priority <> '1-URGENT' AND o.priority <> '2-HIGH' THEN 1 ELSE 0 END)
FROM ship s JOIN orders o USING (order_id)
GROUP BY s.g ORDER BY s.g
----
(empty)	14118	21177
0	7060	10588
01	7059	10588
012	7058	10589
0123	7058	10589
01234	7059	10588
012345	7060	10587
0123456	7059	10588
01234567	7058	10589
012345678	7058	10589
0123456789	7059	10588
0123456789a	7060	10587
0123456789ab	7059	10588
0123456789abc	7058	10589
0123456789abcd	7058	10589
0123456789abcde	7059	10588
Z	7058	10589
ZY	7058	10589
ZYX	7059	10588
ZYXW	7060	10587
ZYXWV	7059	10588
ZYXWVU	7058	10589
ZYXWVUT	7058	10589
ZYXWVUTS	7059	10588
ZYXWVUTSR	7060	10587
ZYXWVUTSRQ	7059	10588
ZYXWVUTSRQP	7058	10589
ZYXWVUTSRQPO	7058	10589
ZYXWVUTSRQPON	7059	10588
ZYXWVUTSRQPONM	7060	10587
ZYXWVUTSRQPONML	7059	10588
NULL	14118	21176

# a filtered probe input selects the keys it groups
query III
SELECT s.g,
       sum(CASE WHEN o.priority = '1-URGENT' OR o.priority = '2-HIGH' THEN 1 ELSE 0 END),
       sum(CASE WHEN o.priority <> '1-URGENT' AND o.priority <> '2-HIGH' THEN 1 ELSE 0 END)
FROM ship s JOIN orders o USING (order_id)
WHERE s.g IS NULL OR length(s.g) <> 7
GROUP BY s.g ORDER BY s.g
----
(empty)	14118	21177
