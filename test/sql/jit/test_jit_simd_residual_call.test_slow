# name: test/sql/jit/test_jit_simd_residual_call.test_slow
# description: A filter whose numeric prefix runs packed (SIMD) and whose string residual calls a helper (an IN list
# group: [jit]

#              of long, non-inlined strings): the call clobbers vector registers, and the packed loop must not compare
#              the following groups against what the helper left in them

statement ok
LOAD jit_sljit

statement ok
CREATE TABLE f AS
SELECT (DATE '1992-01-01' + (i % 2500)::INTEGER) AS d,
       ((i % 9) / 100)::DECIMAL(15,2) AS x,
       CASE WHEN i % 11 = 0 THEN NULL ELSE ((i % 9) / 100)::DECIMAL(15,2) END AS nx,
       CASE i % 4 WHEN 0 THEN 'TAKE BACK RETURN' WHEN 1 THEN 'DELIVER IN PERSON' WHEN 2 THEN 'NONE'
                  ELSE 'COLLECT COD' END AS s,
       i
FROM range(3000000) t(i)

statement ok
SET threads=4

foreach policy off auto

statement ok
SET jit_policy='{policy}'

query II nosort in_list
SELECT count(*), sum(i) FROM f
WHERE d >= DATE '1993-12-14' AND x < 0.04 AND s IN ('TAKE BACK RETURN', 'DELIVER IN PERSON', 'NONE')
----

query I nosort not_in_list
SELECT count(*) FROM f
WHERE d >= DATE '1993-12-14' AND x < 0.04 AND s NOT IN ('TAKE BACK RETURN', 'DELIVER IN PERSON', 'MAIL')
----

# a nullable prefix column keeps the validity lane bits in a vector register too
query II nosort nullable_prefix
SELECT count(*), sum(i) FROM f
WHERE d >= DATE '1993-12-14' AND nx < 0.04 AND s IN ('TAKE BACK RETURN', 'DELIVER IN PERSON', 'NONE')
----

endloop

query II
SELECT count(*), sum(i) FROM f
WHERE d >= DATE '1993-12-14' AND x < 0.04 AND s IN ('TAKE BACK RETURN', 'DELIVER IN PERSON', 'NONE')
----
714669	1072257849715
