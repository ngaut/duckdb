# name: test/sql/jit/test_jit_direct_append_stats.test
# description: JIT direct append preserves safe distinct statistics without stale mixed-append estimates
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET threads=1

statement ok
SET enable_jit=true

statement ok
SET jit_backend='auto'

statement ok
SET jit_policy='auto'

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=4096

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TEMP TABLE jit_direct_append_stats_input AS
SELECT (i % 1000)::INTEGER AS a,
       ((i * 3) % 1000)::INTEGER AS b
FROM range(10000) tbl(i)

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE TEMP TABLE jit_direct_append_stats_output AS
SELECT a + 1 AS a_plus_one,
       a - 1 AS a_minus_one,
       a AS a_ref
FROM jit_direct_append_stats_input

query I
SELECT count(*)
FROM (
    SELECT * FROM jit_direct_append_stats_output
    EXCEPT ALL
    SELECT a + 1 AS a_plus_one,
           a - 1 AS a_minus_one,
           a AS a_ref
    FROM jit_direct_append_stats_input
) diff
----
0

query III
SELECT (coalesce(plus_stats.approx_unique, 0) > 0)::INTEGER,
       (coalesce(minus_stats.approx_unique, 0) > 0)::INTEGER,
       (coalesce(ref_stats.approx_unique, 0) > 0)::INTEGER
FROM (SELECT stats(a_plus_one) plus_stats,
             stats(a_minus_one) minus_stats,
             stats(a_ref) ref_stats
      FROM jit_direct_append_stats_output
      LIMIT 1)
----
1	1	1

query I
SELECT count(*) > 0
FROM duckdb_jit_counters()
WHERE status='executed'
  AND execution_mode='native'
  AND generated_stage_runtime_breakdown LIKE '%projection.direct_materialize_fixed_fused_generated%'
  AND generated_stage_runtime_breakdown LIKE '%append_sink.direct_append_commit%'
----
1

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE TEMP TABLE jit_direct_append_stats_fused_fixed AS
SELECT a + 1 AS a_plus_one,
       b - 2 AS b_minus_two,
       a + b AS ab,
       b * 2 AS b_times_two
FROM jit_direct_append_stats_input

query I
SELECT count(*)
FROM (
    SELECT * FROM jit_direct_append_stats_fused_fixed
    EXCEPT ALL
    SELECT a + 1 AS a_plus_one,
           b - 2 AS b_minus_two,
           a + b AS ab,
           b * 2 AS b_times_two
    FROM jit_direct_append_stats_input
) diff
----
0

query I
SELECT count(*) > 0
FROM duckdb_jit_counters()
WHERE status='executed'
  AND execution_mode='native'
  AND generated_stage_runtime_breakdown LIKE '%projection.direct_materialize_fixed_fused_generated%'
  AND generated_stage_runtime_breakdown LIKE '%append_sink.direct_append_commit%'
----
1

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE TEMP TABLE jit_direct_append_stats_filtered AS
SELECT b + 1 AS b_plus_one
FROM jit_direct_append_stats_input
WHERE a < 5

query I
SELECT count(DISTINCT b_plus_one)
FROM jit_direct_append_stats_filtered
----
5

query I
SELECT (filtered_stats.approx_unique IS NULL OR filtered_stats.approx_unique < 100)::INTEGER
FROM (SELECT stats(b_plus_one) filtered_stats
      FROM jit_direct_append_stats_filtered
      LIMIT 1)
----
1

statement ok
SET enable_jit=false

statement ok
INSERT INTO jit_direct_append_stats_output
SELECT i::INTEGER AS a_plus_one,
       i::INTEGER AS a_minus_one,
       i::INTEGER AS a_ref
FROM range(100000, 110000) tbl(i)

query I
SELECT count(DISTINCT a_plus_one)
FROM jit_direct_append_stats_output
----
11000

query I
SELECT (plus_stats.approx_unique IS NULL OR plus_stats.approx_unique > 5000)::INTEGER
FROM (SELECT stats(a_plus_one) plus_stats
      FROM jit_direct_append_stats_output
      LIMIT 1)
----
1

statement ok
SET enable_jit=true

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE TEMP TABLE jit_direct_append_stats_binary AS
SELECT a + b AS ab
FROM jit_direct_append_stats_input

query I
SELECT count(*)
FROM (
    SELECT * FROM jit_direct_append_stats_binary
    EXCEPT ALL
    SELECT a + b AS ab
    FROM jit_direct_append_stats_input
) diff
----
0

query I
SELECT (coalesce(ab_stats.approx_unique, 0) > 0)::INTEGER
FROM (SELECT stats(ab) ab_stats
      FROM jit_direct_append_stats_binary
      LIMIT 1)
----
1

query I
SELECT count(*) > 0
FROM duckdb_jit_counters()
WHERE status='executed'
  AND execution_mode='native'
  AND generated_stage_runtime_breakdown LIKE '%projection.direct_materialize_fixed_generated%'
  AND generated_stage_runtime_breakdown LIKE '%append_sink.direct_append_commit%'
----
1
