# name: test/sql/jit/test_jit_typed_tree_cast_null_fast_path.test
# description: The typed-tree all-valid fast path must see NULLs produced below a cast (CASE ... ELSE NULL, NULL constants)
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET threads=1

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
CREATE TABLE t AS SELECT i AS id, (i % 5)::INTEGER AS g FROM range(20000) tbl(i)

foreach policy off auto

statement ok
SET jit_policy='{policy}'

query III
SELECT count(*), count(s), sum(s) FROM (SELECT (CASE WHEN g > 2 THEN g ELSE NULL END)::BIGINT + id AS s FROM t)
----
20000	8000	80036000

query III
SELECT count(*), count(s), sum(s) FROM (SELECT (CASE WHEN g > 2 THEN NULL ELSE g END)::BIGINT * 2 + id AS s FROM t)
----
20000	12000	120006000

statement ok
CREATE OR REPLACE TABLE r AS SELECT (CASE WHEN g > 2 THEN g ELSE NULL END)::BIGINT + id AS s FROM t

query III
SELECT count(*), count(s), sum(s) FROM r
----
20000	8000	80036000

endloop
