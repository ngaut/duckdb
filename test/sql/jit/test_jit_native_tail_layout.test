# name: test/sql/jit/test_jit_native_tail_layout.test
# description: Delegated-aggregate tails whose sink references disagree with the fed layout are refused at recipe admission
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET threads=1;

# The perfect-hash aggregate compresses its group column (CAST b AS TINYINT)
# through a projection the region graph fuses into the aggregate's compiled
# representation. A native-tail delegation hands the physical sink the raw
# probe output instead, so the sink's declared TINYINT group reference used to
# crash against the INTEGER column at >=~500k rows (the recipe is
# cardinality-dependent). Admission now proves the delegated references
# against the previous op's output layout and refuses the tail.
statement ok
CREATE TABLE facts AS SELECT (i % 100000)::INTEGER k, (i % 1000)::INTEGER a, (i % 97)::INTEGER b, i::BIGINT v FROM range(500000) tbl(i);

statement ok
CREATE TABLE dims AS SELECT i::INTEGER k, (i * 3)::BIGINT payload FROM range(100000) tbl(i);

statement ok
SET jit_policy='off';

statement ok
CREATE TABLE ref AS SELECT f.b, sum(f.v + d.payload) s FROM facts f JOIN dims d ON f.k = d.k WHERE f.a * 3 + f.b * 5 < 2000 GROUP BY f.b;

statement ok
SET jit_policy='auto';

query I
SELECT count(*) FROM (
  (SELECT f.b, sum(f.v + d.payload) s FROM facts f JOIN dims d ON f.k = d.k WHERE f.a * 3 + f.b * 5 < 2000 GROUP BY f.b
   EXCEPT SELECT * FROM ref)
  UNION ALL
  (SELECT * FROM ref
   EXCEPT SELECT f.b, sum(f.v + d.payload) s FROM facts f JOIN dims d ON f.k = d.k WHERE f.a * 3 + f.b * 5 < 2000 GROUP BY f.b)
)
----
0
