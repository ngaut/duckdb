# name: test/sql/jit/test_jit_batched_input_vector_group_keys.test
# description: Batched join-output aggregation creates groups for every compressed group-key kind the lookup admits
# group: [jit]

#              (compressed strings, substrings, integral and date keys)

statement ok
LOAD jit_sljit

statement ok
SET disabled_optimizers='join_order'

statement ok
SET jit_cbo_startup_base_cost=0

# A selective first join makes the join output sparse, so the aggregate consumes it through the batched
# input-vector path; compressed materialization stores string group keys as compressed integers.
statement ok
CREATE TABLE nation AS
SELECT i AS nk, 'NATION_' || (i % 5) AS s, (i % 7)::BIGINT AS b, DATE '1992-01-01' + ((i % 9) * 400)::INTEGER AS d
FROM range(25) t(i)

statement ok
CREATE TABLE customer AS
SELECT i * 1000 AS ck, CASE WHEN i % 97 = 0 THEN i % 25 ELSE 1000 + i % 25 END AS nk FROM range(200000) t(i)

statement ok
CREATE TABLE orders AS SELECT i AS ok, (i % 200000) * 1000 AS ck FROM range(300000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

query II
SELECT n.s, COUNT(*)
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY ALL ORDER BY 1
----
NATION_0	620
NATION_1	618
NATION_2	619
NATION_3	618
NATION_4	618

query II
SELECT substring(n.s, 1, 3), COUNT(*)
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY ALL ORDER BY 1
----
NAT	3093

query II
SELECT n.b, COUNT(*)
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY ALL ORDER BY 1
----
0	495
1	495
2	495
3	495
4	370
5	371
6	372

query II
SELECT year(n.d), COUNT(*)
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY ALL ORDER BY 1
----
1992	371
1993	374
1994	370
1995	369
1996	374
1997	370
1998	369
1999	249
2000	247

endloop
