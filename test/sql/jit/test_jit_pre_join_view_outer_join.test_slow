# name: test/sql/jit/test_jit_pre_join_view_outer_join.test_slow
# description: A projection ahead of a join (the compressed join key) is elided only for a selection probe, which reads
# group: [jit]

#              the source chunk through a view of the projection; an outer join's probe materializes its output and
#              runs the projection instead of failing to bind a selection probe

statement ok
LOAD jit_sljit

# a build side this large compresses the join key ahead of the join
statement ok
CREATE TABLE f AS SELECT i AS k, (i % 3000000)::BIGINT AS fk FROM range(4000000) t(i)

statement ok
CREATE TABLE d AS SELECT (i * 2)::BIGINT AS dk, i AS v FROM range(2000000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

# no build column is read: the probe could otherwise run on the source chunk alone
query I nosort left_join_probe_columns_{threads}
SELECT sum(f.k) FROM f LEFT JOIN d ON f.fk = d.dk
----

query I nosort left_join_count_{threads}
SELECT count(*) FROM f LEFT JOIN d ON f.fk = d.dk
----

query II nosort left_join_{threads}
SELECT sum(f.k), count(d.v) FROM f LEFT JOIN d ON f.fk = d.dk
----

query II nosort full_join_{threads}
SELECT count(*), sum(x) FROM (SELECT DISTINCT f.fk % 10 AS x FROM f FULL JOIN d ON f.fk = d.dk)
----

endloop

endloop

query II
SELECT sum(f.k), count(*) FROM f LEFT JOIN d ON f.fk = d.dk
----
7999998000000	4000000

query II
SELECT sum(f.k), count(d.v) FROM f LEFT JOIN d ON f.fk = d.dk
----
7999998000000	2000000

query II
SELECT count(*), sum(x) FROM (SELECT DISTINCT f.fk % 10 AS x FROM f FULL JOIN d ON f.fk = d.dk)
----
11	45
