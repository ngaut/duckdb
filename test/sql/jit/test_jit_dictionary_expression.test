# name: test/sql/jit/test_jit_dictionary_expression.test
# description: A compiled expression of one storage-dictionary column runs once per dictionary entry
# group: [jit]

# The compressed group key of a short string column is a compiled projection. Over a storage dictionary it runs once
# per entry and stays a dictionary over the rows' selection: with and without a filter selection, with NULL entries,
# for dictionaries larger than a vector, across row groups whose dictionaries differ, and against an in-memory copy
# whose columns are flat.

load {TEST_DIR}/jit_dictionary_expression.db

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=10000

statement ok
CREATE TABLE r AS
SELECT i::BIGINT AS id, (i * 7919 % 1000)::INTEGER AS k,
       CASE i % 9 WHEN 0 THEN NULL WHEN 1 THEN 'MAIL' WHEN 2 THEN 'SHIP' WHEN 3 THEN 'TRUCK' WHEN 4 THEN 'FOB'
                  WHEN 5 THEN 'RAIL' WHEN 6 THEN 'AIR' ELSE 'REG AIR' END AS s,
       'v' || (i * 31 % 5000)::VARCHAR AS v
FROM range(300000) t(i)

statement ok
CHECKPOINT

statement ok
CREATE TEMP TABLE r_flat AS SELECT * FROM r

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

query III
SELECT s, count(*), sum(id) FROM r WHERE k < 700 GROUP BY s ORDER BY s NULLS FIRST
----
NULL	23334	3499944111
AIR	23334	3500145090
FOB	23333	3499978790
MAIL	23334	3500178099
RAIL	23333	3499911790
REG AIR	46666	7000089222
SHIP	23334	3500112099
TRUCK	23332	3499745799

query III
SELECT s, count(*), sum(id) FROM r GROUP BY s ORDER BY s NULLS FIRST
----
NULL	33334	5000049999
AIR	33333	4999950000
FOB	33333	4999883334
MAIL	33334	5000083333
RAIL	33333	4999916667
REG AIR	66666	9999999999
SHIP	33334	5000116667
TRUCK	33333	4999850001

query III
SELECT s, count(*), sum(id) FROM r WHERE k < 10 GROUP BY s ORDER BY s NULLS FIRST
----
NULL	334	50017500
AIR	333	49919463
FOB	333	49852179
MAIL	334	50051179
RAIL	333	49885821
REG AIR	666	99936963
SHIP	334	50084858
TRUCK	333	49818537

query IIIII
SELECT count(*), sum(c), sum(h), min(v), max(v) FROM (SELECT v, count(*) AS c, sum(id) AS h FROM r WHERE k < 900 GROUP BY v)
----
4500	270000	40499835000	v0	v999

query IIIII
SELECT count(*), sum(c), sum(h), min(v), max(v) FROM (SELECT v, count(*) AS c, sum(id) AS h FROM r WHERE k < 300 GROUP BY v)
----
1500	90000	13500045000	v0	v998

query III
SELECT s, count(*), sum(id) FROM r_flat WHERE k < 700 GROUP BY s ORDER BY s NULLS FIRST
----
NULL	23334	3499944111
AIR	23334	3500145090
FOB	23333	3499978790
MAIL	23334	3500178099
RAIL	23333	3499911790
REG AIR	46666	7000089222
SHIP	23334	3500112099
TRUCK	23332	3499745799

query III
SELECT s, count(*), sum(id) FROM r_flat GROUP BY s ORDER BY s NULLS FIRST
----
NULL	33334	5000049999
AIR	33333	4999950000
FOB	33333	4999883334
MAIL	33334	5000083333
RAIL	33333	4999916667
REG AIR	66666	9999999999
SHIP	33334	5000116667
TRUCK	33333	4999850001

query III
SELECT s, count(*), sum(id) FROM r_flat WHERE k < 10 GROUP BY s ORDER BY s NULLS FIRST
----
NULL	334	50017500
AIR	333	49919463
FOB	333	49852179
MAIL	334	50051179
RAIL	333	49885821
REG AIR	666	99936963
SHIP	334	50084858
TRUCK	333	49818537

query IIIII
SELECT count(*), sum(c), sum(h), min(v), max(v) FROM (SELECT v, count(*) AS c, sum(id) AS h FROM r_flat WHERE k < 900 GROUP BY v)
----
4500	270000	40499835000	v0	v999

query IIIII
SELECT count(*), sum(c), sum(h), min(v), max(v) FROM (SELECT v, count(*) AS c, sum(id) AS h FROM r_flat WHERE k < 300 GROUP BY v)
----
1500	90000	13500045000	v0	v998

endloop

endloop

statement ok
SET threads=1

statement ok
SET jit_policy='auto'

statement ok
SET jit_trace_runtime=true

statement ok
SELECT * FROM duckdb_jit_clear_events()

query III
SELECT s, count(*), sum(id) FROM r WHERE k < 700 GROUP BY s ORDER BY s NULLS FIRST
----
NULL	23334	3499944111
AIR	23334	3500145090
FOB	23333	3499978790
MAIL	23334	3500178099
RAIL	23333	3499911790
REG AIR	46666	7000089222
SHIP	23334	3500112099
TRUCK	23332	3499745799

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%projection.dictionary_expression=%'
----
true

statement ok
SELECT * FROM duckdb_jit_clear_events()

query IIIII
SELECT count(*), sum(c), sum(h), min(v), max(v) FROM (SELECT v, count(*) AS c, sum(id) AS h FROM r WHERE k < 900 GROUP BY v)
----
4500	270000	40499835000	v0	v999

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%projection.dictionary_expression=%'
----
true
