# name: test/sql/jit/test_jit_perfect_hash_nullable_inputs.test
# description: Perfect-hash aggregates over flat chunks with NULL payloads and NULL group keys: a group whose payloads
# group: [jit]

#              are all NULL keeps NULL sums, and NULL keys form their own group

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_measure_native_legs=false

statement ok
CREATE TABLE facts AS
SELECT (i % 97)::INTEGER AS g, CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 50)::INTEGER END AS gn,
       CASE WHEN i % 7 = 0 OR i % 97 = 5 THEN NULL ELSE i % 10007 END AS n,
       CASE WHEN i % 11 = 0 THEN NULL ELSE (i % 1000)::DOUBLE / 4 END AS d,
       CASE WHEN i % 3 = 0 THEN NULL ELSE i::HUGEINT * 1000000000000 END AS h
FROM range(300000) tbl(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
CREATE OR REPLACE TABLE r_{policy} AS
SELECT 'sum' AS q, g AS k, sum(n)::HUGEINT AS a, 0::HUGEINT AS b, 0::DOUBLE AS c FROM facts GROUP BY g
UNION ALL
SELECT 'sum_count', g, sum(n), count(n), 0 FROM facts GROUP BY g
UNION ALL
SELECT 'double', g, count(d), 0, sum(d) FROM facts GROUP BY g
UNION ALL
SELECT 'hugeint', g, sum(h), count(h), 0 FROM facts GROUP BY g
UNION ALL
SELECT 'null_keys', gn, sum(n), count(n), 0 FROM facts GROUP BY gn
UNION ALL
SELECT 'computed_key', n % 5, sum(n), count(*), 0 FROM facts GROUP BY n % 5

endloop

query I
SELECT count(*) FROM ((SELECT * FROM r_off EXCEPT ALL SELECT * FROM r_auto)
                      UNION ALL (SELECT * FROM r_auto EXCEPT ALL SELECT * FROM r_off))
----
0

# group 5 has only NULL payloads
query II
SELECT a IS NULL, b FROM r_auto WHERE q = 'sum_count' AND k = 5
----
true	0

endloop
