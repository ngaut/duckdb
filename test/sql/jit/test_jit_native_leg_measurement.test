# name: test/sql/jit/test_jit_native_leg_measurement.test
# description: An ungrouped or perfect-hash aggregate region measures its first chunks against DuckDB's operators and
# group: [jit]

#              keeps the faster; the chunks of both legs reach one sink, whose states add up whichever way it decides.

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=100000

statement ok
CREATE TABLE facts AS
SELECT i AS id, (i % 97)::INTEGER AS g, CASE WHEN i % 13 = 0 THEN NULL ELSE i % 10007 END AS n,
       (i % 100000)::DECIMAL(15,2) AS price, (i % 127)::TINYINT AS ti, (i % 30000)::SMALLINT AS si,
       ['AIR','MAIL','SHIP','RAIL'][(i % 4) + 1] AS mode
FROM range(400000) tbl(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
CREATE OR REPLACE TABLE r_{policy} AS
SELECT 'mixed' AS q, sum(id * 3)::HUGEINT AS a, count(n)::HUGEINT AS b, min(price)::HUGEINT AS c, max(si)::HUGEINT AS d
FROM facts
UNION ALL
SELECT 'narrow', sum(ti::INTEGER * si)::HUGEINT, count(*)::HUGEINT, 0, 0 FROM facts
UNION ALL
SELECT 'case', sum(CASE WHEN mode = 'AIR' THEN id ELSE 0 END)::HUGEINT, sum(price)::HUGEINT, 0, 0 FROM facts
UNION ALL
SELECT 'filtered', sum(id + g)::HUGEINT, count(*)::HUGEINT, 0, 0 FROM facts WHERE g < 50
UNION ALL
SELECT 'avg', (avg(price) * 100)::HUGEINT, 0, 0, 0 FROM facts

statement ok
CREATE OR REPLACE TABLE p_{policy} AS
SELECT g, sum(id)::HUGEINT AS a, count(n) AS b, min(price) AS c, max(si) AS d, sum(n) AS e
FROM facts GROUP BY g

endloop

query I
SELECT count(*) FROM ((SELECT * FROM r_off EXCEPT ALL SELECT * FROM r_auto)
                      UNION ALL (SELECT * FROM r_auto EXCEPT ALL SELECT * FROM r_off))
----
0

query I
SELECT count(*) FROM ((SELECT * FROM p_off EXCEPT ALL SELECT * FROM p_auto)
                      UNION ALL (SELECT * FROM p_auto EXCEPT ALL SELECT * FROM p_off))
----
0

endloop

# the measurement ran and decided, one way or the other
query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%native_leg_measurement.%'
----
true

# an order-dependent aggregate never alternates
statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
SET threads=1

statement ok
SELECT first(id) FROM (SELECT id FROM facts WHERE g < 50)

query I
SELECT count(*) FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%native_leg_measurement.%'
----
0
