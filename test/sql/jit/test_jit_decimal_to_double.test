# name: test/sql/jit/test_jit_decimal_to_double.test
# description: A decimal converts to DOUBLE exactly as DuckDB casts it: beyond 2^53 the correctly rounded decimal
# group: [jit]

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

# raw values beyond 2^53, where `raw / 10^scale` and the correctly rounded conversion part ways, built from exact
# decimal literals
statement ok
CREATE TABLE d AS
SELECT (i % 97)::BIGINT AS k,
       CAST(CASE WHEN i % 2 = 0 THEN '' ELSE '-' END || (90071992547409 + i * 7919)::VARCHAR || '.' ||
            lpad(((i * 37) % 100)::VARCHAR, 2, '0') AS DECIMAL(18,2)) AS d64,
       CAST((92233720368547 - i * 104729)::VARCHAR || '.' || lpad(((i * 7) % 10000)::VARCHAR, 4, '0')
            AS DECIMAL(18,4)) AS d64b,
       CAST(CASE WHEN i % 3 = 0 THEN '-' ELSE '' END || (123456789012345678 + i * 1000000007)::VARCHAR || '.' ||
            lpad(((i * 7919) % 1000000)::VARCHAR, 6, '0') AS DECIMAL(38,6)) AS d128,
       CAST((100000 + i)::VARCHAR || '.' || lpad(((i * 7919) % 10000000)::VARCHAR, 25, '0') AS DECIMAL(38,25))
            AS d128s
FROM range(20000) tbl(i)

query IIII
SELECT typeof(d64), typeof(d64b), typeof(d128), typeof(d128s) FROM d LIMIT 1
----
DECIMAL(18,2)	DECIMAL(18,4)	DECIMAL(38,6)	DECIMAL(38,25)

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
CREATE OR REPLACE TABLE r_{policy} AS
SELECT 'key64' AS q, count(*)::BIGINT AS n, sum(hash(a, b))::HUGEINT AS h
FROM (SELECT d64 / 7 AS a, count(*) AS b FROM d GROUP BY ALL)
UNION ALL
SELECT 'key128', count(*), sum(hash(a, b))
FROM (SELECT d128 / 3 AS a, count(*) AS b FROM d GROUP BY ALL)
UNION ALL
SELECT 'sum64', count(*), sum(hash(a, b))
FROM (SELECT k AS a, sum(d64 * 3.0) AS b FROM d GROUP BY ALL)
UNION ALL
SELECT 'sum128', count(*), sum(hash(a, b))
FROM (SELECT k AS a, sum(d128::DOUBLE / 11) AS b FROM d GROUP BY ALL)
UNION ALL
SELECT 'scale25', count(*), sum(hash(a, b))
FROM (SELECT k AS a, sum(d128s::DOUBLE * 2) AS b FROM d GROUP BY ALL)
UNION ALL
SELECT 'refs', count(*), sum(hash(a, b))
FROM (SELECT k AS a, sum(d64::DOUBLE + d128::DOUBLE) AS b FROM d GROUP BY ALL)
UNION ALL
SELECT 'refs64', count(*), sum(hash(a, b))
FROM (SELECT k AS a, sum(d64::DOUBLE - d64b::DOUBLE) AS b FROM d GROUP BY ALL)
UNION ALL
SELECT 'cmpconst', count(*), sum(hash(k))
FROM d WHERE d64::DOUBLE > 90071992547.4
UNION ALL
SELECT 'cmpconst128', count(*), sum(hash(k))
FROM d WHERE d128::DOUBLE < 123456789012345678.95
UNION ALL
SELECT 'cmprefs', count(*), sum(hash(k))
FROM d WHERE d64::DOUBLE < d64b::DOUBLE
UNION ALL
SELECT 'cast', count(*), sum(hash(a))
FROM (SELECT d64::DOUBLE AS a FROM d)

endloop

query I
SELECT count(*) FROM ((SELECT * FROM r_off EXCEPT ALL SELECT * FROM r_auto)
                      UNION ALL (SELECT * FROM r_auto EXCEPT ALL SELECT * FROM r_off))
----
0

# a grouped payload whose aggregate the region leaves to DuckDB's sink converts its decimal operand in the region's
# projection: beyond 2^53 that conversion is DuckDB's exact one too
statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=10000

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET threads=1

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
CREATE OR REPLACE TABLE p_{policy} AS
SELECT k AS a, sum(d64 * (1 - k::DOUBLE / 100)) AS b, avg(d64) AS c FROM d GROUP BY ALL

endloop

query I
SELECT count(*) FROM ((SELECT * FROM p_off EXCEPT ALL SELECT * FROM p_auto)
                      UNION ALL (SELECT * FROM p_auto EXCEPT ALL SELECT * FROM p_off))
----
0

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%aggregate_update.native_tail_delegation=%'
----
true
