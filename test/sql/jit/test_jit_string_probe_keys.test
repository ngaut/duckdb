# name: test/sql/jit/test_jit_string_probe_keys.test
# description: Hash joins on VARCHAR keys compile to the generated probe, which hashes and compares string keys as
#              DuckDB does: inlined strings of every inline length, long strings that share their length and prefix,
#              NULL keys, duplicate build keys and multi-column keys all match the vectorized join
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_trace_decisions=true

statement ok
SET jit_event_log_size=100000

# Keys of every inline length (0, 1-4, 5-8, 9-12) and long keys; the long keys of one family share their length and
# their four-byte prefix, so they differ only past the prefix
statement ok
CREATE TABLE probe AS
SELECT i::BIGINT AS id, (i % 13)::INTEGER AS g,
       CASE i % 8
           WHEN 0 THEN ''
           WHEN 1 THEN 'k' || (i % 61)
           WHEN 2 THEN 'key' || (i % 523)
           WHEN 3 THEN 'twelve' || lpad(((i * 7) % 999)::VARCHAR, 6, '0')
           WHEN 4 THEN 'a-long-shared-prefix-' || lpad((i % 701)::VARCHAR, 5, '0')
           WHEN 5 THEN NULL
           WHEN 6 THEN 'a-long-shared-prefix-' || lpad((i % 701)::VARCHAR, 5, '0') || 'x'
           ELSE 'nine-char' END AS s,
       CASE WHEN i % 5 = 0 THEN NULL ELSE 'x' || (i % 5000) END AS t
FROM range(400000) t(i)

statement ok
CREATE TABLE build AS
SELECT (i % 11)::INTEGER AS w, (i % 13)::INTEGER AS g,
       CASE i % 7
           WHEN 0 THEN CASE WHEN i < 70 THEN '' ELSE 'e' || i END
           WHEN 1 THEN 'k' || (i % 31)
           WHEN 2 THEN 'key' || (i % 301)
           WHEN 3 THEN 'twelve' || lpad((i % 600)::VARCHAR, 6, '0')
           WHEN 4 THEN 'a-long-shared-prefix-' || lpad((i % 350)::VARCHAR, 5, '0')
           WHEN 5 THEN NULL
           ELSE CASE WHEN i < 140 THEN 'nine-char' ELSE 'n' || i END END AS s,
       CASE WHEN i < 3 THEN NULL ELSE 'x' || (i % 4000) END AS t
FROM range(20000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT 'inner' AS q, count(*) AS n, sum(id) AS si, sum(w) AS sw FROM probe p JOIN build b ON p.s = b.s
UNION ALL
SELECT 'semi', count(*), sum(id), NULL FROM probe p SEMI JOIN build b ON p.s = b.s
UNION ALL
SELECT 'anti', count(*), sum(id), NULL FROM probe p ANTI JOIN build b ON p.s = b.s
UNION ALL
SELECT 'pair', count(*), sum(id), sum(w) FROM probe p JOIN build b ON p.s = b.s AND p.g = b.g
UNION ALL
SELECT 'two_strings', count(*), sum(id), sum(w) FROM probe p JOIN build b ON p.s = b.s AND p.t = b.t
UNION ALL
SELECT 'not_distinct', count(*), sum(id), sum(w) FROM probe p JOIN build b ON p.t IS NOT DISTINCT FROM b.t
UNION ALL
SELECT 'mark_in', count(*), sum(id), NULL FROM probe p WHERE p.s IN (SELECT s FROM build) OR p.g = 3
UNION ALL
SELECT 'mark_not_in', count(*), sum(id), NULL FROM probe p WHERE p.t NOT IN (SELECT t FROM build WHERE t IS NOT NULL)
UNION ALL
SELECT 'in_list', count(*), sum(id), NULL FROM probe p
WHERE substring(p.s, 1, 3) IN ('k1', 'key', 'twe', 'a-l', 'nin', '', 'zzz')
UNION ALL
SELECT 'expression_key', count(*), sum(id), sum(w) FROM probe p JOIN build b ON p.s || '!' = b.s || '!'

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT 'inner' AS q, count(*) AS n, sum(id) AS si, sum(w) AS sw FROM probe p JOIN build b ON p.s = b.s
UNION ALL
SELECT 'semi', count(*), sum(id), NULL FROM probe p SEMI JOIN build b ON p.s = b.s
UNION ALL
SELECT 'anti', count(*), sum(id), NULL FROM probe p ANTI JOIN build b ON p.s = b.s
UNION ALL
SELECT 'pair', count(*), sum(id), sum(w) FROM probe p JOIN build b ON p.s = b.s AND p.g = b.g
UNION ALL
SELECT 'two_strings', count(*), sum(id), sum(w) FROM probe p JOIN build b ON p.s = b.s AND p.t = b.t
UNION ALL
SELECT 'not_distinct', count(*), sum(id), sum(w) FROM probe p JOIN build b ON p.t IS NOT DISTINCT FROM b.t
UNION ALL
SELECT 'mark_in', count(*), sum(id), NULL FROM probe p WHERE p.s IN (SELECT s FROM build) OR p.g = 3
UNION ALL
SELECT 'mark_not_in', count(*), sum(id), NULL FROM probe p WHERE p.t NOT IN (SELECT t FROM build WHERE t IS NOT NULL)
UNION ALL
SELECT 'in_list', count(*), sum(id), NULL FROM probe p
WHERE substring(p.s, 1, 3) IN ('k1', 'key', 'twe', 'a-l', 'nin', '', 'zzz')
UNION ALL
SELECT 'expression_key', count(*), sum(id), sum(w) FROM probe p JOIN build b ON p.s || '!' = b.s || '!'

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

endloop

# Each probe key below shares the hash slot and salt of a different build key, so the probe reaches that build row
# and must reject it by comparing the keys: inline keys that differ only past their prefix or only in it, long keys of
# one length and prefix, and keys of different lengths
statement ok
CREATE TABLE collision_build AS
SELECT * FROM (VALUES ('coll00003324'), ('coll00007459'), ('aacysametail'), ('collision-long-0000430'),
                      ('collision-long-0001226'), ('p101273'), ('p10283')) t(s)

statement ok
CREATE TABLE collision_probe AS
SELECT i AS id, (['coll00003324', 'coll00506507', 'coll00007459', 'coll00080467', 'aacysametail', 'ktxxsametail',
                  'collision-long-0000430', 'collision-long-0115131', 'collision-long-0001226',
                  'collision-long-0219303', 'p101273', 'p85667', 'p10283', 'p344206'])[i % 14 + 1] AS s
FROM range(140000) t(i)

query I
SELECT count(*) FROM (SELECT hash(s) & 16383 AS slot, hash(s) >> 48 AS salt FROM collision_probe GROUP BY s)
GROUP BY slot, salt HAVING count(*) <> 2
----

# With both keys of every pair in the build, a probe key passes its colliding twin before reaching its own row; the
# integer key ahead of the string key keeps a hash live across the long-string hash call
statement ok
CREATE TABLE collision_build_both AS SELECT DISTINCT (id % 14)::INTEGER AS k, s FROM collision_probe

foreach threads 1 4

statement ok
SET threads={threads}

query II
SELECT p.s, count(*) FROM collision_probe p JOIN collision_build b ON p.s = b.s GROUP BY ALL ORDER BY ALL
----
aacysametail	10000
coll00003324	10000
coll00007459	10000
collision-long-0000430	10000
collision-long-0001226	10000
p101273	10000
p10283	10000

query I
SELECT count(*) FROM collision_probe p WHERE p.s NOT IN (SELECT s FROM collision_build)
----
70000

query II
SELECT p.s, count(*) FROM collision_probe p JOIN collision_build_both b ON p.s = b.s GROUP BY ALL ORDER BY ALL
----
aacysametail	10000
coll00003324	10000
coll00007459	10000
coll00080467	10000
coll00506507	10000
collision-long-0000430	10000
collision-long-0001226	10000
collision-long-0115131	10000
collision-long-0219303	10000
ktxxsametail	10000
p101273	10000
p10283	10000
p344206	10000
p85667	10000

query II
SELECT count(*), sum(p.id) FROM collision_probe p JOIN collision_build_both b ON (p.id % 7)::INTEGER = b.k AND p.s = b.s
----
70000	4899720000

query II
SELECT count(*), sum(id) FROM collision_probe p SEMI JOIN collision_build_both b ON p.s = b.s
----
140000	9799930000

query II
SELECT count(*), sum(id) FROM collision_probe p ANTI JOIN collision_build_both b ON p.s = b.s
----
0	NULL

query II
SELECT count(*), sum(id) FROM collision_probe p WHERE p.s NOT IN (SELECT s FROM collision_build_both)
----
0	NULL

endloop

# The string-keyed probes compile instead of stopping at an unsupported key type
statement ok
SET threads=1

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS SELECT count(*) AS n FROM probe p JOIN build b ON p.s = b.s

statement ok
CREATE OR REPLACE TABLE actual AS SELECT count(*) AS n FROM probe p
WHERE substring(p.s, 1, 3) IN ('k1', 'key', 'twe', 'a-l', 'nin', '', 'zzz')

query I
SELECT count(*) FROM duckdb_jit_events() WHERE phase = 'compile' AND status = 'compiled'
----
2

query I
SELECT count(*) FROM duckdb_jit_events() WHERE reason LIKE '%unsupported key type VARCHAR%'
----
0
