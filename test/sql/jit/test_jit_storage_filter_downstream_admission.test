# name: test/sql/jit/test_jit_storage_filter_downstream_admission.test
# description: Scan-owned string predicates do not veto generated work downstream
# group: [jit]

require jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_trace_decisions=true

statement ok
SET jit_event_log_size=10000

statement ok
ATTACH ':memory:' AS uncompressed

statement ok
ATTACH '{TEST_DIR}/jit_storage_filter_downstream.db' AS checkpointed

foreach storage uncompressed checkpointed

statement ok
USE {storage}

foreach domain 2 150 5000

statement ok
CREATE OR REPLACE TABLE inputs AS
SELECT i AS id, CASE WHEN i % 997 = 0 THEN NULL
                    ELSE 'category-kind-' || lpad(CAST(i % {domain} AS VARCHAR), 5, '0') END AS category,
       (i % 100)::INTEGER AS amount
FROM range(50000) t(i)

statement ok
CHECKPOINT

foreach threads 1 4

statement ok
SET threads={threads}

foreach predicate like contains

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
SELECT * FROM duckdb_jit_clear_events()

query II nosort source_admission
SELECT sum(id * 3 + amount), count(*) FROM inputs
WHERE CASE WHEN '{predicate}' = 'like' THEN category LIKE '%kind%1%'
           ELSE contains(category, '1') END
  AND amount > 40
----

endloop

reset label source_admission

query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE phase = 'compile'
----
true

query I
SELECT count(*) FROM duckdb_jit_events()
WHERE reason LIKE '%rejected_vectorized_execution_preferred%'
----
0

endloop

endloop

endloop

endloop
