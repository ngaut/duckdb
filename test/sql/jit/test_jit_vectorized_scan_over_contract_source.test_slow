# name: test/sql/jit/test_jit_vectorized_scan_over_contract_source.test_slow
# description: A table scan opened for a compiled region's source contract but read by the vectorized loop (the
# group: [jit]

#              compiled entry deferred, or the vectorized-baseline trace) reports the batch of the rows it returned, so
#              order-preserving sinks get one collection per batch and keep insertion order

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=10000

statement ok
CREATE TABLE t AS SELECT i::BIGINT AS i FROM range(3000000) tbl(i)

statement ok
SET threads=4

foreach mode jit_debug_force_entry_defer jit_trace_vectorized_baseline

statement ok
SET {mode}=true

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE o AS SELECT i * 3 + 1 AS v FROM t WHERE (i // 2048) % 2 = 0 OR i % 97 = 0

statement ok
INSERT INTO o SELECT i * 3 + 9000001 FROM t WHERE (i // 2048) % 2 = 1 AND i % 89 = 0

query III
SELECT count(*), sum(v), count(*) FILTER (WHERE prev >= v) FROM (SELECT v, lag(v) OVER (ORDER BY rowid) AS prev FROM o)
----
1533163	7050128084458	0

statement ok
RESET {mode}

endloop

# the first mode really deferred every compiled entry
statement ok
SET jit_debug_force_entry_defer=true

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE o AS SELECT i * 3 + 1 AS v FROM t WHERE (i // 2048) % 2 = 0 OR i % 97 = 0

query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE reason LIKE 'full pipeline kernel deferred%'
----
true
