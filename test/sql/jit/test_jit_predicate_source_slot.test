# name: test/sql/jit/test_jit_predicate_source_slot.test
# description: A predicate names its sources by their slot in the filter's input sources; the flat all-valid fast
#              paths read the input column of that slot, not the column numbered like the slot. A filter over the
#              build column of a LEFT join (a FULL join narrowed by a filter) reads only input column 1, from slot 0
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TABLE ps AS SELECT (i % 20000)::BIGINT AS pk, (i // 20000)::BIGINT AS sk FROM range(80000) t(i)

statement ok
CREATE TABLE pt AS SELECT i::BIGINT AS pk, (i % 50 + 1)::INTEGER AS sz, (i % 7)::INTEGER AS w FROM range(20000) t(i)

foreach threads 1 4

statement ok
SET threads=${threads}

foreach policy off auto

statement ok
SET jit_policy='${policy}'

query II nosort between_build_column_${threads}
SELECT count(*), sum(ps.pk) FROM ps FULL JOIN pt ON ps.pk = pt.pk WHERE ps.pk IS NOT NULL AND pt.sz BETWEEN 1 AND 13
----

query II nosort compare_build_columns_${threads}
SELECT count(*), sum(ps.pk) FROM ps FULL JOIN pt ON ps.pk = pt.pk WHERE ps.pk IS NOT NULL AND pt.sz > pt.w
----

endloop

endloop

query II
SELECT count(*), sum(ps.pk) FROM ps FULL JOIN pt ON ps.pk = pt.pk WHERE ps.pk IS NOT NULL AND pt.sz BETWEEN 1 AND 13
----
20800	207604800
