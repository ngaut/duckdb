# name: test/sql/jit/test_jit_mark_filter_prefix_aggregate.test
# description: A MARK probe's marker filter fuses into the probe behind a source filter or a computed probe key, and
# group: [jit]

#              an ungrouped aggregate reads the kept rows directly; every IN / NOT IN shape matches the vectorized plan,
#              including NULL probe keys and NULL build values. String projections hand their chunks on unbatched.

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=100000

statement ok
CREATE TABLE probe AS
SELECT i::BIGINT AS id, (i % 1000)::DECIMAL(15, 2) - 100 AS amount,
       CASE WHEN i % 17 = 0 THEN NULL ELSE lpad((i % 41)::VARCHAR, 2, '0') || '-' || (i % 977) END AS phone,
       CASE WHEN i % 23 = 0 THEN NULL ELSE (i % 53)::INTEGER END AS code
FROM range(500000) t(i)

statement ok
CREATE TABLE codes AS SELECT (i * 3)::INTEGER AS code FROM range(9) t(i)

statement ok
CREATE TABLE codes_with_null AS SELECT * FROM codes UNION ALL SELECT NULL

foreach threads 1 4

statement ok
SET threads={threads}

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT 'filter_in_list' AS q, count(*) AS n, sum(amount) AS total FROM probe
WHERE amount > 0 AND substring(phone, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')
UNION ALL
SELECT 'in_list', count(*), sum(amount) FROM probe
WHERE substring(phone, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')
UNION ALL
SELECT 'filter_not_in_list', count(*), sum(amount) FROM probe
WHERE amount > 0 AND substring(phone, 1, 2) NOT IN ('13', '31', '23', '29', '30', '18', '17')
UNION ALL
SELECT 'filter_in_subquery', count(*), sum(amount) FROM probe WHERE amount < 500 AND code IN (SELECT code FROM codes)
UNION ALL
SELECT 'filter_not_in_subquery', count(*), sum(amount) FROM probe
WHERE amount < 500 AND code NOT IN (SELECT code FROM codes)
UNION ALL
SELECT 'filter_not_in_null_subquery', count(*), sum(amount) FROM probe
WHERE amount < 500 AND code NOT IN (SELECT code FROM codes_with_null)
UNION ALL
SELECT 'key_in_subquery', count(*), sum(amount) FROM probe WHERE code + 1 IN (SELECT code FROM codes)
UNION ALL
SELECT 'filter_in_empty', count(*), sum(amount) FROM probe
WHERE amount < 500 AND code IN (SELECT code FROM codes WHERE code < 0)
UNION ALL
SELECT 'filter_not_in_empty', count(*), sum(amount) FROM probe
WHERE amount < 500 AND code NOT IN (SELECT code FROM codes WHERE code < 0)
UNION ALL
SELECT 'filter_projection', count(*), sum(amount * 2 + id) FROM probe
WHERE amount > 0 AND substring(phone, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')
UNION ALL
SELECT 'filter_grouped_' || substring(phone, 1, 2), count(*), sum(amount) FROM probe
WHERE amount > 0 AND substring(phone, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')
GROUP BY substring(phone, 1, 2)

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT 'filter_in_list' AS q, count(*) AS n, sum(amount) AS total FROM probe
WHERE amount > 0 AND substring(phone, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')
UNION ALL
SELECT 'in_list', count(*), sum(amount) FROM probe
WHERE substring(phone, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')
UNION ALL
SELECT 'filter_not_in_list', count(*), sum(amount) FROM probe
WHERE amount > 0 AND substring(phone, 1, 2) NOT IN ('13', '31', '23', '29', '30', '18', '17')
UNION ALL
SELECT 'filter_in_subquery', count(*), sum(amount) FROM probe WHERE amount < 500 AND code IN (SELECT code FROM codes)
UNION ALL
SELECT 'filter_not_in_subquery', count(*), sum(amount) FROM probe
WHERE amount < 500 AND code NOT IN (SELECT code FROM codes)
UNION ALL
SELECT 'filter_not_in_null_subquery', count(*), sum(amount) FROM probe
WHERE amount < 500 AND code NOT IN (SELECT code FROM codes_with_null)
UNION ALL
SELECT 'key_in_subquery', count(*), sum(amount) FROM probe WHERE code + 1 IN (SELECT code FROM codes)
UNION ALL
SELECT 'filter_in_empty', count(*), sum(amount) FROM probe
WHERE amount < 500 AND code IN (SELECT code FROM codes WHERE code < 0)
UNION ALL
SELECT 'filter_not_in_empty', count(*), sum(amount) FROM probe
WHERE amount < 500 AND code NOT IN (SELECT code FROM codes WHERE code < 0)
UNION ALL
SELECT 'filter_projection', count(*), sum(amount * 2 + id) FROM probe
WHERE amount > 0 AND substring(phone, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')
UNION ALL
SELECT 'filter_grouped_' || substring(phone, 1, 2), count(*), sum(amount) FROM probe
WHERE amount > 0 AND substring(phone, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')
GROUP BY substring(phone, 1, 2)

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

endloop

# Behind the source filter, the probe emits the marker filter's selection and the aggregate reads it directly
statement ok
SET threads=1

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS SELECT count(*) AS n, sum(amount) AS total FROM probe
WHERE amount > 0 AND substring(phone, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')

query I
SELECT count(*) FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%filter.mark_probe_match_materialized%'
----
1

# Chunks run from mostly filtered out to kept whole and back: a string projection hands every chunk straight to the
# sink instead of batching (copying) its rows, and the sink still receives them in scan order
statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE ordered_expected AS SELECT id, substring(phone, 1, 5) AS tagged FROM probe
WHERE (id >= 100000 AND id < 200000) OR id % 101 = 0 OR amount < -1000

statement ok
SET jit_policy='auto'

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE ordered AS SELECT id, substring(phone, 1, 5) AS tagged FROM probe
WHERE (id >= 100000 AND id < 200000) OR id % 101 = 0 OR amount < -1000

query I
SELECT count(*) FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%append_sink.native_tail_delegation%'
----
1

query I
SELECT count(*) FROM (SELECT id, lag(id) OVER (ORDER BY rowid) AS previous FROM ordered) WHERE previous >= id
----
0

query I
SELECT count(*) FROM ((SELECT * FROM ordered_expected EXCEPT ALL SELECT * FROM ordered)
                      UNION ALL (SELECT * FROM ordered EXCEPT ALL SELECT * FROM ordered_expected))
----
0
