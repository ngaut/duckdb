# name: test/sql/jit/test_jit_artifact_cache_contract.test
# description: Shared compiled artifacts are keyed on the operator and sink contracts they bake in: a plan
#              whose perfect-hash group minima and bit widths differ (here: re-planned from serialized
#              statistics) compiles its own artifact instead of reusing one built for another contract
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET threads=4

statement ok
SET debug_force_external=true

statement ok
CREATE TABLE mode_rewrite(g INTEGER, v VARCHAR);

statement ok
INSERT INTO mode_rewrite VALUES
	(1, 'b'), (1, 'a'), (1, 'a'), (1, 'b'), (1, 'a'), (2, 'z'), (2, 'y'), (3, NULL), (3, 'q');

# the plain plan compiles first, then the re-planned one with different group statistics
query TR
SELECT mode(v), round(entropy(v), 6) FROM mode_rewrite WHERE g = 1
----
a	0.970951

statement ok
SET debug_verify_serializer=true

query TR
SELECT mode(v), round(entropy(v), 6) FROM mode_rewrite WHERE g = 1
----
a	0.970951

# and the other way around: an artifact sized for the wider table must not run against the narrower one
statement ok
SET debug_verify_serializer=false

query TR
SELECT mode(v), round(entropy(v), 6) FROM mode_rewrite WHERE g = 2
----
y	1.0

statement ok
SET debug_verify_serializer=true

query TR
SELECT mode(v), round(entropy(v), 6) FROM mode_rewrite WHERE g = 2
----
y	1.0

statement ok
SET debug_verify_serializer=false

query TR
SELECT mode(v), round(entropy(v), 6) FROM mode_rewrite WHERE g = 1
----
a	0.970951
