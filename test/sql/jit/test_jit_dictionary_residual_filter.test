# name: test/sql/jit/test_jit_dictionary_residual_filter.test
# description: A filter residual that reads one dictionary-compressed column is looked up per dictionary entry
# group: [jit]

# The packed SIMD prefix (d >= 10 AND d < 90) passes rows on to a residual over one string column. A chunk whose
# column arrives as a small dictionary evaluates the residual once per dictionary entry; NULL entries, entries too long
# to inline, and columns without such a dictionary (the in-memory copy, a high-cardinality column) must give DuckDB's
# rows.

load {TEST_DIR}/jit_dictionary_residual_filter.db

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=10000

statement ok
CREATE TABLE r AS
SELECT i::BIGINT AS id,
       (i % 100)::INTEGER AS d,
       CASE i % 9 WHEN 0 THEN NULL WHEN 1 THEN 'MAIL' WHEN 2 THEN 'SHIP' WHEN 3 THEN 'TRUCK'
                  WHEN 4 THEN 'a dictionary entry longer than twelve bytes' WHEN 5 THEN 'RAIL'
                  WHEN 6 THEN 'AIR' ELSE 'REG AIR' END AS s,
       'value_' || (i * 7919 % 1000003)::VARCHAR AS hs
FROM range(250000) t(i)

statement ok
CHECKPOINT

statement ok
CREATE TEMP TABLE r_flat AS SELECT * FROM r

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

# string residuals over a dictionary-compressed column
query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND s IN ('MAIL', 'SHIP')
----
44444	2200032	5555561232

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND s = 'TRUCK'
----
22222	1099989	2777738889

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND s <> 'MAIL'
----
155556	7699932	19444283132

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND s NOT IN ('MAIL', 'RAIL')
----
133334	6599979	16666599879

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND s IS NULL
----
22222	1100043	2777822343

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND s IS NOT NULL
----
177778	8799957	22222077657

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND s LIKE 'a dictionary%'
----
22222	1099971	2777711071

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND s = 'a dictionary entry longer than twelve bytes'
----
22222	1099971	2777711071

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND s > 'RAIL'
----
111112	5500044	13888944444

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND NOT (s = 'MAIL')
----
155556	7699932	19444283132

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND (s = 'AIR' OR s LIKE '%AIR')
----
66668	3300012	8333383212

# a high-cardinality column stays row by row
query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND hs LIKE '%77'
----
1994	98719	249191019

# string residuals over a dictionary-compressed column
query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND s IN ('MAIL', 'SHIP')
----
44444	2200032	5555561232

query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND s = 'TRUCK'
----
22222	1099989	2777738889

query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND s <> 'MAIL'
----
155556	7699932	19444283132

query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND s NOT IN ('MAIL', 'RAIL')
----
133334	6599979	16666599879

query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND s IS NULL
----
22222	1100043	2777822343

query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND s IS NOT NULL
----
177778	8799957	22222077657

query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND s LIKE 'a dictionary%'
----
22222	1099971	2777711071

query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND s = 'a dictionary entry longer than twelve bytes'
----
22222	1099971	2777711071

query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND s > 'RAIL'
----
111112	5500044	13888944444

query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND NOT (s = 'MAIL')
----
155556	7699932	19444283132

query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND (s = 'AIR' OR s LIKE '%AIR')
----
66668	3300012	8333383212

# a high-cardinality column stays row by row
query III
SELECT count(*), sum(d), sum(id) FROM r_flat WHERE d >= 10 AND d < 90 AND hs LIKE '%77'
----
1994	98719	249191019

endloop

endloop

# the residual runs behind a packed prefix
statement ok
SET threads=1

statement ok
SET jit_trace_runtime=true

statement ok
SELECT * FROM duckdb_jit_clear_events()

query III
SELECT count(*), sum(d), sum(id) FROM r WHERE d >= 10 AND d < 90 AND s IN ('MAIL', 'SHIP')
----
44444	2200032	5555561232

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%selection.partial_simd=%'
----
true
