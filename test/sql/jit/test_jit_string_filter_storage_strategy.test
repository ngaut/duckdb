# name: test/sql/jit/test_jit_string_filter_storage_strategy.test
# description: A source with a low-cardinality string filter, or a search over a string column that repeats its
# group: [jit]

#              values, leaves its filters to compressed storage

# Compressed storage evaluates a string filter against the column's dictionary and fetches the other columns only for
# the rows that pass, so a checkpointed table keeps the filter in the scan, also beside a numeric filter a generated
# filter would read row by row. An uncompressed in-memory table, a source whose generated filter masks rows with packed
# numeric comparisons before the string filter, and a source whose dynamic join filter discards rows keep generated
# filters.

load {TEST_DIR}/jit_string_filter_storage.db

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_trace_decisions=true

statement ok
SET jit_event_log_size=10000

statement ok
SET threads=1

statement ok
CREATE TABLE orders AS
SELECT i::BIGINT AS order_id,
       CASE i % 5 WHEN 0 THEN '1-URGENT' WHEN 1 THEN '2-HIGH' WHEN 2 THEN '3-MEDIUM' ELSE '4-NOT SPECIFIED' END AS priority
FROM range(150000) t(i)

statement ok
CREATE TABLE ship AS
SELECT (i % 150000)::BIGINT AS order_id,
       CASE i % 3 WHEN 0 THEN 'MAIL' WHEN 1 THEN 'SHIP' ELSE 'RAIL' END AS ship_mode,
       (i % 1000)::INTEGER AS weight
FROM range(600000) t(i)

statement ok
CREATE TABLE parcels AS
SELECT i::BIGINT AS order_id, (i % 365)::INTEGER AS day, (i % 1000)::INTEGER AS weight,
       CASE i % 3 WHEN 0 THEN 'MAIL' WHEN 1 THEN 'SHIP' ELSE 'RAIL' END AS ship_mode
FROM range(600000) t(i)

statement ok
CHECKPOINT

statement ok
SELECT * FROM duckdb_jit_clear_events()

query III
SELECT s.ship_mode,
       sum(CASE WHEN o.priority = '1-URGENT' OR o.priority = '2-HIGH' THEN 1 ELSE 0 END),
       sum(CASE WHEN o.priority <> '1-URGENT' AND o.priority <> '2-HIGH' THEN 1 ELSE 0 END)
FROM ship s JOIN orders o USING (order_id)
WHERE s.ship_mode IN ('MAIL', 'SHIP')
GROUP BY s.ship_mode ORDER BY s.ship_mode
----
MAIL	80000	120000
SHIP	80000	120000

query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE reason LIKE '%source_strategy_reason=storage-sensitive-filter%'
----
true

# a numeric comparison beside the string filter still leaves the rows to storage
statement ok
SELECT * FROM duckdb_jit_clear_events()

query III
SELECT s.ship_mode,
       sum(CASE WHEN o.priority = '1-URGENT' OR o.priority = '2-HIGH' THEN 1 ELSE 0 END),
       sum(CASE WHEN o.priority <> '1-URGENT' AND o.priority <> '2-HIGH' THEN 1 ELSE 0 END)
FROM ship s JOIN orders o USING (order_id)
WHERE s.ship_mode IN ('MAIL', 'SHIP') AND s.weight >= 100
GROUP BY s.ship_mode ORDER BY s.ship_mode
----
MAIL	72000	108000
SHIP	72000	108000

query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE reason LIKE '%source_strategy_reason=storage-sensitive-filter%'
----
true

# numeric comparisons that lead the filter run as a packed mask, which leaves the string filter only the rows it keeps
statement ok
SELECT * FROM duckdb_jit_clear_events()

query I
SELECT sum(order_id * 31 + weight) FROM parcels
WHERE day >= 90 AND day < 270 AND weight >= 200 AND ship_mode IN ('MAIL', 'SHIP')
----
1468045508280

query I
SELECT count(*) FROM duckdb_jit_events() WHERE reason LIKE '%source_strategy_reason=storage-sensitive-filter%'
----
0

query I
SELECT count(*) FROM duckdb_jit_events() WHERE phase = 'compile' AND status = 'compiled'
----
1

# Source selection uses an estimated reuse cost, not a dictionary-size capability: the 25 brands are few enough to
# reuse once a source has more than 50000 rows, whatever the category domain.
# The optional numeric IN filter is evaluated by its MARK join, not the generated string filter.
foreach rows 50000 200000 2000000

foreach domain 150 5000

statement ok
CREATE OR REPLACE TABLE categorical_inputs AS
SELECT i AS id, 'brand-' || CAST(i % 25 AS VARCHAR) AS brand,
       CASE WHEN i % 997 = 0 THEN NULL
            ELSE 'category-kind-' || lpad(CAST(i % {domain} AS VARCHAR), 5, '0') END AS category,
       (i % 50)::INTEGER AS bucket
FROM range({rows}) t(i)

statement ok
CHECKPOINT

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement ok
SELECT * FROM duckdb_jit_clear_events()

query II nosort dictionary_domain
SELECT sum(id), count(*) FROM categorical_inputs
WHERE brand <> 'brand-7' AND NOT prefix(category, 'category-kind-00003')
  AND bucket IN (3, 9, 14, 19, 23, 36, 45, 49)
----

endloop

reset label dictionary_domain

query I
SELECT (count(*) > 0) = ({rows} > 50000) FROM duckdb_jit_events()
WHERE reason LIKE '%source_strategy_reason=storage-sensitive-filter%'
----
true

endloop

endloop

endloop

statement ok
SET threads=1

# a long IN list becomes a MARK join plus an optional filter the scan only prunes zones with: it evaluates no row, so
# the string filter still goes to storage
statement ok
SELECT * FROM duckdb_jit_clear_events()

query III
SELECT s.ship_mode,
       sum(CASE WHEN o.priority = '1-URGENT' OR o.priority = '2-HIGH' THEN 1 ELSE 0 END),
       sum(CASE WHEN o.priority <> '1-URGENT' AND o.priority <> '2-HIGH' THEN 1 ELSE 0 END)
FROM ship s JOIN orders o USING (order_id)
WHERE s.ship_mode IN ('MAIL', 'SHIP') AND s.weight IN (3, 9, 14, 19, 23, 36, 45, 49, 103, 777)
GROUP BY s.ship_mode ORDER BY s.ship_mode
----
MAIL	400	1600
SHIP	400	1600

query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE reason LIKE '%source_strategy_reason=storage-sensitive-filter%'
----
true

# a join filter that keeps a few rows leaves the string filter only those rows to evaluate
statement ok
SELECT * FROM duckdb_jit_clear_events()

query III
SELECT s.ship_mode,
       sum(CASE WHEN o.priority = '1-URGENT' OR o.priority = '2-HIGH' THEN 1 ELSE 0 END),
       sum(CASE WHEN o.priority <> '1-URGENT' AND o.priority <> '2-HIGH' THEN 1 ELSE 0 END)
FROM ship s JOIN (SELECT * FROM orders WHERE order_id < 6000) o USING (order_id)
WHERE s.ship_mode IN ('MAIL', 'SHIP')
GROUP BY s.ship_mode ORDER BY s.ship_mode
----
MAIL	3200	4800
SHIP	3200	4800

query I
SELECT count(*) FROM duckdb_jit_events() WHERE reason LIKE '%source_strategy_reason=storage-sensitive-filter%'
----
0

# the same tables in an uncompressed in-memory database keep generated filters
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.orders AS SELECT * FROM orders

statement ok
CREATE TABLE mem.ship AS SELECT * FROM ship

statement ok
SELECT * FROM duckdb_jit_clear_events()

query III
SELECT s.ship_mode,
       sum(CASE WHEN o.priority = '1-URGENT' OR o.priority = '2-HIGH' THEN 1 ELSE 0 END),
       sum(CASE WHEN o.priority <> '1-URGENT' AND o.priority <> '2-HIGH' THEN 1 ELSE 0 END)
FROM mem.ship s JOIN mem.orders o USING (order_id)
WHERE s.ship_mode IN ('MAIL', 'SHIP')
GROUP BY s.ship_mode ORDER BY s.ship_mode
----
MAIL	80000	120000
SHIP	80000	120000

query I
SELECT count(*) FROM duckdb_jit_events() WHERE reason LIKE '%source_strategy_reason=storage-sensitive-filter%'
----
0

# A search over a compressed string column that repeats its values runs on the entries storage keeps of them, even
# with far more distinct values than a low-cardinality column; a column of distinct strings keeps the generated search
statement ok
CREATE TABLE named AS
SELECT i::BIGINT AS id, 'cust#' || CAST(i % 5000 AS VARCHAR) AS repeated_name, 'unique-' || CAST(i AS VARCHAR) AS unique_name
FROM range(300000) t(i)

statement ok
CHECKPOINT

statement ok
SELECT * FROM duckdb_jit_clear_events()

query I
SELECT count(*) FROM named WHERE repeated_name LIKE '%99%'
----
5700

query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE reason LIKE '%source_strategy_reason=storage-sensitive-filter%'
----
true

statement ok
SELECT * FROM duckdb_jit_clear_events()

query I
SELECT count(*) FROM named WHERE unique_name LIKE '%99%'
----
11073

query I
SELECT count(*) FROM duckdb_jit_events() WHERE reason LIKE '%source_strategy_reason=storage-sensitive-filter%'
----
0
