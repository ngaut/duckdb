# name: test/sql/jit/test_jit_remainder_test.test
# description: A filter `n % d = c` the JIT tests by divisibility matches DuckDB for every divisor shape and dividend
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=100000

statement ok
SET jit_trace_runtime=true

# dividends around zero and at both ends of the BIGINT and INTEGER ranges, where n - c and |n| reach 2^63
statement ok
CREATE TABLE rb AS
SELECT i::BIGINT AS i FROM range(-30000, 30000) tbl(i)
UNION ALL
SELECT i FROM (VALUES (-9223372036854775808), (-9223372036854775807), (-9223372036854775806),
                      (-9223372036854775805), (-9223372036854775801), (9223372036854775807), (9223372036854775806),
                      (9223372036854775800), (4611686018427387904), (-4611686018427387904), (4611686018427387907),
                      (-4611686018427387901), (1000000012), (-1000000002)) v(i)

statement ok
CREATE TABLE rj AS
SELECT i::INTEGER AS j FROM range(-30000, 30000) tbl(i)
UNION ALL
SELECT j FROM (VALUES (-2147483648), (-2147483647), (-2147483646), (2147483647), (2147483646), (2147483640),
                      (1000000012), (-1000000002)) v(j)

statement ok
SET jit_policy='off'

statement ok
CREATE TABLE expected AS
