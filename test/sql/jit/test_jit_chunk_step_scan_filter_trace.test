# name: test/sql/jit/test_jit_chunk_step_scan_filter_trace.test
# description: A pipeline that runs as a chunk step reports the rows its storage scan's compiled filters processed
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET threads=1

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=10000

statement ok
SET jit_trace_runtime=true

statement ok
CREATE TABLE part AS
SELECT i::BIGINT AS p_partkey,
       CASE WHEN i % 40 = 0 THEN 'Brand#23' ELSE 'Brand#' || (i % 50) END AS p_brand,
       CASE WHEN i % 7 = 0 THEN 'MED BOX' ELSE 'SM CASE' END AS p_container
FROM range(200000) t(i)

statement ok
CREATE TABLE lineitem AS SELECT (i % 200000)::BIGINT AS l_partkey, (i % 50)::INTEGER AS l_quantity FROM range(1000000) t(i)

statement ok
SELECT * FROM duckdb_jit_clear_events()

# the filtered part scan builds the join's hash table through compiled storage scan filters
query II
SELECT count(*), sum(l_quantity) FROM lineitem, part
WHERE p_partkey = l_partkey AND p_brand = 'Brand#23' AND p_container = 'MED BOX'
----
6430	137165

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%source.storage_scan.compiled_filter=%'
----
true
