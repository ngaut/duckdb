# name: test/sql/jit/test_jit_filtered_perfect_hash_group_expression.test_slow
# description: A filter fused into a perfect-hash aggregate update reads its columns, the payloads' columns and the
# group: [jit]

#              group expressions' columns from one combined source list; a computed group key reads its own column, not
#              whatever column its unmapped index names in that list

statement ok
LOAD jit_sljit

statement ok
CREATE TABLE t AS
SELECT DATE '1992-01-01' + (i % 2500)::INTEGER AS d1, DATE '1992-01-01' + ((i * 7) % 2500)::INTEGER AS d2,
       (i % 1000)::DECIMAL(15,2) AS v, (i % 13)::INTEGER AS k
FROM range(3000000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

query III nosort year_of_unfiltered_column_{threads}
SELECT year(d1) AS y, sum(v), count(*) FROM t WHERE d2 >= DATE '1997-01-01' GROUP BY 1 ORDER BY 1
----

query III nosort two_group_expressions_{threads}
SELECT year(d1) AS y, k + 1 AS kk, sum(v) FROM t WHERE d2 >= DATE '1997-01-01' GROUP BY 1, 2 ORDER BY 1, 2
----

# a partition-only window aggregate is planned as a grouped aggregate joined back to its rows
query II nosort window_partition_{threads}
SELECT count(*), sum(s) FROM (SELECT sum(v) OVER (PARTITION BY year(d1)) AS s FROM t WHERE d2 >= DATE '1997-01-01')
----

endloop

endloop

query III
SELECT year(d1) AS y, sum(v), count(*) FROM t WHERE d2 >= DATE '1997-01-01' GROUP BY 1 ORDER BY 1
----
1992	65067600.00	116400
1993	47980800.00	115200
1994	45907200.00	115200
1995	72633600.00	115200
1996	56160000.00	115200
1997	39686400.00	115200
1998	80812800.00	115200
