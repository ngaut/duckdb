# name: test/sql/jit/test_jit_grouped_runs_null_keys.test
# description: Group runs whose batches hold NULL keys aggregate the NULL group exactly
# group: [jit]

# Sorted group keys form runs the generated run preaggregation compresses; a batch with a NULL key must not take it.
# The NULLs sit inside runs, at batch positions past the run sample.

load {TEST_DIR}/jit_grouped_runs_null_keys.db

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TABLE t AS
SELECT i::BIGINT AS id,
       CASE WHEN i % 4096 BETWEEN 1000 AND 1100 THEN NULL ELSE (i // 64)::BIGINT END AS g,
       CASE WHEN i % 4096 BETWEEN 2000 AND 2050 THEN NULL ELSE (i // 64)::INTEGER END AS gi
FROM range(400000) r(i)

statement ok
CHECKPOINT

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

query IIII
SELECT count(*), sum(c), sum(sg), sum(sid) FROM (SELECT g, count(*) c, sum(g) sg, sum(id) sid FROM t GROUP BY g)
----
6153	400000	1218919318	79999800000

query III
SELECT count(*), sum(c), sum(sid) FROM (SELECT g, count(*) c, sum(id) sid FROM t GROUP BY g) WHERE g IS NULL
----
1	9898	1976689988

query III
SELECT count(*), sum(c), sum(sid) FROM (SELECT gi, count(*) c, sum(id) sid FROM t GROUP BY gi)
----
6251	400000	79999800000

query III
SELECT count(*), sum(c), sum(sid) FROM (SELECT gi, count(*) c, sum(id) sid FROM t GROUP BY gi) WHERE gi IS NULL
----
1	4998	1003003638

query II
SELECT count(*), sum(c) FROM (SELECT g, count(*) c FROM t GROUP BY g)
----
6153	400000

endloop

endloop
