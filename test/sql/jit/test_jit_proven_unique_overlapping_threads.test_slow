# name: test/sql/jit/test_jit_proven_unique_overlapping_threads.test_slow
# description: Threads whose sorted key streams prove their groups unique, but whose key ranges overlap, combine into DuckDB's groups
# group: [jit]

# A rising key stream lets a thread append its groups without lookups and defer them unpartitioned. When the ranges of
# the threads that have combined overlap, the rows are radix-partitioned while combining (the first overlapping thread
# also takes the rows deferred before it) and the finalizer rehashes them.

statement ok
LOAD jit_sljit

statement ok
CREATE TABLE sk AS SELECT (i // 3)::BIGINT AS k, (i % 11)::BIGINT AS v, (i // 7)::INTEGER AS k32 FROM range(3000000) t(i)

foreach threads 4 8

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

# each thread's keys rise, but their row groups interleave: the threads' key ranges overlap
query IIII
SELECT count(*), sum(hash(k, s)), sum(s), max(c) FROM (SELECT k, sum(v) AS s, count(*) AS c FROM sk GROUP BY k)
----
1000000	9236057424965971406865649	14999988	3

query III
SELECT count(*), sum(hash(k32, s)), sum(s) FROM (SELECT k32, sum(v) AS s FROM sk GROUP BY k32)
----
428572	3953474425220244801406127	14999988

query II
SELECT count(*), sum(s) FROM (SELECT k, sum(v) AS s FROM sk WHERE k % 5 <> 2 GROUP BY k)
----
800000	11999986

query II
SELECT k, sum(v) FROM sk GROUP BY k HAVING sum(v) > 26 ORDER BY k LIMIT 5
----
10	27
21	27
32	27
43	27
54	27

endloop

endloop
