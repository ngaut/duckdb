# name: test/sql/jit/test_jit_arithmetic_overflow.test
# description: Compiled integer arithmetic raises exactly DuckDB's overflow errors, naming the operand type and values,
#              and a 32-bit result is sign-extended before a 64-bit consumer (a sum, a range check) reads it
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

# each overflowing column has exactly one row that overflows, so the reported operands do not depend on scheduling
statement ok
CREATE TABLE ov AS
SELECT CASE WHEN i = 77777 THEN 2000000000 ELSE i END::INTEGER AS a,
       CASE WHEN i = 66666 THEN -2000000000 ELSE i END::INTEGER AS n,
       CASE WHEN i = 55555 THEN 5000000000000000000 ELSE i END::BIGINT AS c,
       CASE WHEN i = 44444 THEN 9000000000000000.00 ELSE i END::DECIMAL(18,2) AS d,
       20::DECIMAL(4,0) AS e,
       CASE WHEN i = 33333 THEN DATE '5000000-01-01' ELSE DATE '1960-01-01' + (i % 500)::INTEGER END AS dt,
       (i % 1000)::INTEGER - 2000 AS m,
       (i % 7)::INTEGER AS g
FROM range(100000) t(i)

foreach threads 1 4

statement ok
SET threads=${threads}

foreach policy off auto

statement ok
SET jit_policy='${policy}'

statement error
SELECT sum(a * 2) FROM ov
----
Out of Range Error: Overflow in multiplication of INT32 (2000000000 * 2)!

statement error
SELECT max(a + 200000000) FROM ov
----
Out of Range Error: Overflow in addition of INT32 (2000000000 + 200000000)!

statement error
SELECT min(n - 200000000) FROM ov
----
Out of Range Error: Overflow in subtraction of INT32 (-2000000000 - 200000000)!

statement error
SELECT sum(c * 2) FROM ov
----
Out of Range Error: Overflow in multiplication of INT64 (5000000000000000000 * 2)!

statement error
SELECT sum(d * e) FROM ov
----
Out of Range Error: Overflow in multiplication of DECIMAL(18) (900000000000000000 * 20). You might want to add an explicit cast to a bigger decimal.

# the overflow inside an expression tree
statement error
SELECT sum(a * 2 + g) FROM ov
----
Out of Range Error: Overflow in multiplication of INT32 (2000000000 * 2)!

statement error
SELECT g, sum(a * 2) FROM ov GROUP BY g
----
Out of Range Error: Overflow in multiplication of INT32 (2000000000 * 2)!

statement error
SELECT max(dt + 2000000000) FROM ov
----
Out of Range Error: Date out of range

# negative 32-bit results summed into a 64-bit state
query III
SELECT sum(m - 1000), sum(m * 3), sum(m + g) FROM ov
----
-250050000	-450150000	-149750005

query I
SELECT sum(m - 1000) FROM ov WHERE g > 2
----
-142882713

# dates before 1970 are negative day counts: the result range check must see them sign-extended
query II
SELECT min(dt - 1), max(dt + 1) FROM ov WHERE dt < DATE '2000-01-01'
----
1959-12-31	1961-05-15

endloop

endloop
