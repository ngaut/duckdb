# name: test/sql/jit/test_jit_exact_source_filter_signed_keys.test
# description: A regular probe answered by the build side's exact membership filter tests INTEGER and SMALLINT keys whose smallest build key is negative like the vectorized plan, keeping the keys above zero
# group: [jit]

require jit_sljit

statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_trace_runtime=true

# Regular hash tables: a perfect hash table answers the probe without the membership filter
statement ok
SET perfect_ht_threshold=0

statement ok
SET jit_event_log_size=100000

# unique build keys from below zero to above it; every build key is a probe key
statement ok
CREATE TABLE probe AS
SELECT i AS id, (i * 49 - 20000000)::INTEGER AS k, ((i % 64000) - 32000)::SMALLINT AS s FROM range(1000000) t(i)

statement ok
CREATE TABLE build AS
SELECT (i * 14700 - 20000000)::INTEGER AS k, (i * 29 - 30000)::SMALLINT AS s FROM range(2000) t(i)

statement ok
CREATE MACRO joins() AS TABLE
SELECT 'integer' AS q, count(*) AS c, sum(p.id) AS i, sum(b.k) AS k FROM probe p JOIN build b USING (k)
UNION ALL
SELECT 'smallint', count(*), sum(p.id), sum(b.s) FROM probe p JOIN build b USING (s)

foreach threads 1 4

statement ok
SET threads={threads}

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS FROM joins()

statement ok
SET jit_policy='auto'

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS FROM joins()

query I
SELECT count(*) FROM ((FROM expected EXCEPT ALL FROM actual) UNION ALL (FROM actual EXCEPT ALL FROM expected))
----
0

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%hash_join_probe.regular_probe.exact_source_filter=%'
----
true

endloop

query IIII
SELECT q, c, i, k FROM expected ORDER BY q
----
integer	2000	599700000	-10614700000
smallint	31311	15655649445	-44862555
