# name: test/sql/jit/test_jit_compile_failure_fallback.test
# description: A region the cost model selects but the backend cannot build runs vectorized instead of failing the
#              query; the compile event records the backend's reason
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=1000

statement ok
CREATE TABLE d AS SELECT range AS k, range % 7 AS x FROM range(1000)

# the grouped typed payload backend has no code for a payload without input columns (a constant); if it learns them,
# this test needs another shape the backend cannot build
query III
SELECT count(*), sum(s), sum(p) FROM (SELECT k, sum(1::BIGINT) AS s, sum(x * 2) AS p FROM d GROUP BY k)
----
1000	1000	5994

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status = 'error' AND reason LIKE '%no generated typed payload backend%'
----
true
