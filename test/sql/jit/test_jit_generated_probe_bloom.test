# name: test/sql/jit/test_jit_generated_probe_bloom.test
# description: The generated regular probe loop tests the build side's bloom filter with the sector and bit layout the
# group: [jit]

#              build wrote, so it rejects sparse misses and keeps every match (nullable single and pair keys)

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=100000

# Regular hash tables: a perfect hash table never asks for a bloom filter
statement ok
SET perfect_ht_threshold=0

# Nullable probe keys reach the join unfiltered, which keeps the probe in the generated loop
statement ok
PRAGMA disable_optimizer

statement ok
CREATE TABLE probe AS
SELECT CASE WHEN i % 10 = 3 THEN NULL ELSE i::BIGINT * 4900 END AS k0,
       CASE WHEN i % 13 = 7 THEN NULL ELSE i::BIGINT * 17 END AS k1, i::BIGINT AS id
FROM range(1000000) t(i)

statement ok
CREATE TABLE build AS
SELECT CASE WHEN i % 11 = 5 THEN NULL ELSE i::BIGINT * 298900 END AS k0,
       CASE WHEN i % 9 = 2 THEN NULL ELSE i::BIGINT * 61 * 17 END AS k1, (i % 7)::INTEGER AS w
FROM range(16000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach keys k0 k0,k1

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT count(*) AS c, sum(p.id) AS s, sum(b.w) AS w FROM probe p JOIN build b USING ({keys})

statement ok
SET jit_policy='auto'

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT count(*) AS c, sum(p.id) AS s, sum(b.w) AS w FROM probe p JOIN build b USING ({keys})

query I
SELECT count(*) FROM expected JOIN actual USING (c, s, w) WHERE c > 10000
----
1

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%hash_join_probe.regular_probe.generated.bloom%'
----
true

endloop

endloop
