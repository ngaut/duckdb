# name: test/sql/jit/test_jit_nested_cast_errors.test
# description: Projection composition preserves narrowing errors and TRY_CAST semantics in integer round trips
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TABLE cast_probe AS
SELECT i, CASE WHEN i = 4242 THEN 3000000000 ELSE (i % 100) END::BIGINT AS k
FROM range(10000) t(i)

statement ok
CREATE TABLE cast_build AS SELECT i::BIGINT AS k FROM range(100) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

foreach width TINYINT SMALLINT INTEGER

statement error
SELECT max(k::{width}::BIGINT) FROM cast_probe
----
out of range

# The build keys' range filter reaches the probe scan through the casts, also through a projection, so the
# out-of-range row is filtered before the cast runs
query I
SELECT count(*) FROM cast_probe p JOIN cast_build b ON p.k::{width}::BIGINT = b.k
----
9999

query I
SELECT count(*) FROM (SELECT k::{width} AS n FROM cast_probe) p JOIN cast_build b ON p.n::BIGINT = b.k
----
9999

# TRY_CAST outside a throwing inner cast must not suppress the inner exception.
statement error
SELECT max(TRY_CAST(k::{width} AS BIGINT)) FROM cast_probe
----
out of range

query I
SELECT count(*) FROM cast_probe p JOIN cast_build b ON TRY_CAST(p.k AS {width})::BIGINT = b.k
----
9999

query I
SELECT count(*) FROM cast_probe WHERE TRY_CAST(TRY_CAST(k AS {width}) AS BIGINT) IS NULL
----
1

query I
SELECT max(k::{width}::BIGINT) FROM cast_probe WHERE i <> 4242
----
99

# Both ends of each signed range must retain the narrowing error.
statement error
SELECT max((-k)::{width}::BIGINT) FROM cast_probe
----
out of range

endloop

# A safe widening round trip and a mixed-width chain remain valid and compilable.
query II nosort widening_cast_{threads}
SELECT sum(k::INTEGER::BIGINT::INTEGER), sum(k::SMALLINT::BIGINT::INTEGER::SMALLINT)
FROM cast_probe WHERE i <> 4242
----

query II nosort nullable_cast_{threads}
SELECT sum(TRY_CAST(k AS SMALLINT)::BIGINT), count(TRY_CAST(k AS SMALLINT)::BIGINT)
FROM cast_probe
----

endloop

endloop
