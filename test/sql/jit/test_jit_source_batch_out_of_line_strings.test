# name: test/sql/jit/test_jit_source_batch_out_of_line_strings.test
# description: Small source chunks batch unless they carry strings stored out of line, which pass through unbatched;
# group: [jit]

#              batched rows still reach the sink ahead of the next unbatched chunk, so scan order holds

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=100000

# The join's key filter keeps every eighth probe row inside the scan, so each source chunk is small; its strings are
# inlined, then out of line, then inlined again
statement ok
CREATE TABLE t AS
SELECT i::BIGINT AS id,
       CASE WHEN i < 300000 THEN 's' || (i % 100)
            WHEN i < 600000 THEN 'a string longer than twelve bytes ' || i
            ELSE 't' || (i % 100) END AS s
FROM range(900000) t(i)

statement ok
CREATE TABLE keys AS SELECT (i * 8)::BIGINT AS id, (i % 5)::INTEGER AS w FROM range(112500) t(i)

statement ok
SET threads=1

statement ok
SET jit_policy='off'

statement ok
CREATE TABLE expected AS SELECT t.id * 3 + 1 AS id, t.s, keys.w FROM t JOIN keys USING (id)

statement ok
SET jit_policy='auto'

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE TABLE actual AS SELECT t.id * 3 + 1 AS id, t.s, keys.w FROM t JOIN keys USING (id)

query I
SELECT count(*) FROM duckdb_jit_events() WHERE phase = 'runtime' AND status = 'executed'
----
1

query I
SELECT count(*) FROM (SELECT id, lag(id) OVER (ORDER BY rowid) AS previous FROM actual) WHERE previous >= id
----
0

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET threads=4

statement ok
CREATE OR REPLACE TABLE actual AS SELECT t.id * 3 + 1 AS id, t.s, keys.w FROM t JOIN keys USING (id)

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0
