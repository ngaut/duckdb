# name: test/sql/jit/test_jit_pushed_input_step.test_slow
# description: A CTE consumer fed by its producer's pushes runs as a compiled chunk step: results match the vectorized
# group: [jit]

#              pipeline, and an order-preserving sink keeps insertion order across the producer's batches

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=100000

statement ok
SET jit_trace_runtime=true

statement ok
CREATE TABLE t AS SELECT i::BIGINT AS i, (i % 1000)::BIGINT AS m FROM range(3000000) tbl(i)

# a correlated subquery: the join of li and pa becomes a delim CTE whose direct consumer aggregates per key; the keys
# span a wide range, so per-key aggregates hash their groups
statement ok
CREATE TABLE li AS
SELECT ((i % 2000) * 1000003)::BIGINT AS pk, (i % 47)::DECIMAL(15,2) AS qty, (i % 1000)::DECIMAL(15,2) AS price
FROM range(1000000) tbl(i)

statement ok
CREATE TABLE pa AS SELECT (i * 1000003)::BIGINT AS pk, (i % 10)::BIGINT AS brand FROM range(2000) tbl(i)

foreach threads 1 4

statement ok
SET threads={threads}

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT 'direct' AS q, count(*)::HUGEINT AS c, sum(j * 3)::HUGEINT AS s
FROM (WITH c AS MATERIALIZED (SELECT i + 1 AS j, m FROM t WHERE m < 300) SELECT * FROM c)
UNION ALL
SELECT 'delim', count(*), sum(price * 100)::HUGEINT
FROM li, pa
WHERE pa.pk = li.pk AND brand = 3 AND qty < (SELECT 0.5 * avg(qty) FROM li l2 WHERE l2.pk = pa.pk)

statement ok
SET jit_policy='auto'

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT 'direct' AS q, count(*)::HUGEINT AS c, sum(j * 3)::HUGEINT AS s
FROM (WITH c AS MATERIALIZED (SELECT i + 1 AS j, m FROM t WHERE m < 300) SELECT * FROM c)
UNION ALL
SELECT 'delim', count(*), sum(price * 100)::HUGEINT
FROM li, pa
WHERE pa.pk = li.pk AND brand = 3 AND qty < (SELECT 0.5 * avg(qty) FROM li l2 WHERE l2.pk = pa.pk)

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

query I
SELECT count(*) > 0 FROM actual WHERE q = 'delim' AND c > 0
----
true

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND reason = 'full pipeline kernel executed on pushed input'
  AND pipeline_shape LIKE '%source:source:CTE_SCAN%'
----
true

# TPC-H Q11's shape: one join result feeds a grouped and an ungrouped direct consumer
statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected_groups AS
WITH c AS MATERIALIZED (SELECT pk, price * qty AS v FROM li JOIN pa USING (pk) WHERE brand = 3)
SELECT pk, sum(v) AS value FROM c GROUP BY pk HAVING sum(v) > (SELECT sum(v) * 0.004 FROM c)

statement ok
SET jit_policy='auto'

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual_groups AS
WITH c AS MATERIALIZED (SELECT pk, price * qty AS v FROM li JOIN pa USING (pk) WHERE brand = 3)
SELECT pk, sum(v) AS value FROM c GROUP BY pk HAVING sum(v) > (SELECT sum(v) * 0.004 FROM c)

query II
SELECT (SELECT count(*) FROM expected_groups) > 0,
       (SELECT count(*) FROM ((SELECT * FROM expected_groups EXCEPT ALL SELECT * FROM actual_groups)
                              UNION ALL (SELECT * FROM actual_groups EXCEPT ALL SELECT * FROM expected_groups)))
----
true	0

# the producer's pushes carry its batches; the consumer's step holds its few output rows across pushes and sinks them
# before the order-preserving materialization moves to the next batch
statement ok
CREATE OR REPLACE TABLE ordered AS
WITH c AS MATERIALIZED (SELECT i + 1 AS j, m FROM t WHERE m < 300) SELECT j * 2 AS k FROM c WHERE m % 7 = 0

query III
SELECT count(*), sum(k), count(*) FILTER (WHERE previous >= k)
FROM (SELECT k, lag(k) OVER (ORDER BY rowid) AS previous FROM ordered)
----
129000	386909184000	0

endloop

# with one thread the grouped consumer compiles too, and its step reserves groups for the threads that push into it
statement ok
SET threads=1

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual_groups AS
WITH c AS MATERIALIZED (SELECT pk, price * qty AS v FROM li JOIN pa USING (pk) WHERE brand = 3)
SELECT pk, sum(v) AS value FROM c GROUP BY pk HAVING sum(v) > (SELECT sum(v) * 0.004 FROM c)

query I
SELECT count(*) FROM ((SELECT * FROM expected_groups EXCEPT ALL SELECT * FROM actual_groups)
                      UNION ALL (SELECT * FROM actual_groups EXCEPT ALL SELECT * FROM expected_groups))
----
0

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND reason = 'full pipeline kernel executed on pushed input'
  AND pipeline_shape LIKE '%sink:sink:HASH_GROUP_BY%'
----
true
