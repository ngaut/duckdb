# name: test/sql/jit/test_jit_streaming_cte_producer.test_slow
# description: Compiled CTE producers feed a streaming or hybrid exchange: direct consumers run inside the producer's
# group: [jit]

#              sink, a consumer that stops early finishes the producer, and an order-preserving exchange keeps the
#              producer's batch order

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=100000

statement ok
SET jit_trace_decisions=true

statement ok
CREATE TABLE t AS SELECT i::BIGINT AS i, (i % 1000)::BIGINT AS m FROM range(3000000) tbl(i)

statement ok
CREATE TABLE p AS SELECT i::BIGINT AS i, (i % 4)::BIGINT AS k FROM range(20000) tbl(i)

statement ok
CREATE TABLE b AS SELECT i::BIGINT AS j, (i % 4)::BIGINT AS k FROM range(400) tbl(i)

# a correlated subquery over a join: the join output is a delim CTE with a direct and a materialized consumer; the
# sparse variant's probe emits a few rows per source chunk, which coalesce before the CTE sink
statement ok
CREATE TABLE li AS
SELECT (i % 2000)::BIGINT AS pk, (i % 50)::DECIMAL(15,2) AS qty, (i % 1000)::DECIMAL(15,2) AS price
FROM range(1000000) tbl(i)

statement ok
CREATE TABLE pa AS SELECT i::BIGINT AS pk, (i % 10)::BIGINT AS brand FROM range(2000) tbl(i)

foreach threads 1 4

statement ok
SET threads={threads}

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT 'direct' AS q, count(*)::HUGEINT AS c, sum(j)::HUGEINT AS s, sum(m)::HUGEINT AS s2
FROM (WITH c AS MATERIALIZED (SELECT i + 1 AS j, m FROM t WHERE m < 300) SELECT * FROM c)
UNION ALL
SELECT 'two_direct', * FROM (
	WITH c AS MATERIALIZED (SELECT i + 1 AS j, m FROM t WHERE m < 300)
	SELECT (SELECT count(*) FROM c), (SELECT sum(j) FROM c), (SELECT sum(m) FROM c))
UNION ALL
SELECT 'fanout_join', count(*), sum(i), sum(j)
FROM (WITH c AS MATERIALIZED (SELECT p.i, b.j FROM p JOIN b USING (k)) SELECT * FROM c)
UNION ALL
SELECT 'delim', count(*), sum(price * 100)::HUGEINT, sum(qty * 100)::HUGEINT
FROM li, pa
WHERE pa.pk = li.pk AND brand = 3 AND qty < (SELECT 0.2 * avg(qty) FROM li l2 WHERE l2.pk = pa.pk)
UNION ALL
SELECT 'delim_sparse', count(*), sum(price * 100)::HUGEINT, sum(qty * 100)::HUGEINT
FROM li, pa
WHERE pa.pk = li.pk AND brand = 3 AND pa.pk < 40 AND qty < (SELECT 0.2 * avg(qty) FROM li l2 WHERE l2.pk = pa.pk)

statement ok
SET jit_policy='auto'

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT 'direct' AS q, count(*)::HUGEINT AS c, sum(j)::HUGEINT AS s, sum(m)::HUGEINT AS s2
FROM (WITH c AS MATERIALIZED (SELECT i + 1 AS j, m FROM t WHERE m < 300) SELECT * FROM c)
UNION ALL
SELECT 'two_direct', * FROM (
	WITH c AS MATERIALIZED (SELECT i + 1 AS j, m FROM t WHERE m < 300)
	SELECT (SELECT count(*) FROM c), (SELECT sum(j) FROM c), (SELECT sum(m) FROM c))
UNION ALL
SELECT 'fanout_join', count(*), sum(i), sum(j)
FROM (WITH c AS MATERIALIZED (SELECT p.i, b.j FROM p JOIN b USING (k)) SELECT * FROM c)
UNION ALL
SELECT 'delim', count(*), sum(price * 100)::HUGEINT, sum(qty * 100)::HUGEINT
FROM li, pa
WHERE pa.pk = li.pk AND brand = 3 AND qty < (SELECT 0.2 * avg(qty) FROM li l2 WHERE l2.pk = pa.pk)
UNION ALL
SELECT 'delim_sparse', count(*), sum(price * 100)::HUGEINT, sum(qty * 100)::HUGEINT
FROM li, pa
WHERE pa.pk = li.pk AND brand = 3 AND pa.pk < 40 AND qty < (SELECT 0.2 * avg(qty) FROM li l2 WHERE l2.pk = pa.pk)

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE status = 'compiled' AND reason LIKE '%sink:CTE:native%'
----
true

# a buffered consumer that stops early finishes the producer; the batch-indexed exchange keeps insertion order
query I
WITH c AS MATERIALIZED (SELECT i + 1 AS j FROM t WHERE m < 300) SELECT j FROM c LIMIT 5
----
1
2
3
4
5

query I
WITH c AS MATERIALIZED (SELECT i + 1 AS j FROM t WHERE m < 300) SELECT j FROM c
----
900000 values hashing to 7ed129351c2d81c501090943511fd408

endloop
