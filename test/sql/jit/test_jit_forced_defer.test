# name: test/sql/jit/test_jit_forced_defer.test
# description: Compiled-to-native handoff preserves results per sink kind: boundary deferral (serial and parallel), entry deferral, and the distinct-key-sink recipe refusing mid-query handoff
# group: [jit]

statement ok
LOAD jit_sljit

# Deterministic engagement: single-threaded with runtime tracing so the deferral
# events prove the compiled kernels actually ran and handed off.
statement ok
SET threads=1;

statement ok
SET jit_event_log_size=4000;

statement ok
SET jit_trace_runtime=true;

statement ok
CREATE TABLE facts AS
SELECT (i % 97)::INTEGER g, i::BIGINT v, (i % 7)::BIGINT w
FROM range(500000) tbl(i);

statement ok
CREATE TABLE dims AS
SELECT i::INTEGER k, (i * 3)::BIGINT payload FROM range(97) tbl(i);

# Reference results with the JIT disabled.
statement ok
SET jit_policy='off';

statement ok
CREATE TABLE ref_ungrouped AS SELECT sum(v + 1) s, count(*) c FROM facts WHERE v % 3 = 0;

statement ok
CREATE TABLE ref_grouped AS SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g;

statement ok
CREATE TABLE ref_join AS
SELECT d.k, sum(f.v + d.payload) s
FROM facts f JOIN dims d ON f.g = d.k
GROUP BY d.k;

statement ok
CREATE TABLE ref_distinct AS SELECT count(DISTINCT g) c FROM facts WHERE w < 5;

statement ok
CREATE TABLE ref_grouped_distinct AS SELECT g, count(DISTINCT v % 9973) c FROM facts GROUP BY g;

statement ok
SET jit_policy='auto';

# Force the compiled kernel to hand off to the vectorized continuation at the
# first row-group boundary after N fetched chunks. The handoff is only legal
# with no in-flight rows, so every result must match the native reference
# exactly; an overcount or undercount here means the handoff protocol strands
# or replays source rows.

loop force_n 1 3

statement ok
SET jit_debug_force_defer_after_chunks=${force_n};

query I
SELECT count(*) FROM (
  SELECT sum(v + 1) s, count(*) c FROM facts WHERE v % 3 = 0
) q JOIN ref_ungrouped r ON q.s IS NOT DISTINCT FROM r.s AND q.c IS NOT DISTINCT FROM r.c
----
1

query I
SELECT count(*) FROM (
  (SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped)
  UNION ALL
  (SELECT * FROM ref_grouped EXCEPT SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g)
)
----
0

query I
SELECT count(*) FROM (
  (SELECT d.k, sum(f.v + d.payload) s FROM facts f JOIN dims d ON f.g = d.k GROUP BY d.k
   EXCEPT SELECT * FROM ref_join)
  UNION ALL
  (SELECT * FROM ref_join
   EXCEPT SELECT d.k, sum(f.v + d.payload) s FROM facts f JOIN dims d ON f.g = d.k GROUP BY d.k)
)
----
0

query I
SELECT count(*) FROM (
  SELECT count(DISTINCT g) c FROM facts WHERE w < 5
) q JOIN ref_distinct r ON q.c IS NOT DISTINCT FROM r.c
----
1

# Grouped distinct compiles into the inline distinct-key-sink recipe, which owns
# the pipeline's counting and therefore refuses runner handoff: forcing a defer
# must leave the result exact because the kernel never defers.
query I
SELECT count(*) FROM (
  (SELECT g, count(DISTINCT v % 9973) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped_distinct)
  UNION ALL
  (SELECT * FROM ref_grouped_distinct EXCEPT SELECT g, count(DISTINCT v % 9973) c FROM facts GROUP BY g)
)
----
0

endloop

# The proof is non-vacuous only if compiled kernels actually deferred.
query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE reason LIKE '%forced defer at row-group boundary%'
----
true

# The grouped-distinct queries must actually take the distinct-key-sink recipe:
# its handoff refusal is only proven if the ownership-claiming path engaged.
query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE jit_runtime_path_counts LIKE '%distinct_key_sink%'
----
true

# Parallel handoff: each thread's kernel defers independently; results must stay
# exact across the shared distribution.
statement ok
SET threads=4;

statement ok
SET jit_debug_force_defer_after_chunks=1;

query I
SELECT count(*) FROM (
  (SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped)
  UNION ALL
  (SELECT * FROM ref_grouped EXCEPT SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g)
)
----
0

query I
SELECT count(*) FROM (
  (SELECT g, count(DISTINCT v % 9973) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped_distinct)
  UNION ALL
  (SELECT * FROM ref_grouped_distinct EXCEPT SELECT g, count(DISTINCT v % 9973) c FROM facts GROUP BY g)
)
----
0

statement ok
SET jit_debug_force_defer_after_chunks=0;

# Entry deferral: the genuine native-fallback path for not-ready runtime states
# hands off BEFORE any source fetch, where nothing is in flight. Every sink kind
# must stay exact — including the distinct-key-sink recipe, which refuses
# mid-query handoff but tolerates entry deferral because no counting claim
# exists before the first row.
statement ok
SET threads=1;

statement ok
SET jit_debug_force_entry_defer=true;

query I
SELECT count(*) FROM (
  SELECT sum(v + 1) s, count(*) c FROM facts WHERE v % 3 = 0
) q JOIN ref_ungrouped r ON q.s IS NOT DISTINCT FROM r.s AND q.c IS NOT DISTINCT FROM r.c
----
1

query I
SELECT count(*) FROM (
  (SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped)
  UNION ALL
  (SELECT * FROM ref_grouped EXCEPT SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g)
)
----
0

query I
SELECT count(*) FROM (
  (SELECT d.k, sum(f.v + d.payload) s FROM facts f JOIN dims d ON f.g = d.k GROUP BY d.k
   EXCEPT SELECT * FROM ref_join)
  UNION ALL
  (SELECT * FROM ref_join
   EXCEPT SELECT d.k, sum(f.v + d.payload) s FROM facts f JOIN dims d ON f.g = d.k GROUP BY d.k)
)
----
0

query I
SELECT count(*) FROM (
  (SELECT g, count(DISTINCT v % 9973) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped_distinct)
  UNION ALL
  (SELECT * FROM ref_grouped_distinct EXCEPT SELECT g, count(DISTINCT v % 9973) c FROM facts GROUP BY g)
)
----
0

# Non-vacuous only if kernels actually deferred at entry.
query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE reason LIKE '%debug forced defer at kernel entry%'
----
true

statement ok
SET jit_debug_force_entry_defer=false;
