# a row that overflows or divides by zero raises DuckDB's error from inside the update loop
statement error
SELECT g, gs, count(*), sum(price), sum(price * (1.00::DECIMAL(15,2) - dec)), sum(dec), sum(id)
FROM f WHERE big + id > 0
GROUP BY g, gs ORDER BY g, gs
----
Overflow in addition of INT64

statement error
SELECT g, gs, count(*), sum(price), sum(price * (1.00::DECIMAL(15,2) - dec)), sum(dec), sum(id)
FROM f WHERE id * big > 0
GROUP BY g, gs ORDER BY g, gs
----
Overflow in multiplication of INT64

statement error
SELECT g, gs, count(*), sum(price), sum(price * (1.00::DECIMAL(15,2) - dec)), sum(dec), sum(id)
FROM f WHERE a // (b + 18) > 1
GROUP BY g, gs ORDER BY g, gs
----
Division by zero

endloop

endloop

# every filter runs inside the generated update loop
statement ok
SET threads=1

statement ok
SET jit_trace_runtime=true

statement ok
SELECT * FROM duckdb_jit_clear_events()

query TTIIIII
SELECT g, gs, count(*), sum(price), sum(price * (1.00::DECIMAL(15,2) - dec)), sum(dec), sum(id)
FROM f WHERE price > 10.00::DECIMAL(15,2)
