# name: test/sql/jit/test_jit_filtered_perfect_hash_shapes.test
# description: A filter fuses into the generated perfect-hash aggregate update whatever share of rows it keeps
# group: [jit]

# The checkpointed table compresses its low-cardinality string group columns, which puts the GROUP BY on a perfect hash
# table. String, disjunction, IN, NULL-test, CASE and arithmetic filters, filters that keep nearly every row, and
# filters whose arithmetic overflows must give DuckDB's groups and errors.

load {TEST_DIR}/jit_filtered_perfect_hash_shapes.db

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=10000

statement ok
CREATE TABLE f AS
SELECT CASE i % 3 WHEN 0 THEN 'A' WHEN 1 THEN 'N' ELSE 'R' END AS g,
       CASE i % 2 WHEN 0 THEN 'F' ELSE 'O' END AS gs,
       i::BIGINT AS id,
       (i % 100)::INTEGER AS a,
       (i % 37 - 18)::INTEGER AS b,
       CASE WHEN i % 7 = 0 THEN NULL ELSE (i % 60)::INTEGER END AS n,
       'name_' || (i % 50)::VARCHAR AS s,
       CASE WHEN i % 9 = 0 THEN NULL ELSE 'v' || (i % 23)::VARCHAR || repeat('q', i % 15) END AS ns,
       CAST((i % 500) / 4 AS DECIMAL(15,2)) AS dec,
       DATE '2020-01-01' + (i % 400)::INTEGER AS dt,
       CASE WHEN i = 77777 THEN 9223372036854775000 ELSE i END::BIGINT AS big,
       CAST(i % 2000 AS DECIMAL(15,2)) AS price
FROM range(300000) t(i)

statement ok
CHECKPOINT

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

# comparisons that keep most rows still run the filter inside the update loop
query TTIIIII
SELECT g, gs, count(*), sum(price), sum(price * (1.00::DECIMAL(15,2) - dec)), sum(dec), sum(id)
FROM f WHERE price > 10.00::DECIMAL(15,2)
GROUP BY g, gs ORDER BY g, gs
----
A	F	49700	49948500.00	-3319848750.0000	3112125.00	7455148500
A	O	49750	49998750.00	-3335411687.5000	3124687.50	7462848750
N	F	49700	49948500.00	-3319848750.0000	3112125.00	7455348500
N	O	49750	49998750.00	-3335411687.5000	3124687.50	7462648750
R	F	49700	49948500.00	-3319848750.0000	3112125.00	7455248500
R	O	49750	49998750.00	-3335411687.5000	3124687.50	7462748750

