# name: test/sql/jit/test_jit_narrow_widening_payload.test
# description: Ungrouped sums over TINYINT and SMALLINT columns widened by a cast read the narrow columns with
#              sign-extending loads inside the generated payload, and the fast loops keep their running sums in
#              registers. Expected values come from jit_policy='off'.
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET threads=1

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_dump_ir=true

statement ok
SET jit_event_log_size=100000

statement ok
CREATE TABLE narrow AS
SELECT i AS id,
       CASE WHEN i % 1000 = 1 THEN 127::TINYINT WHEN i % 1000 = 2 THEN (-128)::TINYINT
            ELSE ((i % 255) - 127)::TINYINT END AS ti,
       CASE WHEN i % 1000 = 3 THEN 32767::SMALLINT WHEN i % 1000 = 4 THEN (-32768)::SMALLINT
            ELSE ((i * 7919) % 65535 - 32767)::SMALLINT END AS si,
       CASE WHEN i % 37 = 0 THEN NULL ELSE ((i % 251) - 125)::TINYINT END AS nti,
       CASE WHEN i % 41 = 0 THEN NULL ELSE ((i * 31) % 60001 - 30000)::SMALLINT END AS nsi
FROM range(200000) tbl(i)

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS SELECT sum(ti::INTEGER * si) FROM narrow WHERE ti > 10

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS SELECT sum(ti::INTEGER * si) FROM narrow WHERE ti > 10

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS SELECT sum(ti::INTEGER * si) FROM narrow

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS SELECT sum(ti::INTEGER * si) FROM narrow

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS SELECT sum(si::BIGINT), sum(ti::INTEGER + 5) FROM narrow WHERE si < 0

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS SELECT sum(si::BIGINT), sum(ti::INTEGER + 5) FROM narrow WHERE si < 0

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS SELECT sum(nti::INTEGER * nsi) FROM narrow

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS SELECT sum(nti::INTEGER * nsi) FROM narrow

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS SELECT sum(nsi::BIGINT), count(*) FROM narrow WHERE ti < -100

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS SELECT sum(nsi::BIGINT), count(*) FROM narrow WHERE ti < -100

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS SELECT sum(ti::INTEGER * si) FROM narrow WHERE ti > 200

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS SELECT sum(ti::INTEGER * si) FROM narrow WHERE ti > 200

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS SELECT sum(ti::BIGINT * si::BIGINT * 70000) FROM narrow

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS SELECT sum(ti::BIGINT * si::BIGINT * 70000) FROM narrow

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

# the widening casts compose into the generated payload: no projection is left to materialize the INTEGER columns
statement ok
SET jit_policy='auto'

statement ok
SELECT sum(ti::INTEGER * si) FROM narrow WHERE ti > 10

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status = 'compiled' AND ir LIKE '%op0=aggregate_update(kind=ungrouped%' AND ir NOT LIKE '%op1=%'
  AND ir LIKE '%primitive_payloads=native:typed-expression-tree%cast:INTEGER(ref#0:TINYINT)%'
----
true
