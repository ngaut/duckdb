# name: test/sql/jit/test_jit_direct_join_aggregate_flush.test_slow
# description: A grouped aggregate fed directly by a join's output, with no projection chain after the join, batches
# group: [jit]

#              its input rows; the rows still pending when the source ends reach the aggregate

require tpch

statement ok
LOAD jit_sljit

statement ok
CALL dbgen(sf=0.1)

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

foreach threads 1 4

statement ok
SET threads={threads}

# a long string group key from the build side batches the join's output rows
query II
SELECT sum(n), count(*) FROM (
    SELECT o_orderdate, n_comment, count(*) AS n
    FROM customer JOIN nation ON c_nationkey = n_nationkey JOIN orders ON c_custkey = o_custkey
    GROUP BY 1, 2)
----
150000	55201

endloop
