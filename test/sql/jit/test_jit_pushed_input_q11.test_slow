# name: test/sql/jit/test_jit_pushed_input_q11.test_slow
# description: TPC-H Q11's CTE feeds a grouped direct consumer that runs as a compiled chunk step on pushed input; its
# group: [jit]

#              step reserves groups per pushing thread, which a pipeline without a source state of its own must size
#              from the threads that push into it

require tpch

statement ok
LOAD jit_sljit

statement ok
CALL dbgen(sf=0.1)

statement ok
SET threads=1

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=10000

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_policy='off'

statement ok
CREATE TABLE expected AS
SELECT ps_partkey, sum(ps_supplycost * ps_availqty) AS value
FROM partsupp, supplier, nation
WHERE ps_suppkey = s_suppkey AND s_nationkey = n_nationkey AND n_name = 'GERMANY'
GROUP BY ps_partkey
HAVING sum(ps_supplycost * ps_availqty) > (
    SELECT sum(ps_supplycost * ps_availqty) * 0.0001000000
    FROM partsupp, supplier, nation
    WHERE ps_suppkey = s_suppkey AND s_nationkey = n_nationkey AND n_name = 'GERMANY')

statement ok
SET jit_policy='auto'

statement ok
CREATE TABLE actual AS
SELECT ps_partkey, sum(ps_supplycost * ps_availqty) AS value
FROM partsupp, supplier, nation
WHERE ps_suppkey = s_suppkey AND s_nationkey = n_nationkey AND n_name = 'GERMANY'
GROUP BY ps_partkey
HAVING sum(ps_supplycost * ps_availqty) > (
    SELECT sum(ps_supplycost * ps_availqty) * 0.0001000000
    FROM partsupp, supplier, nation
    WHERE ps_suppkey = s_suppkey AND s_nationkey = n_nationkey AND n_name = 'GERMANY')

query II
SELECT (SELECT count(*) FROM expected) > 0,
       (SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                              UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)))
----
true	0

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND reason = 'full pipeline kernel executed on pushed input'
  AND pipeline_shape LIKE '%sink:sink:HASH_GROUP_BY%'
  AND jit_runtime_path_counts LIKE '%grouped_aggregate_reserve_target=%'
----
true
