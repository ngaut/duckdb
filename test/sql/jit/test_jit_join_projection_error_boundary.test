# name: test/sql/jit/test_jit_join_projection_error_boundary.test
# description: A throwing producer projection executes before join selection, including rows rejected by a residual.
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
CREATE TABLE probe AS
SELECT i % 1000 AS k, i AS n,
       CASE WHEN i = 77777 THEN 3000000000 ELSE i % 100 END::BIGINT AS v
FROM range(200000) t(i)

statement ok
CREATE TABLE build AS
SELECT i AS k, CASE WHEN i = 777 THEN 0 ELSE 1000000 END AS limit_n
FROM range(1000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

statement error
SELECT sum(v) FROM (SELECT k, n, v::INTEGER AS v FROM probe) p
JOIN build b ON p.k = b.k AND p.n < b.limit_n
----
Conversion Error: Type INT64 with value 3000000000 can't be cast because the value is out of range for the destination type INT32 when casting from source column v

statement error
SELECT p.k, sum(v) FROM (SELECT k, n, v::INTEGER AS v FROM probe) p
JOIN build b ON p.k = b.k AND p.n < b.limit_n GROUP BY p.k
----
Conversion Error: Type INT64 with value 3000000000 can't be cast because the value is out of range for the destination type INT32 when casting from source column v

statement error
SELECT v FROM (SELECT k, n, v::INTEGER AS v FROM probe) p
JOIN build b ON p.k = b.k AND p.n < b.limit_n
----
Conversion Error: Type INT64 with value 3000000000 can't be cast because the value is out of range for the destination type INT32 when casting from source column v

statement error
SELECT sum(v) FROM (SELECT k, n, v::INTEGER AS v FROM probe WHERE n % 3 <> 0) p
JOIN build b ON p.k = b.k AND p.n < b.limit_n
----
Conversion Error: Type INT64 with value 3000000000 can't be cast because the value is out of range for the destination type INT32 when casting from source column v

query I
SELECT sum(v) FROM (SELECT k, n, TRY_CAST(v AS INTEGER) AS v FROM probe) p
JOIN build b ON p.k = b.k AND p.n < b.limit_n
----
9884600

statement error
SELECT sum(v) FROM (SELECT k, n, v::INTEGER AS v FROM probe) p JOIN build b ON p.k = b.k
----
Conversion Error: Type INT64 with value 3000000000 can't be cast because the value is out of range for the destination type INT32 when casting from source column v

query I
SELECT sum(v) FROM (SELECT k, n, v::INTEGER AS v FROM probe WHERE n <> 77777) p
JOIN build b ON p.k = b.k AND p.n < b.limit_n
----
9884600

endloop

endloop
