# name: test/sql/jit/test_jit_union_group_hash.test
# description: Two pipelines feed one GROUP BY: a join whose build rows supply the group keys to the compiled grouped
# group: [jit]

#              update, and a scan the aggregate groups on its own. The final combine merges their tables by the stored
#              group hash, so a group both produce must hash the same way in each, or it is emitted twice

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

# spread join keys keep the join off the perfect hash table: the probe hands the build rows to the aggregate
statement ok
CREATE TABLE b AS
SELECT i * 100003 AS bk, (i % 50)::INTEGER AS g1, (i % 7)::INTEGER AS g2, (i % 11)::INTEGER AS g3
FROM range(20000) t(i)

statement ok
CREATE TABLE p AS SELECT (i % 20000) * 100003 AS pk, (i % 97)::INTEGER AS g0 FROM range(400000) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

query II nosort union_groups_{threads}
SELECT count(*), sum(n) FROM (
    SELECT g0, g1, g2, g3, count(*) AS n FROM (
        SELECT p.g0, b.g1, b.g2, b.g3 FROM p JOIN b ON p.pk = b.bk
        UNION ALL
        SELECT (i % 97)::INTEGER, (i % 50)::INTEGER, (i % 7)::INTEGER, (i % 11)::INTEGER FROM range(100000) t(i)
    ) u(g0, g1, g2, g3)
    GROUP BY ALL)
----

# the leading group key is the join key
query II nosort union_join_key_groups_{threads}
SELECT count(*), sum(n) FROM (
    SELECT k, g1, g2, n2 AS g3, count(*) AS n FROM (
        SELECT p.pk, b.g1, b.g2, b.g3 FROM p JOIN b ON p.pk = b.bk
        UNION ALL
        SELECT (i % 20000) * 100003, (i % 50)::INTEGER, (i % 7)::INTEGER, (i % 11)::INTEGER FROM range(100000) t(i)
    ) u(k, g1, g2, n2)
    GROUP BY ALL)
----

endloop

endloop

query II
SELECT count(*), sum(n) FROM (
    SELECT g0, g1, g2, g3, count(*) AS n FROM (
        SELECT p.g0, b.g1, b.g2, b.g3 FROM p JOIN b ON p.pk = b.bk
        UNION ALL
        SELECT (i % 97)::INTEGER, (i % 50)::INTEGER, (i % 7)::INTEGER, (i % 11)::INTEGER FROM range(100000) t(i)
    ) u(g0, g1, g2, g3)
    GROUP BY ALL)
----
298600	500000
