# name: test/sql/jit/test_jit_selected_hash_join_chain.test
# description: A pipeline probing three hash joins hands each join's selected output to the next; every join builds
# group: [jit]

#              its input in its own chunk, so the input of one join is never overwritten by the next join's input

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
CREATE TABLE f AS
SELECT i::BIGINT AS id, (i % 97)::BIGINT AS a, (i % 89)::BIGINT AS b, (i % 83)::BIGINT AS c,
       (i % 1000)::DECIMAL(15,2) AS price, DATE '2020-01-01' + (i % 365)::INTEGER AS d
FROM range(200000) t(i)

statement ok
CREATE TABLE d1 AS SELECT i::BIGINT AS a, 'n' || i AS name FROM range(97) t(i)

statement ok
CREATE TABLE d2 AS SELECT i::BIGINT AS b, (i * 10)::INTEGER AS w FROM range(89) t(i)

statement ok
CREATE TABLE d3 AS SELECT i::BIGINT AS c, (i % 7)::BIGINT AS g FROM range(83) t(i)

foreach threads 1 4

statement ok
SET threads={threads}

query IIIIIII
SELECT count(*), sum(price), sum(w), sum(g), count(DISTINCT name), min(d), max(d)
FROM f JOIN d1 USING (a) JOIN d2 USING (b) JOIN d3 USING (c)
WHERE f.id % 3 <> 0
----
133333	66599667.00	58662590	395176	97	2020-01-01	2020-12-30

query IIII
SELECT g, count(*), sum(price), sum(w)
FROM f JOIN d1 USING (a) JOIN d2 USING (b) JOIN d3 USING (c)
GROUP BY g ORDER BY g
----
0	28916	14443986.00	12722530
1	28916	14443902.00	12722440
2	28916	14443818.00	12722350
3	28916	14443734.00	12722260
4	28915	14443650.00	12722000
5	28915	14443565.00	12721900
6	26506	13237345.00	11660400

endloop
