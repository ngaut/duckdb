# name: test/sql/jit/test_jit_adaptive_ab.test
# description: Measured runner A/B preserves exact results for either verdict and records its decision
# group: [jit]

# The verdict-event assertion is deterministic only single-threaded: with
# parallel bystanders the pipeline can finish natively before the measurement
# owner reaches a verdict, which is correct behavior without a recorded verdict.
statement ok
LOAD jit_sljit

statement ok
SET threads=1;

statement ok
SET jit_event_log_size=1000;

statement ok
SET jit_trace_runtime=true;

statement ok
CREATE TABLE facts AS
SELECT (i % 97)::INTEGER g, i::BIGINT v FROM range(1000000) tbl(i);

statement ok
SET jit_policy='off';

statement ok
CREATE TABLE ref_grouped AS SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g;

statement ok
CREATE TABLE ref_grouped_distinct AS SELECT g, count(DISTINCT v % 9973) c FROM facts GROUP BY g;

statement ok
SET jit_policy='auto';

statement ok
SET jit_adaptive_ab=true;

# Default margin: the verdict is measured and may go either way; results must be
# exact regardless.
query I
SELECT count(*) FROM (
  (SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped)
  UNION ALL
  (SELECT * FROM ref_grouped EXCEPT SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g)
)
----
0

# Grouped distinct compiles into the inline distinct-key-sink recipe, which owns
# the pipeline's counting and therefore refuses runner handoff: the A/B must not
# measure it, and the result must stay exact.
query I
SELECT count(*) FROM (
  (SELECT g, count(DISTINCT v % 9973) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped_distinct)
  UNION ALL
  (SELECT * FROM ref_grouped_distinct EXCEPT SELECT g, count(DISTINCT v % 9973) c FROM facts GROUP BY g)
)
----
0

# An extreme margin forces the fallback verdict deterministically.
statement ok
SET jit_adaptive_ab_margin_basis_points=100000000;

query I
SELECT count(*) FROM (
  (SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped)
  UNION ALL
  (SELECT * FROM ref_grouped EXCEPT SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g)
)
----
0

query I
SELECT count(*) > 0 FROM duckdb_jit_events() WHERE reason LIKE 'adaptive_ab verdict%'
----
true

# Verdict events carry the per-leg row payload used to normalize verdict biases.
query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE reason LIKE 'adaptive_ab verdict%compiled_leg_rows=%native_leg_rows=%'
----
true

# A tight band excludes this confidently-winning pipeline from measurement:
# results stay exact and no new verdict is recorded.
statement ok
SET jit_adaptive_ab_margin_basis_points=1000;

statement ok
SET jit_adaptive_ab_band_basis_points=1;

statement ok
CREATE TABLE verdicts_before AS
SELECT count(*) n FROM duckdb_jit_events() WHERE reason LIKE 'adaptive_ab verdict%';

query I
SELECT count(*) FROM (
  (SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped)
  UNION ALL
  (SELECT * FROM ref_grouped EXCEPT SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g)
)
----
0

query I
SELECT count(*) - (SELECT n FROM verdicts_before)
FROM duckdb_jit_events() WHERE reason LIKE 'adaptive_ab verdict%'
----
0

statement ok
SET jit_adaptive_ab_band_basis_points=0;

# Parallel execution: verdicts are timing-dependent with bystander threads, so
# only exact results are asserted; this covers the measurement-owner/bystander
# split over the shared distribution.
statement ok
SET threads=4;

statement ok
SET jit_adaptive_ab_margin_basis_points=1000;

query I
SELECT count(*) FROM (
  (SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g EXCEPT SELECT * FROM ref_grouped)
  UNION ALL
  (SELECT * FROM ref_grouped EXCEPT SELECT g, sum(v) s, count(*) c FROM facts GROUP BY g)
)
----
0

statement ok
SET jit_adaptive_ab=false;
