# name: test/sql/jit/test_jit_probe_after_selection_probe.test_slow
# description: An inner join probed as a selection hands the next probe in the pipeline a view of the selected rows of
#              its output; a LEFT join, whose probe materializes its output, reads its input from that view as a probe
#              behind a filter or another selection probe does
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
CREATE TABLE f AS SELECT i AS k, (i % 800000)::BIGINT AS bk, (i % 200000)::BIGINT AS ck FROM range(6000000) t(i)

statement ok
CREATE TABLE b AS SELECT i::BIGINT AS bk, (i % 97)::INTEGER AS g FROM range(800000) t(i)

statement ok
CREATE TABLE c AS SELECT i::BIGINT AS ck, 'm' || (i % 5)::VARCHAR AS s FROM range(200000) t(i)

# empty and nullable: NOT IN plans a MARK join after the LEFT join
statement ok
CREATE TABLE z AS SELECT i::BIGINT AS zk FROM range(10) t(i) WHERE i < 0

foreach threads 1 4

statement ok
SET threads=${threads}

foreach policy off auto

statement ok
SET jit_policy='${policy}'

query II nosort inner_left_mark_groups_${threads}
SELECT count(*), sum(n) FROM (
    SELECT b.g + 3, c.s, count(*) AS n
    FROM f JOIN b ON f.bk = b.bk LEFT JOIN c ON f.ck = c.ck
    WHERE b.bk NOT IN (SELECT zk FROM z)
    GROUP BY ALL)
----

endloop

endloop

query II
SELECT count(*), sum(n) FROM (
    SELECT b.g + 3, c.s, count(*) AS n
    FROM f JOIN b ON f.bk = b.bk LEFT JOIN c ON f.ck = c.ck
    WHERE b.bk NOT IN (SELECT zk FROM z)
    GROUP BY ALL)
----
485	6000000
