# name: test/sql/jit/test_jit_filtered_aggregate_reference_payload.test
# description: An ungrouped aggregate that mixes an expression payload with column payloads gathers its sources into
#              one combined list, where a column payload names its source by slot. The filter fused into the update
#              reads that slot's column, not the column numbered like the slot
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
CREATE TABLE t AS
SELECT DATE '1992-01-01' + (i % 2500)::INTEGER AS d, i::BIGINT AS k, (i % 1000)::BIGINT AS c, (i % 3)::INTEGER AS s,
       (i % 100)::DECIMAL(15,2) AS p
FROM range(1500000) t(i)

foreach threads 1 4

statement ok
SET threads=${threads}

foreach policy off auto

statement ok
SET jit_policy='${policy}'

query II nosort expression_then_bigint_${threads}
SELECT sum(CASE WHEN k % 4 = 0 THEN k END), sum(c) FROM t WHERE d < DATE '1994-01-25' AND d >= DATE '1992-10-26'
----

query II nosort expression_then_integer_${threads}
SELECT sum(k % 4), sum(s) FROM t WHERE d < DATE '1994-01-25' AND d >= DATE '1992-10-26'
----

query II nosort integer_then_expression_${threads}
SELECT sum(s), sum(k % 4) FROM t WHERE d < DATE '1994-01-25' AND d >= DATE '1992-10-26'
----

query III nosort decimal_expression_bigint_${threads}
SELECT sum(p), sum(k % 7), sum(c) FROM t WHERE d < DATE '1994-01-25' AND d >= DATE '1992-10-26'
----

endloop

endloop

query II
SELECT sum(CASE WHEN k % 4 = 0 THEN k END), sum(c) FROM t WHERE d < DATE '1994-01-25' AND d >= DATE '1992-10-26'
----
51250478400	135950400
