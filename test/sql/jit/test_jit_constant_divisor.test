# name: test/sql/jit/test_jit_constant_divisor.test
# description: Generated modulo and integer division by a constant give DuckDB's results for every dividend
# group: [jit]

# The quotient comes from a magic-number high multiply; a divisor one off a power of two (2, 3, 7, 33, 65537,
# 2^31 + 1, 2^62 + 1) forms the remainder with a shift and an add, other divisors with a multiply. Dividends cover
# negative values and the BIGINT and INTEGER extremes.

statement ok
LOAD jit_sljit

# runtime path assertions must not depend on which path a timing measurement chose
statement ok
SET jit_measure_native_legs=false

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=4096

statement ok
SET jit_cbo_full_pipeline_benefit=4096

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_event_log_size=10000

statement ok
CREATE TABLE t AS
SELECT (i * 7919 - 800000000)::BIGINT AS v, (i * 37 - 4000000)::INTEGER AS w FROM range(200000) r(i)
UNION ALL
SELECT * FROM (VALUES (9223372036854775807::BIGINT, 2147483647), ('-9223372036854775808'::BIGINT, -2147483648),
                      (-9223372036854775807::BIGINT, -2147483647), (0::BIGINT, 0), (-1::BIGINT, -1), (1::BIGINT, 1)) v(v, w)

foreach threads 1 4

statement ok
SET threads={threads}

foreach policy off auto

statement ok
SET jit_policy='{policy}'

query III
SELECT count(*), sum(v % 2), sum(v // 2) FROM t WHERE v % 2 <> 0
----
100004	-1022	-404999999489

query III
SELECT count(*), sum(v % 3), sum(v // 3) FROM t WHERE v % 3 <> 1
