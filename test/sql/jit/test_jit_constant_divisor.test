endloop

endloop

# the filtered aggregate's generated loop runs them
statement ok
SET threads=1

statement ok
SET jit_trace_runtime=true

statement ok
SELECT * FROM duckdb_jit_clear_events()

query III
SELECT count(*), sum(v % 7), sum(v // 7) FROM t WHERE v % 7 <> 3
----
185866	-48560	-1317625599842388074

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND jit_runtime_path_counts LIKE '%aggregate_update.filtered_primitive_update=%'
----
true
