# name: test/sql/jit/test_jit_floating_group_keys.test
# description: Floating-point group keys are equal by value, not by bits: -0.0 equals 0.0 and every NaN equals every
# group: [jit]

#              other. A compiled region hands them to core's grouped-state lookups like any other key, or hands a key
#              without runs to DuckDB's operators; either way DuckDB's hash and equality match them, never C++'s ==
#              (which failed the query with an internal error)

require tpch

statement ok
LOAD jit_sljit

statement ok
SET jit_cbo_generated_stage_benefit=4096

statement ok
SET jit_cbo_materialization_elision_benefit=4096

statement ok
SET jit_cbo_native_operator_stage_benefit=1048576

statement ok
SET jit_cbo_full_pipeline_benefit=0

statement ok
SET jit_cbo_source_contract_scan_filter_penalty=0

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_cbo_startup_margin_basis_points=0

statement ok
SET jit_trace_runtime=true

statement ok
SET jit_event_log_size=100000

# Probe and build keys cycle through -0.0, 0.0, both NaN signs, NULL and infinity
statement ok
CREATE TABLE facts AS
SELECT i::BIGINT AS id, (i % 1000)::INTEGER AS k,
       CASE i % 9 WHEN 0 THEN -0.0 WHEN 1 THEN 0.0 WHEN 2 THEN 'nan'::DOUBLE WHEN 3 THEN -('nan'::DOUBLE)
                  WHEN 4 THEN NULL WHEN 5 THEN 'inf'::DOUBLE ELSE (i % 37) / 4.0 END::DOUBLE AS d,
       CASE i % 9 WHEN 0 THEN -0.0 WHEN 1 THEN 0.0 WHEN 2 THEN 'nan'::DOUBLE WHEN 3 THEN -('nan'::DOUBLE)
                  WHEN 4 THEN NULL ELSE (i % 37) / 4.0 END::FLOAT AS f,
       i % 7 AS v
FROM range(300000) t(i)

statement ok
CREATE TABLE dims AS
SELECT i::INTEGER AS k,
       CASE i % 5 WHEN 0 THEN -0.0 WHEN 1 THEN 0.0 WHEN 2 THEN 'nan'::DOUBLE WHEN 3 THEN -('nan'::DOUBLE)
                  ELSE (i % 13) / 2.0 END::DOUBLE AS bd,
       CASE i % 5 WHEN 0 THEN -0.0 WHEN 1 THEN 0.0 WHEN 2 THEN 'nan'::DOUBLE ELSE (i % 13) / 2.0 END::FLOAT AS bf,
       i % 3 AS bv
FROM range(1000) t(i)

statement ok
CREATE VIEW probe_double AS SELECT d, count(*) FROM facts JOIN dims USING (k) GROUP BY d

statement ok
CREATE VIEW probe_float AS SELECT f, count(*) FROM facts JOIN dims USING (k) GROUP BY f

statement ok
CREATE VIEW build_double AS SELECT bd, count(*) FROM facts JOIN dims USING (k) GROUP BY bd

statement ok
CREATE VIEW build_float_sums AS SELECT bf, sum(v), sum(bv) FROM facts JOIN dims USING (k) GROUP BY bf

statement ok
CREATE VIEW probe_and_build AS SELECT d, bd, count(*) FROM facts JOIN dims USING (k) GROUP BY d, bd

statement ok
CREATE VIEW integer_and_float AS SELECT k, bf, count(*) FROM facts JOIN dims USING (k) GROUP BY k, bf

foreach threads 1 4

statement ok
SET threads={threads}

foreach query probe_double probe_float build_double build_float_sums probe_and_build integer_and_float

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS SELECT * FROM {query}

statement ok
SET jit_policy='auto'

statement ok
SELECT * FROM duckdb_jit_clear_events()

statement ok
CREATE OR REPLACE TABLE actual AS SELECT * FROM {query}

query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE phase = 'runtime' AND (generated_stage_count_breakdown LIKE '%find_or_create_input_vector.group_keys=%'
                              OR jit_runtime_path_counts LIKE '%source.native_continuation=%')
----
true

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

endloop

endloop

# TPC-H Q16 over floating-point keys: COUNT(DISTINCT ps_suppkey) is planned as a grouping on the counted column
statement ok
CALL dbgen(sf=0.1, suffix='_original')

foreach type DOUBLE FLOAT

# The part key stays INTEGER, so the join casts it to the floating-point partsupp key
statement ok
CREATE OR REPLACE TABLE part AS
SELECT p_partkey::INTEGER AS p_partkey, p_name, p_mfgr, p_brand, p_type, p_size::{type} AS p_size, p_container,
       p_retailprice::{type} AS p_retailprice, p_comment
FROM part_original

statement ok
CREATE OR REPLACE TABLE partsupp AS
SELECT ps_partkey::{type} AS ps_partkey, ps_suppkey::{type} AS ps_suppkey, ps_availqty::{type} AS ps_availqty,
       ps_supplycost::{type} AS ps_supplycost, ps_comment
FROM partsupp_original

statement ok
CREATE OR REPLACE TABLE supplier AS
SELECT s_suppkey::{type} AS s_suppkey, s_name, s_address, s_nationkey::{type} AS s_nationkey, s_phone,
       s_acctbal::{type} AS s_acctbal, s_comment
FROM supplier_original

foreach threads 1 4

statement ok
SET threads={threads}

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS
SELECT p_brand, p_type, p_size, count(DISTINCT ps_suppkey) AS supplier_cnt
FROM partsupp, part
WHERE p_partkey = ps_partkey AND p_brand <> 'Brand#45' AND p_type NOT LIKE 'MEDIUM POLISHED%'
  AND p_size IN (49, 14, 23, 45, 19, 3, 36, 9)
  AND ps_suppkey NOT IN (SELECT s_suppkey FROM supplier WHERE s_comment LIKE '%Customer%Complaints%')
GROUP BY p_brand, p_type, p_size

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS
SELECT p_brand, p_type, p_size, count(DISTINCT ps_suppkey) AS supplier_cnt
FROM partsupp, part
WHERE p_partkey = ps_partkey AND p_brand <> 'Brand#45' AND p_type NOT LIKE 'MEDIUM POLISHED%'
  AND p_size IN (49, 14, 23, 45, 19, 3, 36, 9)
  AND ps_suppkey NOT IN (SELECT s_suppkey FROM supplier WHERE s_comment LIKE '%Customer%Complaints%')
GROUP BY p_brand, p_type, p_size

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

query I
SELECT count(*) > 0 FROM actual
----
true

endloop

endloop

# Keys that come from the build side as row-pointer fields: a pipeline-local preaggregation compares consecutive rows'
# keys through core, which compares floating-point keys with DuckDB's equality. One row in sixteen of every column is
# NULL, as in the differential fuzz database, so the keys take that path
statement ok
CREATE TABLE partsupp_nulls AS
SELECT * REPLACE (CASE WHEN hash(rowid, 'ps_partkey') % 16 = 0 THEN NULL ELSE ps_partkey END AS ps_partkey,
       CASE WHEN hash(rowid, 'ps_suppkey') % 16 = 0 THEN NULL ELSE ps_suppkey END AS ps_suppkey,
       CASE WHEN hash(rowid, 'ps_availqty') % 16 = 0 THEN NULL ELSE ps_availqty END AS ps_availqty,
       CASE WHEN hash(rowid, 'ps_supplycost') % 16 = 0 THEN NULL ELSE ps_supplycost END AS ps_supplycost,
       CASE WHEN hash(rowid, 'ps_comment') % 16 = 0 THEN NULL ELSE ps_comment END AS ps_comment)
FROM partsupp_original

statement ok
CREATE TABLE supplier_nulls AS
SELECT * REPLACE (CASE WHEN hash(rowid, 's_suppkey') % 16 = 0 THEN NULL ELSE s_suppkey END AS s_suppkey,
       CASE WHEN hash(rowid, 's_name') % 16 = 0 THEN NULL ELSE s_name END AS s_name,
       CASE WHEN hash(rowid, 's_nationkey') % 16 = 0 THEN NULL ELSE s_nationkey END AS s_nationkey,
       CASE WHEN hash(rowid, 's_phone') % 16 = 0 THEN NULL ELSE s_phone END AS s_phone,
       CASE WHEN hash(rowid, 's_acctbal') % 16 = 0 THEN NULL ELSE s_acctbal END AS s_acctbal,
       CASE WHEN hash(rowid, 's_comment') % 16 = 0 THEN NULL ELSE s_comment END AS s_comment)
FROM supplier_original

statement ok
CREATE TABLE part_nulls AS
SELECT * REPLACE (CASE WHEN hash(rowid, 'p_partkey') % 16 = 0 THEN NULL ELSE p_partkey END AS p_partkey,
       CASE WHEN hash(rowid, 'p_name') % 16 = 0 THEN NULL ELSE p_name END AS p_name,
       CASE WHEN hash(rowid, 'p_mfgr') % 16 = 0 THEN NULL ELSE p_mfgr END AS p_mfgr,
       CASE WHEN hash(rowid, 'p_brand') % 16 = 0 THEN NULL ELSE p_brand END AS p_brand,
       CASE WHEN hash(rowid, 'p_type') % 16 = 0 THEN NULL ELSE p_type END AS p_type,
       CASE WHEN hash(rowid, 'p_size') % 16 = 0 THEN NULL ELSE p_size END AS p_size,
       CASE WHEN hash(rowid, 'p_container') % 16 = 0 THEN NULL ELSE p_container END AS p_container,
       CASE WHEN hash(rowid, 'p_retailprice') % 16 = 0 THEN NULL ELSE p_retailprice END AS p_retailprice,
       CASE WHEN hash(rowid, 'p_comment') % 16 = 0 THEN NULL ELSE p_comment END AS p_comment)
FROM part_original

statement ok
CREATE VIEW build_float_union AS
SELECT c0, c1, count(*) FROM (
    SELECT CAST(t2.s_acctbal AS DOUBLE), t2.s_comment
    FROM partsupp_nulls t1 JOIN supplier_nulls t2 ON t1.ps_suppkey = t2.s_suppkey AND t1.ps_supplycost <= t2.s_acctbal
    WHERE t2.s_acctbal >= 2531.3 AND 1.5 > CAST(t2.s_acctbal AS DOUBLE) AND t1.ps_comment LIKE 'Customer#0000%'
    UNION ALL
    SELECT CAST(t2.s_acctbal AS DOUBLE), t2.s_comment
    FROM partsupp_nulls t1 JOIN supplier_nulls t2 ON t1.ps_suppkey = t2.s_suppkey AND t1.ps_supplycost <= t2.s_acctbal
    WHERE t1.ps_suppkey < 80000 AND t1.ps_partkey % 3 = 0) AS u(c0, c1)
GROUP BY c0, c1

statement ok
CREATE VIEW float_right_join_union AS
SELECT c0, c1, c2, count(*) FROM (
    SELECT CAST(t2.ps_supplycost AS FLOAT), t3.p_brand, t1.s_nationkey
    FROM supplier_nulls t1 JOIN partsupp_nulls t2 ON t1.s_suppkey = t2.ps_suppkey
    RIGHT JOIN part_nulls t3 ON t2.ps_partkey = t3.p_partkey
    UNION ALL
    SELECT CAST(t2.ps_supplycost AS FLOAT), t3.p_brand, t1.s_nationkey
    FROM supplier_nulls t1 JOIN partsupp_nulls t2 ON t1.s_suppkey = t2.ps_suppkey
    RIGHT JOIN part_nulls t3 ON t2.ps_partkey = t3.p_partkey
    WHERE t1.s_name NOT LIKE '%special%') AS u(c0, c1, c2)
GROUP BY c0, c1, c2

foreach threads 1 4

statement ok
SET threads={threads}

foreach query build_float_union float_right_join_union

statement ok
SET jit_policy='off'

statement ok
CREATE OR REPLACE TABLE expected AS SELECT * FROM {query}

statement ok
SET jit_policy='auto'

statement ok
CREATE OR REPLACE TABLE actual AS SELECT * FROM {query}

query I
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
                      UNION ALL (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected))
----
0

endloop

endloop
