# name: test/sql/jit/test_jit_dict_surviving_join.test
# description: Compiled hash-join probes bind dict-surviving (narrowed) build layouts, and compiled producers keep the
# group: [jit]

#              global-dictionary encoding that narrowed build slots require

statement ok
LOAD jit_sljit

statement ok
SET threads=1

statement ok
SET disabled_optimizers='join_order'

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_dump_ir=true

statement ok
SET jit_event_log_size=100000

# nation is a perfect-hash build whose probe output (n_name) is a global dictionary; that output is the build payload
# of the second join, so the second join narrows n_name to a dictionary index slot.
statement ok
CREATE TABLE nation AS SELECT i AS nk, 'NATION_' || (i % 5) AS n_name FROM range(25) t(i)

statement ok
CREATE TABLE customer AS SELECT i * 1000 AS ck, i % 25 AS nk FROM range(600000) t(i)

statement ok
CREATE TABLE orders AS SELECT i AS ok, (i % 600000) * 1000 AS ck FROM range(1200000) t(i)

statement ok
SELECT * FROM duckdb_jit_clear_events()

query II
SELECT n.n_name, COUNT(*) AS cnt
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY n.n_name ORDER BY n.n_name
----
NATION_0	240000
NATION_1	240000
NATION_2	240000
NATION_3	240000
NATION_4	240000

# The probe of the second join compiled against the narrowed layout the build published.
query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status = 'compiled' AND ir LIKE '%hash_join_dict_index_widths=[1]%'
----
true
