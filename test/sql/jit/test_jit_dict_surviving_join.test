# name: test/sql/jit/test_jit_dict_surviving_join.test
# description: Compiled hash-join probes bind dict-surviving (narrowed) build layouts, and compiled producers keep the
#              global-dictionary encoding that narrowed build slots require when runners mix within a pipeline
# group: [jit]

statement ok
LOAD jit_sljit

statement ok
SET threads=1

statement ok
SET disabled_optimizers='join_order'

statement ok
SET jit_cbo_startup_base_cost=0

statement ok
SET jit_dump_ir=true

statement ok
SET jit_event_log_size=100000

# nation is a perfect-hash build whose probe output (n_name) is a global dictionary; that output is the build payload
# of the second join, so the second join narrows n_name to a dictionary index slot. customer spans several row groups
# so the adaptive A/B and forced deferral genuinely mix native and compiled producers into that build.
statement ok
CREATE TABLE nation AS SELECT i AS nk, 'NATION_' || (i % 5) AS n_name FROM range(25) t(i)

statement ok
CREATE TABLE customer AS SELECT i * 1000 AS ck, i % 25 AS nk FROM range(600000) t(i)

statement ok
CREATE TABLE orders AS SELECT i AS ok, (i % 600000) * 1000 AS ck FROM range(1200000) t(i)

# Default runner selection.
statement ok
SET jit_adaptive_ab_band_basis_points=1000

statement ok
SET jit_debug_force_defer_after_chunks=0

statement ok
SELECT * FROM duckdb_jit_clear_events()

query II
SELECT n.n_name, COUNT(*) AS cnt
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY n.n_name ORDER BY n.n_name
----
NATION_0	240000
NATION_1	240000
NATION_2	240000
NATION_3	240000
NATION_4	240000

# The probe of the second join compiled against the narrowed layout the build published.
query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status = 'compiled' AND ir LIKE '%hash_join_dict_index_widths=[1]%'
----
true

# Every compiled pipeline is measured by the adaptive A/B: native and compiled legs feed the same build.
statement ok
SET jit_adaptive_ab_band_basis_points=0

statement ok
SET jit_debug_force_defer_after_chunks=0

statement ok
SELECT * FROM duckdb_jit_clear_events()

query II
SELECT n.n_name, COUNT(*) AS cnt
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY n.n_name ORDER BY n.n_name
----
NATION_0	240000
NATION_1	240000
NATION_2	240000
NATION_3	240000
NATION_4	240000

# The probe of the second join compiled against the narrowed layout the build published.
query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status = 'compiled' AND ir LIKE '%hash_join_dict_index_widths=[1]%'
----
true

# Compiled kernels defer to native after one chunk: compiled then native chunks feed the same build.
statement ok
SET jit_adaptive_ab_band_basis_points=1000

statement ok
SET jit_debug_force_defer_after_chunks=1

statement ok
SELECT * FROM duckdb_jit_clear_events()

query II
SELECT n.n_name, COUNT(*) AS cnt
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY n.n_name ORDER BY n.n_name
----
NATION_0	240000
NATION_1	240000
NATION_2	240000
NATION_3	240000
NATION_4	240000

# The probe of the second join compiled against the narrowed layout the build published.
query I
SELECT count(*) > 0 FROM duckdb_jit_events()
WHERE status = 'compiled' AND ir LIKE '%hash_join_dict_index_widths=[1]%'
----
true
