# name: test/sql/aggregate/aggregates/test_count.test
# description: Test COUNT operator
# group: [aggregates]

# test counts on scalar values
query IIIII
SELECT COUNT(*), COUNT(1), COUNT(100), COUNT(NULL), COUNT(DISTINCT 1)
----
1
1
1
0
1

# test counts on a set of values
statement ok
CREATE TABLE integers(i INTEGER);

statement ok
INSERT INTO integers VALUES (1), (2), (NULL)

query IIIIII
SELECT COUNT(*), COUNT(1), COUNT(i), COUNT(COALESCE(i, 1)), COUNT(DISTINCT i), COUNT(DISTINCT 1) FROM integers
----
3
3
2
3
2
1

statement ok
CREATE TABLE grouped_count_distinct(g INTEGER, v INTEGER);

statement ok
INSERT INTO grouped_count_distinct VALUES
	(1, NULL),
	(1, NULL),
	(2, 10),
	(2, 10),
	(2, NULL),
	(2, 11),
	(3, NULL),
	(3, 20);

query II
SELECT g, COUNT(DISTINCT v) FROM grouped_count_distinct GROUP BY g ORDER BY g
----
1	0
2	2
3	1

statement ok
SET threads=4;

statement ok
CREATE TABLE threaded_grouped_count_distinct(g BIGINT NOT NULL, v BIGINT NOT NULL);

statement ok
INSERT INTO threaded_grouped_count_distinct
SELECT i % 10, i % 100 FROM range(200000) t(i);

query II
SELECT min(c), max(c)
FROM (
	SELECT g, COUNT(DISTINCT v) AS c
	FROM threaded_grouped_count_distinct
	GROUP BY g
);
----
10	10

statement ok
SET threads=1;

# ordered aggregates are not supported
query I
SELECT COUNT(1 ORDER BY 1)
----
1

# cannot do DISTINCT *
statement error
SELECT COUNT(DISTINCT *) FROM integers
----
Binder Error: STAR expression is only allowed as the root element
